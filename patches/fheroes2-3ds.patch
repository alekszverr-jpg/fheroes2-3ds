+    if ( Platform3DS::viewport() != crop || std::memcmp( frame.image(), Display::instance().image(), frame.width() * frame.height() ) != 0 )
+        throw std::runtime_error( "Level-up changed game context" );
+    COUT( "3DS LEVEL UP SMOKE: PASS primary_only one_skill both_taps dpad escape drag_cancel nested_info long_name evil caller_grants context_restore" )
