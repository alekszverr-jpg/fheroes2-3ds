+void Interface3DS::showBattleLog( const std::vector<std::string> & messages )
+{
+    using namespace fheroes2;
+    const CursorRestorer cursorRestorer( false );
+    Image window( 320, 240 ), view( 284, 164 );
+    const uint8_t background = GetColorId( 35, 29, 24 ), border = GetColorId( 150, 115, 63 );
+    const bool evil = Settings::Get().isEvilInterfaceEnabled();
+    const Rect textArea{ 12, 34, 284, 164 };
+    std::vector<int> offsets{ 0 };
+    for ( const auto & message : messages ) offsets.push_back( offsets.back() + Text( message, FontType::smallWhite() ).height( view.width() ) + 5 );
+    const int maximum = std::max( 0, offsets.back() - int( view.height() ) );
+    int scroll = maximum;
+    Button close( 0, 204, evil ? ICN::UNIFORM_EVIL_OKAY_BUTTON : ICN::UNIFORM_GOOD_OKAY_BUTTON, 0, 1 );
+    close.setPosition( ( 320 - close.area().width ) / 2, 204 );
+    bool closed = false, down = false, moved = false, buttonHeld = false;
+    Point start, last;
+    const ModalScope scope( window, false );
+    const auto draw = [&]() {
+        window.fill( background );
+        StandardWindow::renderBackgroundImage( window, { 0, 0, 320, 240 }, 0, evil );
+        DrawBorder( window, border );
+        Text( _( "Show logs" ), FontType::normalYellow() ).draw( 12, 8, 296, window );
+        view.fill( background );
+        const auto first = std::upper_bound( offsets.begin(), offsets.end(), scroll );
+        size_t i = first == offsets.begin() ? 0 : size_t( first - offsets.begin() - 1 );
+        for ( ; i < messages.size() && offsets[i] < scroll + view.height(); ++i )
+            Text( messages[i], FontType::smallWhite() ).draw( 0, offsets[i] - scroll, view.width(), view );
+        Copy( view, 0, 0, window, textArea.x, textArea.y, view.width(), view.height() );
+        if ( maximum ) {
+            Fill( window, 302, 34, 5, 164, background );
+            const int thumb = std::max( 8, int( int64_t( 164 ) * 164 / offsets.back() ) );
+            Fill( window, 302, 34 + int( int64_t( scroll ) * ( 164 - thumb ) / maximum ), 5, thumb, border );
+        }
+        if ( buttonHeld && !moved ) close.press(); else close.release();
+        close.draw( window );
+        Display::instance().render();
+    };
+    if ( Platform3DS::smokeTest() ) Platform3DS::requestCapture();
+    draw();
+    if ( Platform3DS::smokeTest() && !Save( window, "sdmc:/3ds/fheroes2/battle-log-bottom.bmp" ) )
+        throw std::runtime_error( "Cannot save native battle log" );
+    auto & events = LocalEvent::Get();
+    while ( !closed && events.HandleEvents() ) {
+        bool redraw = false;
+        Platform3DS::PanelInput input;
+        while ( !closed && Platform3DS::consumePanelInput( input ) ) {
+            redraw = true;
+            if ( input.type == PanelInputType::Key ) {
+                switch ( input.key ) {
+                case PanelKey::Up: scroll -= 32; break;
+                case PanelKey::Down: scroll += 32; break;
+                case PanelKey::Left: scroll -= view.height(); break;
+                case PanelKey::Right: scroll += view.height(); break;
+                case PanelKey::Confirm:
+                case PanelKey::Cancel:
+                case PanelKey::Information: closed = true; break;
+                }
+            }
+            else if ( input.type == PanelInputType::TouchDown ) {
+                start = last = input.position; down = true; moved = false;
+                buttonHeld = close.area() & start;
+            }
+            else if ( input.type == PanelInputType::TouchMove && down ) {
+                moved = moved || std::abs( input.position.x - start.x ) >= 6 || std::abs( input.position.y - start.y ) >= 6;
+                if ( moved && ( textArea & start ) ) scroll += last.y - input.position.y;
+                last = input.position;
+            }
+            else if ( input.type == PanelInputType::TouchUp && down ) {
+                if ( !moved && buttonHeld && ( close.area() & last ) ) closed = true;
+                down = false; buttonHeld = false;
+            }
+            scroll = std::clamp( scroll, 0, maximum );
+        }
+        if ( redraw && !closed ) draw();
+    }
+    if ( Platform3DS::smokeTest() && messages.size() > 1 && !Save( window, "sdmc:/3ds/fheroes2/battle-log-scrolled-bottom.bmp" ) )
+        throw std::runtime_error( "Cannot save scrolled battle log" );
+    lastBattleLogScroll = scroll; lastBattleLogMaximum = maximum;
+    COUT( "3DS BATTLE LOG CLOSED scroll=" << scroll << " maximum=" << maximum << " entries=" << messages.size() )
+}
+
+void Interface3DS::testBattleLog()
+{
+    using namespace fheroes2;
+    std::vector<std::string> messages;
+    for ( int i = 1; i <= 40; ++i ) messages.push_back( std::to_string( i ) + ": " + _( "Skips the current creature. The current creature ends its turn and does not get to go again until the next round." ) );
+    const auto touch = []( Uint32 type, int x, int y ) {
+        SDL_Event e{}; e.type = type; e.tfinger.touchId = 1; e.tfinger.fingerId = 0;
+        e.tfinger.x = x / 320.0f; e.tfinger.y = y / 240.0f; return e;
+    };
+    const auto key = []( int button, bool pressed ) {
+        SDL_Event e{}; e.type = pressed ? SDL_CONTROLLERBUTTONDOWN : SDL_CONTROLLERBUTTONUP;
+        e.cbutton.button = button; e.cbutton.state = pressed ? SDL_PRESSED : SDL_RELEASED; return e;
+    };
+    const Point crop = Platform3DS::viewport();
+    const Image * strip = Platform3DS::commandStripImage();
+    Image frame; Copy( Display::instance(), frame );
+    const auto run = [&]( const std::vector<std::string> & content, std::vector<TimedEvent> input ) {
+        runInjectedInput( [&]() { showBattleLog( content ); return 0; }, std::move( input ) );
+        if ( Platform3DS::viewport() != crop || Platform3DS::commandStripImage() != strip
+             || std::memcmp( frame.image(), Display::instance().image(), frame.width() * frame.height() ) != 0 )
+            throw std::runtime_error( "Battle log changed upper frame/viewport/context" );
+    };
+    run( messages, { { 250, key( SDL_CONTROLLER_BUTTON_A, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_A, false ) } } );
+    if ( lastBattleLogMaximum <= 0 || lastBattleLogScroll != lastBattleLogMaximum ) throw std::runtime_error( "Battle log did not open at latest entry" );
+    run( messages, { { 250, key( SDL_CONTROLLER_BUTTON_DPAD_UP, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_DPAD_UP, false ) },
+                    { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } } );
+    if ( lastBattleLogScroll >= lastBattleLogMaximum ) throw std::runtime_error( "Battle log D-pad did not scroll older entries" );
+    run( messages, { { 250, touch( SDL_FINGERDOWN, 160, 60 ) }, { 80, touch( SDL_FINGERMOTION, 160, 170 ) },
+                    { 80, touch( SDL_FINGERUP, 0, 0 ) }, { 80, touch( SDL_FINGERDOWN, 160, 219 ) }, { 80, touch( SDL_FINGERUP, 0, 0 ) } } );
+    if ( lastBattleLogScroll >= lastBattleLogMaximum ) throw std::runtime_error( "Battle log stylus did not scroll older entries" );
+    run( messages, { { 250, key( SDL_CONTROLLER_BUTTON_DPAD_UP, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_DPAD_UP, false ) },
+                    { 80, key( SDL_CONTROLLER_BUTTON_DPAD_DOWN, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_DPAD_DOWN, false ) },
+                    { 80, key( SDL_CONTROLLER_BUTTON_A, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_A, false ) } } );
+    if ( lastBattleLogScroll != lastBattleLogMaximum ) throw std::runtime_error( "Battle log did not scroll back to newest entries" );
+    run( {}, { { 250, touch( SDL_FINGERDOWN, 160, 219 ) }, { 80, touch( SDL_FINGERMOTION, 160, 60 ) },
+               { 80, touch( SDL_FINGERUP, 0, 0 ) }, { 80, key( SDL_CONTROLLER_BUTTON_B, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_B, false ) } } );
+    if ( lastBattleLogMaximum || lastBattleLogScroll ) throw std::runtime_error( "Empty battle log did not clamp scroll" );
+    COUT( "3DS BATTLE LOG SMOKE: PASS bottom_width latest_entries wrapped_messages dpad_scroll stylus_scroll close_drag release_isolation upper_frame_unchanged" )
+}
