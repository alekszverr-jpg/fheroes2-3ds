+    draw();
+    auto & events = LocalEvent::Get();
+    while ( !closed && events.HandleEvents() ) {
+        Platform3DS::PanelInput input;
+        while ( !closed && Platform3DS::consumePanelInput( input ) ) {
+            if ( input.type == PanelInputType::KeyUp ) {
+                if ( information && input.key == PanelKey::Information ) closed = true;
+            }
+            else if ( input.type == PanelInputType::Key ) {
+                switch ( input.key ) {
+                case PanelKey::Up: scroll -= 32; break;
+                case PanelKey::Down: scroll += 32; break;
+                case PanelKey::Left: if ( !answers.empty() ) selected = ( selected + int( answers.size() ) - 1 ) % answers.size(); break;
+                case PanelKey::Right: if ( !answers.empty() ) selected = ( selected + 1 ) % answers.size(); break;
+                case PanelKey::Confirm: if ( !answers.empty() ) result = answers[selected].value; closed = true; break;
+                case PanelKey::Cancel:
+                    if ( information ) closed = true;
+                    else if ( answers.size() == 1 ) { result = answers.front().value; closed = true; }
+                    else if ( !choice || choice->allowCancel ) for ( const auto & answer : answers ) if ( answer.value == Dialog::NO || answer.value == Dialog::CANCEL ) { result = answer.value; closed = true; }
+                    break;
+                case PanelKey::Information:
+                    if ( !down ) {
+                        if ( choice ) touchedElement = selected;
+                        else if ( touchedElement < 0 ) for ( size_t i = 0; i < elements.size(); ++i )
+                            if ( hasInformation( elements[i] ) ) { touchedElement = int( i ); break; }
+                    }
+                    if ( information ) closed = true; else showInformation();
+                    break;
+                }
+            }
+            else if ( input.type == PanelInputType::TouchDown ) {
+                start = last = input.position; began = SDL_GetTicks(); down = true; moved = false;
+                pressed = buttonAt( last ); touchedElement = elementAt( last );
+                if ( pressed >= 0 ) selected = pressed;
+                else if ( choice && touchedElement >= 0 ) selected = touchedElement;
+            }
+            else if ( input.type == PanelInputType::TouchMove && down ) {
+                if ( std::abs( input.position.x - start.x ) >= 10 || std::abs( input.position.y - start.y ) >= 10 ) moved = true;
+                if ( moved && pressed < 0 && ( classicConfirmation ? ( Rect{ 24, 24, elementWidth, viewHeight } & start ) : ( !choice || start.y < 8 + viewHeight ) ) ) scroll += last.y - input.position.y;
+                last = input.position;
+            }
+            else if ( input.type == PanelInputType::TouchUp ) {
+                if ( information && ( heldPosition || !moved ) ) closed = true;
+                else if ( down && !moved && pressed >= 0 && buttonAt( classicFrame ? input.position : last ) == pressed ) { result = answers[pressed].value; closed = true; }
+                down = false; pressed = -1;
+            }
+            scroll = std::clamp( scroll, 0, scrollMaximum );
+        }
+        if ( !information && down && !moved && pressed < 0 && SDL_GetTicks() - began >= 550 ) {
+            showInformation();
+            // Passive elements have no popup. Do not repeatedly attempt to open one.
+            touchedElement = -1;
+        }
+        if ( !choice ) for ( size_t i = 0; i < elements.size(); ++i ) elements[i]->update( content, offsets[i] );
+        if ( !closed ) draw();
+    }
+    lastMessageScroll = scroll;
+    COUT( "3DS MESSAGE CLOSED result=" << result << " scroll=" << scroll )
+    return result;
+}
