+    if ( run( first, second, { { 300, touch( SDL_FINGERDOWN, 160, 60 ) }, { 100, touch( SDL_FINGERMOTION, 160, 10 ) }, { 100, touch( SDL_FINGERUP, 0, 0 ) },
+             { 100, controller( SDL_CONTROLLER_BUTTON_A, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_A, false ) } }, longName ) != first.Skill() || lastMessageScroll <= 0 )
+        throw std::runtime_error( "Long hero name hid level-up choice" );
+    auto & settings = Settings::Get(); const auto theme = settings.getInterfaceType();
