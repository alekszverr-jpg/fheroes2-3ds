+            redraw = true;
+            if ( input.type == PanelInputType::Key ) {
+                switch ( input.key ) {
+                case PanelKey::Cancel: closed = true; break;
+                case PanelKey::Confirm: activate( focus ); break;
+                case PanelKey::Left: focus = ( focus + int( areas.size() ) - 1 ) % areas.size(); break;
+                case PanelKey::Right: focus = ( focus + 1 ) % areas.size(); break;
+                case PanelKey::Up: { const int saved = focus; activate( buttonStart + 1 ); focus = saved; break; }
+                case PanelKey::Down: { const int saved = focus; activate( buttonStart ); focus = saved; break; }
+                default: break;
+                }
+            }
+            else if ( input.type == PanelInputType::TouchDown ) {
+                down = true; moved = false; start = input.position; pressed = -1; sliding = slider & start;
+                if ( sliding ) slide( start.x );
