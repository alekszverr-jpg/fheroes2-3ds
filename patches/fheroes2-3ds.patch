+    if ( run( item.GetName(), item.GetDescription(), { &artifact }, held ) != Dialog::OK || nestedInformationReturns != nested + 1 ) throw std::runtime_error( "Held artifact lost illustrated dialog" );
+    auto info = accept; info.clear(); press( info, SDL_CONTROLLER_BUTTON_B ); press( info, SDL_CONTROLLER_BUTTON_A );
+    const auto spellInfo = nestedInformationReturns;
+    if ( run( haste.GetName(), getSpellDescription( haste, &hero ), { &spell }, info ) != Dialog::OK || nestedInformationReturns != spellInfo + 1 ) throw std::runtime_error( "Spell information lost illustrated dialog" );
+    const Funds reward( 10, 10, 10, 10, 10, 10, 100000 ); const auto resources = getResourceDialogElements( reward );
+    std::vector<const DialogElement *> mixed; for ( const auto & resource : resources ) mixed.push_back( &resource ); mixed.push_back( &artifact ); mixed.push_back( &artifact ); mixed.push_back( &artifact ); mixed.push_back( &spell ); mixed.push_back( &spell );
+    auto scroll = accept; scroll.clear(); press( scroll, SDL_CONTROLLER_BUTTON_DPAD_DOWN ); press( scroll, SDL_CONTROLLER_BUTTON_A );
