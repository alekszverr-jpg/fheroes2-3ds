+++ b/src/fheroes2/gui/ui_3ds_style.cpp
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "ui_3ds_style.h"
+#if defined( __3DS__ )
+#include <algorithm>
+#include <utility>
+#include "game_assets.h"
+#include "icn.h"
+fheroes2::Image Interface3DS::makeClassicPanelBackground( const int32_t width, const bool evil )
+{
+    using namespace fheroes2;
+    // BUYBUILD is the frame used by building and ship purchases. Keep its main border,
+    // with a flush upper rail in place of the protruding crest.
+    const int icn = evil ? ICN::BUYBUILE : ICN::BUYBUILD;
+    Image source( 288, 240 ); source._disableTransformLayer();
+    const auto & paper = Assets::getImage( icn, 5 );
+    const int32_t topHeight = Assets::getImage( icn, 4 ).height();
+    const auto bottomArea = GetActiveROI( Assets::getImage( icn, 6 ) );
+    const int32_t bottomStart = 240 - bottomArea.y - bottomArea.height;
+    const uint8_t paperColor = paper.image()[20 * paper.width() + 64];
+    source.fill( paperColor );
+    for ( int32_t y = 0; y < 240; y += 25 )
+        for ( int32_t x = 0; x < 288; x += 96 )
+            Blit( paper, 48, 10, source, x, y, std::min<int32_t>( 96, 288 - x ), std::min<int32_t>( 25, 240 - y ) );
+    for ( int32_t y = 0; y < bottomStart; y += 35 )
+        for ( const uint32_t index : { 1U, 5U } ) {
+            const auto & sprite = Assets::getImage( icn, index );
+            Blit( sprite, 0, 10, source, index == 1 ? 144 : 144 - sprite.width(), y, sprite.width(), std::min<int32_t>( 35, bottomStart - y ) );
+        }
+    for ( const uint32_t index : { 2U, 6U } ) {
+        const auto & sprite = Assets::getImage( icn, index );
+        Blit( sprite, source, index == 2 ? 144 : 144 - sprite.width(), bottomStart );
+    }
+    // Extend only short border/paper sections on either side of the central
+    // ornament. Corners, centre jewels and their pixel proportions stay intact.
+    Image output( width, 240 ); output._disableTransformLayer(); output.fill( paperColor );
+    const int32_t extraLeft = ( width - 288 ) / 2, extraRight = width - 288 - extraLeft;
+    for ( int32_t y = 0; y < 240; y += 25 )
+        for ( int32_t x = 0; x < width; x += 96 )
+            Blit( paper, 48, 10, output, x, y, std::min<int32_t>( 96, width - x ), std::min<int32_t>( 25, 240 - y ) );
+    Copy( source, 0, 0, output, 0, 0, 50, 240 );
+    Copy( source, 50, 0, output, 50 + extraLeft, 0, 188, 240 );
+    Copy( source, 238, 0, output, width - 50, 0, 50, 240 );
+    for ( const auto & gap : { std::pair<int32_t, int32_t>{ 50, extraLeft }, std::pair<int32_t, int32_t>{ 238 + extraLeft, extraRight } } )
+        for ( int32_t x = 0; x < gap.second; x += 2 ) {
+            const int32_t fromX = gap.first == 50 ? 48 : 238;
+            const int32_t count = std::min<int32_t>( 2, gap.second - x );
+            Copy( source, fromX, bottomStart + 35, output, gap.first + x, bottomStart + 35, count, 240 - bottomStart - 35 );
+        }
+    // Reuse the flat rail and corners of BUYBUILD at their native pixel size.
+    // Tile its plain section instead of cropping through the central crest.
+    const auto & topLeft = Assets::getImage( icn, 4 );
+    const auto & topRight = Assets::getImage( icn, 0 );
+    const int32_t railY = topHeight - 59;
+    Blit( topLeft, 16, railY, output, 0, 0, 32, 15 );
+    for ( int32_t x = 32; x < width - 32; x += 2 )
+        Blit( topLeft, 64, railY, output, x, 0, std::min<int32_t>( 2, width - 32 - x ), 15 );
+    Blit( topRight, topRight.width() - 33, railY, output, width - 32, 0, 32, 15 );
+    return output;
+}
+
+
+void Interface3DS::fillClassicPanelPaper( fheroes2::Image & output, const bool evil )
+{
+    using namespace fheroes2;
+    const auto & paper = Assets::getImage( evil ? ICN::BUYBUILE : ICN::BUYBUILD, 5 );
+    output._disableTransformLayer(); output.fill( paper.image()[20 * paper.width() + 64] );
+    for ( int32_t y = 0; y < output.height(); y += 25 )
+        for ( int32_t x = 0; x < output.width(); x += 96 )
+            Blit( paper, 48, 10, output, x, y, std::min<int32_t>( 96, output.width() - x ), std::min<int32_t>( 25, output.height() - y ) );
+}
+#endif
