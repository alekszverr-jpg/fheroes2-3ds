+void Interface3DS::showWell( const Castle & castle, const std::function<void( int )> & recruit )
+{
+    const CursorRestorer hideCursor( false );
+    const bool evil = Settings::Get().isEvilInterfaceEnabled();
+    const uint8_t background = GetColorId( 35, 29, 24 );
+    Image top( 400, 240 ), bottom( 320, 240 ), firstPortrait;
+    const Rect portraitArea{ 8, 43, 128, 150 };
+    const std::array<Rect, 3> controls{ Rect{ 8, 205, 96, 27 }, { 112, 205, 96, 27 }, { 216, 205, 96, 27 } };
+    std::string recruitLabel = _( "Recruit %{name}" ); StringReplace( recruitLabel, "%{name}", "" );
+    while ( !recruitLabel.empty() && recruitLabel.back() == ' ' ) recruitLabel.pop_back();
+    const std::array<std::string, 3> labels{ recruitLabel, _( "Max" ), _( "Exit" ) };
+    std::array<std::unique_ptr<ButtonBase>, 3> buttons;
+    for ( int i = 0; i < 3; ++i ) {
+        Sprite released, pressed;
+        makeButtonSprites( released, pressed, "", { controls[i].width - 10, controls[i].height }, evil, evil ? ICN::STONEBAK_EVIL : ICN::STONEBAK );
+        Text text( labels[i], FontType::normalWhite() ); text.fitToOneRow( released.width() - 8 );
+        text.draw( 4, ( released.height() - text.height() ) / 2, released.width() - 8, released );
+        text.draw( 3, ( pressed.height() - text.height() ) / 2 + 1, pressed.width() - 8, pressed );
+        buttons[i] = std::make_unique<ButtonSprite>( controls[i].x, controls[i].y, std::move( released ), std::move( pressed ) );
+    }
+    int selected = 0, focus = 0, pressed = -1;
+    bool down = false, moved = false, closed = false, captureIdle = false;
+    Point start; Uint32 began = 0;
+    std::vector<int> frames;
+    Rect bounds;
+    size_t frame = 0;
+    Uint32 tick = SDL_GetTicks();
+    const auto preparePortrait = [&]() {
+        const Monster monster( castle.GetRace(), castle.GetActualDwelling( dwellingId( selected ) ) );
+        const AnimationReference reference( monster.GetID() );
+        const auto & standing = reference.getAnimationVector( Monster_Info::STAND_STILL );
+        if ( standing.empty() ) throw std::runtime_error( "Well portrait has no standing frame" );
+        frames.assign( 12, standing.front() );
+        const auto & idle = reference.getAnimationVector( Monster_Info::IDLE );
+        frames.insert( frames.end(), idle.begin(), idle.end() );
+        const auto & first = Assets::getImage( monster.GetMonsterSprite(), frames.front() );
+        int32_t left = first.x(), upper = first.y(), right = left + first.width(), lower = upper + first.height();
+        for ( int index : frames ) {
+            const auto & sprite = Assets::getImage( monster.GetMonsterSprite(), index );
+            left = std::min( left, sprite.x() ); upper = std::min( upper, sprite.y() );
+            right = std::max( right, sprite.x() + sprite.width() ); lower = std::max( lower, sprite.y() + sprite.height() );
+        }
+        bounds = { left, upper, right - left, lower - upper }; frame = 0; tick = SDL_GetTicks();
+    };
+    const auto select = [&]( int index ) { if ( selected != index ) { selected = index; preparePortrait(); } };
+    const auto available = [&]( int index ) { return castle.isBuild( dwellingId( index ) ) && castle.getMonstersInDwelling( dwellingId( index ) ) > 0; };
+    const auto allowed = [&]( int index ) {
+        if ( index == 6 ) return available( selected );
+        if ( index == 7 ) { for ( int i = 0; i < 6; ++i ) if ( available( i ) ) return true; return false; }
+        return true;
+    };
+    const auto activate = [&]( int index ) {
+        if ( index < 6 ) { select( index ); return; }
+        if ( index == 8 ) { closed = true; return; }
+        if ( !allowed( index ) ) return;
+        // All payment, availability, army placement and confirmations remain in Castle.
+        down = false; pressed = -1;
+        recruit( index == 7 ? -1 : selected );
+        LocalEvent::Get().resetFor3DSPanel();
+        Platform3DS::freezeViewportFollow( LocalEvent::Get().getMouseCursorPos(), SDL_GetTicks() );
+        preparePortrait();
+    };
+    preparePortrait();
+    const WellScope scope( top, bottom );
+    const auto draw = [&]() {
+        top.fill( background ); bottom.fill( background );
+        StandardWindow::renderBackgroundImage( top, { 0, 0, 400, 240 }, 0, evil );
+        StandardWindow::renderBackgroundImage( bottom, { 0, 0, 320, 240 }, 0, evil );
+        const Monster monster( castle.GetRace(), castle.GetActualDwelling( dwellingId( selected ) ) );
+        Text title( monster.GetMultiName(), FontType::normalYellow() ); title.fitToOneRow( 384 ); title.draw( 8, 8, 384, top );
+        Image portrait( bounds.width, bounds.height ); portrait.reset();
+        const auto & sprite = Assets::getImage( monster.GetMonsterSprite(), frames[frame] );
+        Blit( sprite, portrait, sprite.x() - bounds.x, sprite.y() - bounds.y );
+        const double scale = std::min( double( portraitArea.width ) / bounds.width, double( portraitArea.height ) / bounds.height );
+        Image scaled( std::max( 1, int( bounds.width * scale ) ), std::max( 1, int( bounds.height * scale ) ) ); scaled.reset(); Resize( portrait, scaled );
+        Blit( scaled, top, portraitArea.x + ( portraitArea.width - scaled.width() ) / 2, portraitArea.y + ( portraitArea.height - scaled.height() ) / 2 );
+        std::string stats = std::string( _( "Attack" ) ) + ": " + std::to_string( monster.GetAttack() )
+            + "\n" + _( "Defense" ) + ": " + std::to_string( monster.GetDefense() )
+            + "\n" + _( "Damage" ) + ": " + std::to_string( monster.GetDamageMin() ) + "-" + std::to_string( monster.GetDamageMax() )
+            + "\n" + _( "HP" ) + ": " + std::to_string( monster.GetHitPoints() )
+            + "\n" + _( "Speed" ) + ": " + Speed::String( monster.GetSpeed() );
+        if ( castle.isBuild( dwellingId( selected ) ) ) {
+            const uint32_t growth = monster.GetGrown() + ( castle.isBuild( BUILD_WELL ) ? Castle::GetGrownWell() : 0 )
+                + ( selected == 0 && castle.isBuild( BUILD_WEL2 ) ? Castle::GetGrownWel2() : 0 );
+            stats += "\n" + std::string( _( "Available" ) ) + ": " + std::to_string( castle.getMonstersInDwelling( dwellingId( selected ) ) )
+                + "\n" + _( "Growth" ) + ": +" + std::to_string( growth ) + " / " + _( "week" );
+        }
+        else stats += "\n" + castle.GetStringBuilding( castle.GetActualDwelling( dwellingId( selected ) ) );
+        Text( stats, FontType::normalWhite() ).draw( 144, 39, 248, top );
+        int resources = 0; const Funds cost = monster.GetCost();
+        for ( int resource = Resource::WOOD; resource <= Resource::GOLD; resource <<= 1 ) if ( cost.Get( resource ) ) ++resources;
+        int x = ( 400 - resources * 78 ) / 2;
+        for ( int resource = Resource::WOOD; resource <= Resource::GOLD; resource <<= 1 ) if ( cost.Get( resource ) ) {
+            const auto & icon = Assets::getImage( ICN::RESOURCE, Resource::getIconIcnIndex( resource ) );
+            Image resourceIcon( 24, 24 ); resourceIcon.reset(); Resize( icon, resourceIcon );
+            Blit( resourceIcon, top, x, 206 ); Text( std::to_string( cost.Get( resource ) ), FontType::normalWhite() ).draw( x + 30, 212, top ); x += 78;
+        }
+        Text name( castle.GetName(), FontType::normalYellow() ); name.fitToOneRow( 304 ); name.draw( 8, 8, 304, bottom );
+        for ( int i = 0; i < 6; ++i ) {
+            const auto area = tileArea( i ); const uint32_t dwelling = dwellingId( i );
+            Fill( bottom, area.x, area.y, area.width, area.height, background );
+            DrawRect( bottom, area, i == selected ? GetColorId( 255, 220, 96 ) : GetColorId( 120, 90, 55 ) );
+            const Monster item( castle.GetRace(), castle.GetActualDwelling( dwelling ) );
+            const auto & icon = Assets::getImage( ICN::MONS32, item.GetSpriteIndex() );
+            Blit( icon, bottom, area.x + ( area.width - icon.width() ) / 2, area.y + 3 );
+            Text label( item.GetMultiName(), castle.isBuild( dwelling ) ? FontType::smallWhite() : FontType::smallYellow() );
+            label.fitToOneRow( 88 ); label.draw( area.x + 4, area.y + 40, 88, bottom );
+            Text( castle.isBuild( dwelling ) ? std::to_string( castle.getMonstersInDwelling( dwelling ) ) : "-", FontType::normalYellow() ).draw( area.x + 4, area.y + 53, 88, bottom );
+        }
+        Text hint( "A: " + recruitLabel + "   Y: " + _( "Max" ), FontType::smallWhite() ); hint.fitToOneRow( 304 ); hint.draw( 8, 192, 304, bottom );
+        for ( int i = 0; i < 3; ++i ) {
+            if ( allowed( i + 6 ) ) buttons[i]->enable(); else buttons[i]->disable();
+            if ( down && !moved && pressed == i + 6 ) buttons[i]->press(); else buttons[i]->release(); buttons[i]->draw( bottom );
+        }
+        DrawRect( bottom, focus < 6 ? tileArea( focus ) : controls[focus - 6], GetColorId( 160, 220, 255 ) );
+        Display::instance().render();
+        if ( captureWellAnimation ) {
+            Image current( portraitArea.width, portraitArea.height ); Copy( top, portraitArea.x, portraitArea.y, current, 0, 0, current.width(), current.height() );
+            if ( firstPortrait.empty() ) {
+                firstPortrait = current;
+                if ( !Save( top, "sdmc:/3ds/fheroes2/well-top.bmp" ) || !Save( bottom, "sdmc:/3ds/fheroes2/well-bottom.bmp" ) ) throw std::runtime_error( "Cannot save well" );
+            }
+            else if ( !captureIdle && std::memcmp( firstPortrait.image(), current.image(), current.width() * current.height() ) ) {
+                captureIdle = true; ++wellAnimationChanges;
+                if ( !Save( top, "sdmc:/3ds/fheroes2/well-idle-top.bmp" ) ) throw std::runtime_error( "Cannot save well idle" );
+            }
+        }
+    };
+    draw(); COUT( "3DS well: panel ready" )
+    auto & events = LocalEvent::Get();
+    while ( !closed && events.HandleEvents() ) {
+        bool redraw = false; Platform3DS::PanelInput input;
+        while ( !closed && Platform3DS::consumePanelInput( input ) ) {
+            redraw = true;
+            if ( input.type == Platform3DS::PanelInputType::Key ) {
+                switch ( input.key ) {
+                case Platform3DS::PanelKey::Cancel: closed = true; break;
+                case Platform3DS::PanelKey::Left: focus = ( focus + 8 ) % 9; if ( focus < 6 ) select( focus ); break;
+                case Platform3DS::PanelKey::Right: focus = ( focus + 1 ) % 9; if ( focus < 6 ) select( focus ); break;
+                case Platform3DS::PanelKey::Up: focus = ( focus + 6 ) % 9; if ( focus < 6 ) select( focus ); break;
+                case Platform3DS::PanelKey::Down: focus = ( focus + 3 ) % 9; if ( focus < 6 ) select( focus ); break;
+                case Platform3DS::PanelKey::Confirm: activate( focus < 6 ? 6 : focus ); break;
+                case Platform3DS::PanelKey::Toggle: activate( 7 ); break;
+                default: break;
+                }
+            }
+            else if ( input.type == Platform3DS::PanelInputType::TouchDown ) {
+                start = input.position; began = SDL_GetTicks(); down = true; moved = false; pressed = -1;
+                for ( int i = 0; i < 9; ++i ) if ( ( i < 6 ? tileArea( i ) : controls[i - 6] ) & start ) { pressed = focus = i; break; }
+            }
+            else if ( input.type == Platform3DS::PanelInputType::TouchMove && down ) {
+                moved = moved || std::abs( input.position.x - start.x ) >= 6 || std::abs( input.position.y - start.y ) >= 6;
+            }
+            else if ( input.type == Platform3DS::PanelInputType::TouchUp ) {
+                if ( down && !moved && SDL_GetTicks() - began < 550 && pressed >= 0 && ( ( pressed < 6 ? tileArea( pressed ) : controls[pressed - 6] ) & input.position ) ) {
+                    // First tap selects; a second tap opens the original recruitment dialog.
+                    if ( pressed < 6 && pressed == selected ) activate( 6 ); else activate( pressed );
+                }
+                down = false; pressed = -1;
+            }
+        }
+        const Uint32 now = SDL_GetTicks();
+        if ( now - tick >= 75 ) { frame = ( frame + ( now - tick ) / 75 ) % frames.size(); tick = now; redraw = true; }
+        if ( redraw && !closed ) draw();
+    }
+}
