+int Interface3DS::showMageGuild( const Castle & castle, const Heroes * hero )
+{
+    const int maximum = castle.GetLevelMageGuild();
+    if ( maximum < 1 ) return 0;
+    const CursorRestorer hideCursor( false );
+    Image top( 400, 240 ), bottom( 320, 240 ), description;
+    const bool evil = Settings::Get().isEvilInterfaceEnabled();
+    const uint8_t background = GetColorId( 35, 29, 24 );
+    const std::array<Rect, 5> controls{ Rect{ 8, 207, 88, 26 }, { 104, 207, 112, 26 }, { 224, 207, 88, 26 }, { 8, 1, 28, 25 }, { 284, 1, 28, 25 } };
+    std::array<std::unique_ptr<ButtonBase>, 5> buttons;
+    for ( int i = 0; i < 5; ++i ) {
+        Sprite released, pressed;
+        makeButtonSprites( released, pressed, "", { controls[i].width - 10, controls[i].height }, evil, evil ? ICN::STONEBAK_EVIL : ICN::STONEBAK );
+        if ( i == 1 ) {
+            Text text( _( "Exit" ), FontType::normalWhite() );
+            text.draw( 4, ( released.height() - text.height() ) / 2, released.width() - 8, released );
+            text.draw( 3, ( pressed.height() - text.height() ) / 2 + 1, pressed.width() - 8, pressed );
+        }
+        else {
+            const bool previous = i == 0 || i == 3;
+            for ( int dx = 0; dx < 6; ++dx ) for ( int dy = -dx; dy <= dx; ++dy ) {
+                const int x = released.width() / 2 + ( previous ? dx - 3 : 3 - dx );
+                SetPixel( released, x, released.height() / 2 + dy, GetColorId( 255, 220, 150 ) );
+                SetPixel( pressed, x - 1, pressed.height() / 2 + dy + 1, GetColorId( 255, 220, 150 ) );
+            }
+        }
+        buttons[i] = std::make_unique<ButtonSprite>( controls[i].x, controls[i].y, std::move( released ), std::move( pressed ) );
+    }
+    int level = 1, selected = 0, focus = 0, scroll = 0, pressed = -1, answer = 0;
+    bool down = false, moved = false, closed = false; Point start, last;
+    SpellStorage spells;
+    const auto refresh = [&]() {
+        spells = castle.GetMageGuild().GetSpells( maximum, castle.isLibraryBuilt(), level );
+        spells.resize( MageGuild::getMaxSpellsCount( level, castle.HaveLibraryCapability() ), Spell::NONE );
+        selected = 0; scroll = 0;
+    };
+    refresh();
+    const auto allowed = [&]( int index ) { return index == 4 ? level > 1 : index == 6 ? level < maximum : index >= 7 ? castle.GetKingdom().GetCastles().size() > 1 : true; };
+    const auto activate = [&]( int index ) {
+        if ( index < 4 ) { selected = index; scroll = 0; }
+        else if ( allowed( index ) ) {
+            if ( index == 4 || index == 6 ) { level += index == 4 ? -1 : 1; refresh(); }
+            else { answer = index == 7 ? -1 : index == 8 ? 1 : 0; closed = true; }
+        }
+    };
+    const GuildScope scope( top, bottom );
+    const auto draw = [&]() {
+        top.fill( background ); bottom.fill( background );
+        StandardWindow::renderBackgroundImage( top, { 0, 0, 400, 240 }, 0, evil );
+        StandardWindow::renderBackgroundImage( bottom, { 0, 0, 320, 240 }, 0, evil );
+        Text title( castle.GetStringBuilding( uint32_t( BUILD_MAGEGUILD1 ) << ( maximum - 1 ) ), FontType::normalYellow() ); title.fitToOneRow( 376 ); title.draw( 12, 8, 376, top );
+        const auto & original = Assets::getImage( guildArtwork( castle.GetRace() ), maximum - 1 );
+        const auto roi = GetActiveROI( original );
+        if ( roi.width > 0 && roi.height > 0 ) {
+            const Image cropped = Crop( original, roi.x, roi.y, roi.width, roi.height );
+            const double scale = std::min( 116.0 / cropped.width(), 158.0 / cropped.height() );
+            Image art( std::max( 1, int( cropped.width() * scale ) ), std::max( 1, int( cropped.height() * scale ) ) ); art.reset(); Resize( cropped, art );
+            Blit( art, top, 8 + ( 116 - art.width() ) / 2, 42 + ( 158 - art.height() ) / 2 );
+        }
+        const Spell spell = selected < int( spells.size() ) ? spells[selected] : Spell::NONE;
