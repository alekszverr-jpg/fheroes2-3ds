+    int detailFrameHeight() { return battleHUD ? std::min<int32_t>( frameSize.height, battleTargets[3].y ) : frameSize.height; }
+    fheroes2::Image * battleHUDImage() { return battleHUD; }
+    void setBattleHUD( fheroes2::Image * image, const std::array<fheroes2::Rect, 4> & targets )
+    {
+        battleHUD = image;
+        battleTargets = targets;
+        if ( !image ) battleTouch = false;
+    }
+    bool isBattleHUDPointer( const fheroes2::Point point )
+    {
+        if ( !battleHUD ) return false;
+        for ( const auto & target : battleTargets ) if ( target & point ) return true;
+        return false;
+    }
+    bool handleStripTouch( const PanelInputType type, const float x, const float y )
+    {
+        if ( type == PanelInputType::TouchDown ) stripTouchCaptured = !battleHUD && stripImage && y >= 200.0f / 240;
+        if ( !stripTouchCaptured ) return false;
+        // Capture the entire gesture, including release after hiding the strip or opening a dialog.
+        if ( stripImage ) handlePanelTouch( type, x, y );
+        if ( type == PanelInputType::TouchUp ) stripTouchCaptured = false;
+        return true;
+    }
+    const fheroes2::Image * commandPanelImage() { return panelImage; }
+    void setCommandPanelImage( const fheroes2::Image * image ) { panelImage = image; panelInputs.clear(); }
+    bool consumePanelInput( PanelInput & input )
+    {
+        if ( panelInputs.empty() ) return false;
+        input = panelInputs.front(); panelInputs.pop_front(); return true;
+    }
+    fheroes2::Rect panelButtonRect( const int index ) { return { 8 + ( index % 2 ) * 156, 42 + ( index / 2 ) * 42, 148, 38 }; }
+    int panelButtonAt( const fheroes2::Point point )
+    {
+        for ( int i = 0; i < 8; ++i ) if ( panelButtonRect( i ) & point ) return i;
+        return -1;
+    }
+    bool handlePanelController( const int button, const bool pressed )
+    {
+        const uint32_t bit = button >= 0 && button < 32 ? uint32_t( 1 ) << button : 0;
+        if ( !panelImage && !hasModalImages() ) {
+            if ( !( panelControllerHeld & bit ) ) return false;
+            if ( !pressed ) panelControllerHeld &= ~bit;
+            return true; // Swallow the release of a button that closed the panel.
+        }
+        if ( !pressed ) {
+            panelControllerHeld &= ~bit;
+            if ( hasModalImages() && button == SDL_CONTROLLER_BUTTON_B )
+                panelInputs.push_back( { PanelInputType::KeyUp, PanelKey::Information, {} } );
+            return true;
+        }
+        panelControllerHeld |= bit;
+        PanelKey key;
+        switch ( button ) {
+        case SDL_CONTROLLER_BUTTON_DPAD_UP: key = PanelKey::Up; break;
+        case SDL_CONTROLLER_BUTTON_DPAD_DOWN: key = PanelKey::Down; break;
+        case SDL_CONTROLLER_BUTTON_DPAD_LEFT: key = PanelKey::Left; break;
+        case SDL_CONTROLLER_BUTTON_DPAD_RIGHT: key = PanelKey::Right; break;
+        case SDL_CONTROLLER_BUTTON_A:
+        case SDL_CONTROLLER_BUTTON_START: key = PanelKey::Confirm; break;
+        case SDL_CONTROLLER_BUTTON_B:
+            key = hasModalImages() ? PanelKey::Information : PanelKey::Cancel; break;
+        case SDL_CONTROLLER_BUTTON_Y:
+            key = hasModalImages() ? PanelKey::Toggle : PanelKey::Cancel; break;
+        case SDL_CONTROLLER_BUTTON_LEFTSHOULDER: key = PanelKey::Cancel; break;
+        default: return true;
+        }
+        panelInputs.push_back( { PanelInputType::Key, key, {} } );
+        return true;
+    }
+    bool handlePanelKeyboard( const int key, const bool pressed )
+    {
+        if ( !panelImage && !hasModalImages() ) {
+            if ( !panelKeyboardHeld.count( key ) ) return false;
+            if ( !pressed ) panelKeyboardHeld.erase( key );
+            return true;
+        }
+        if ( !pressed ) { panelKeyboardHeld.erase( key ); return true; }
+        panelKeyboardHeld.insert( key );
+        PanelKey panelKey;
+        switch ( key ) {
+        case SDLK_UP: panelKey = PanelKey::Up; break;
+        case SDLK_DOWN: panelKey = PanelKey::Down; break;
+        case SDLK_LEFT: panelKey = PanelKey::Left; break;
+        case SDLK_RIGHT: panelKey = PanelKey::Right; break;
+        case SDLK_RETURN: panelKey = PanelKey::Confirm; break;
+        case SDLK_ESCAPE:
+        case SDLK_F12: panelKey = PanelKey::Cancel; break;
+        default: return true;
+        }
+        panelInputs.push_back( { PanelInputType::Key, panelKey, {} } );
+        return true;
+    }
+    void handlePanelTouch( const PanelInputType type, const float x, const float y )
+    {
+        panelInputs.push_back( { type, PanelKey::Cancel,
+                                { std::clamp<int32_t>( static_cast<int32_t>( std::floor( x * 320 ) ), 0, 319 ),
+                                  std::clamp<int32_t>( static_cast<int32_t>( std::floor( y * 240 ) ), 0, 239 ) } } );
+    }
+    fheroes2::Point viewport() { return crop; }
+    void freezeViewportFollow( const fheroes2::Point cursor, const uint32_t now )
+    {
+        target = crop; cameraX = crop.x; cameraY = crop.y;
+        lastCursor = cursor; lastUpdate = now; initialized = true;
+        viewportFrozen = true;
+        touchViewportChanged = false;
+    }
+    void resetViewportFollow()
+    {
+        touchHeld = false;
+        anchorAfterTouch = false;
+        initialized = false;
+        viewportFrozen = false;
+        touchViewportChanged = false;
+        touchMotionInitialized = false;
+        touchViewportGesture = false;
+        touchPointerActive = false;
+        touchRightHeld = false;
+        cameraX = crop.x;
+        cameraY = crop.y;
+        target = crop;
+    }
+    bool needsViewportRefresh( const uint32_t now )
+    {
+        if ( displayRefresh ) return true;
+        if ( hasModalImages() || viewportFrozen ) return false;
+        return touchViewportChanged || ( !touchHeld && !anchorAfterTouch && target != crop && now - lastUpdate >= 16 );
+    }
+    void followCursor( const fheroes2::Point cursor, const uint32_t now, const bool buttonHeld )
+    {
+        if ( viewportFrozen && cursor == lastCursor ) return;
+        viewportFrozen = false;
+        const int height = detailHeight();
+        if ( height != previousDetailHeight ) initialized = false;
+        previousDetailHeight = height;
+        const int maxX = frameSize.width - 320, maxY = detailFrameHeight() - height;
+        crop.x = std::clamp<int32_t>( crop.x, 0, maxX );
+        crop.y = std::clamp<int32_t>( crop.y, 0, maxY );
+        cameraX = std::clamp( cameraX, 0.0, double( maxX ) );
+        cameraY = std::clamp( cameraY, 0.0, double( maxY ) );
+        const uint32_t elapsed = initialized ? now - lastUpdate : 16;
+        lastUpdate = now;
+        if ( touchHeld || buttonHeld || anchorAfterTouch ) {
+            // Discard remaining camera motion so releasing a click cannot move its target.
+            target = crop;
+            if ( !touchHeld ) {
+                cameraX = crop.x;
+                cameraY = crop.y;
+            }
+            touchViewportChanged = false;
+            lastCursor = cursor;
+            initialized = true;
+            anchorAfterTouch = false;
+            return;
+        }
+        if ( !initialized || cursor != lastCursor ) {
+            // A 64x48 stationary zone around the detail screen's centre prevents jitter.
+            if ( cursor.x < crop.x + 128 ) target.x = cursor.x - 128;
+            else if ( cursor.x > crop.x + 192 ) target.x = cursor.x - 192;
+            if ( cursor.y < crop.y + height / 2 - 24 ) target.y = cursor.y - ( height / 2 - 24 );
+            else if ( cursor.y > crop.y + height / 2 + 24 ) target.y = cursor.y - ( height / 2 + 24 );
+            target.x = std::clamp<int32_t>( target.x, 0, maxX );
+            target.y = std::clamp<int32_t>( target.y, 0, maxY );
+        }
+        lastCursor = cursor;
+        initialized = true;
+        // Time-based easing; cap gaps after blocking dialogs or suspend.
+        const double blend = 1.0 - std::exp( -static_cast<double>( std::min<uint32_t>( elapsed, 50 ) ) / 90.0 );
+        cameraX += ( target.x - cameraX ) * blend;
+        cameraY += ( target.y - cameraY ) * blend;
+        // Even a sudden pointer warp must remain visible. Screen edges clamp naturally.
+        cameraX = std::clamp( cameraX, double( std::max<int32_t>( 0, cursor.x - 319 ) ), double( std::min<int32_t>( maxX, cursor.x ) ) );
+        target.y = std::clamp<int32_t>( target.y, 0, maxY );
+        const int32_t visibleY = std::clamp<int32_t>( cursor.y, 0, detailFrameHeight() - 1 );
+        cameraY = std::clamp( cameraY, double( std::max<int32_t>( 0, visibleY - height + 1 ) ), double( std::min<int32_t>( maxY, visibleY ) ) );
+        crop = { static_cast<int32_t>( std::round( cameraX ) ), static_cast<int32_t>( std::round( cameraY ) ) };
+    }
+    fheroes2::Point touchPosition( const float x, const float y )
+    {
+        if ( battleTouch && battleHUD ) return battleTouchTarget;
+        return { crop.x + std::clamp<int32_t>( static_cast<int32_t>( std::floor( x * 320 ) ), 0, 319 ),
+                 std::clamp<int32_t>( crop.y, 0, detailFrameHeight() - detailHeight() )
+                     + std::clamp<int32_t>( static_cast<int32_t>( std::floor( y * 240 ) ), 0, detailHeight() - 1 ) };
+    }
+    void setTouchHeld( const bool held )
+    {
+        if ( held != touchHeld ) {
+            touchMotionInitialized = false;
+            cameraX = crop.x;
+            cameraY = crop.y;
+        }
+        if ( touchHeld && !held ) anchorAfterTouch = true;
+        touchHeld = held;
+    }
+    void beginTouch( const float x, const float y )
+    {
+        viewportFrozen = false;
+        crop.y = std::clamp<int32_t>( crop.y, 0, detailFrameHeight() - detailHeight() );
+        setTouchHeld( true );
+        battleTouch = battleHUD && y >= 200.0f / 240;
+        if ( battleTouch ) {
+            const int px = std::clamp<int>( int( x * 320 ), 0, 319 );
+            const int py = std::clamp<int>( int( y * 240 ), 200, 239 );
+            const int index = px < 40 ? ( py < 220 ? 0 : 1 ) : px >= 280 ? 2 : 3;
+            const auto & area = battleTargets[index];
+            battleTouchTarget = { area.x + area.width / 2, area.y + area.height / 2 };
+        }
+        const auto point = touchPosition( x, y );
+        touchStart = { point.x - crop.x, point.y - crop.y };
+        touchViewportGesture = false;
+        touchPointerActive = true;
+        touchRightHeld = false;
+        if ( battleTouch ) touchStart = { int32_t( x * 320 ), int32_t( y * 240 ) };
+    }
+    bool isTouchViewportGesture() { return touchViewportGesture; }
+    bool isTouchPointerActive() { return touchPointerActive; }
+    void useControllerPointer() { if ( !touchHeld ) touchPointerActive = false; }
+    void setTouchRightHeld( const bool held ) { touchRightHeld = held; }
+    void followTouchMotion( const float x, const float y, const uint32_t now )
+    {
+        if ( !touchHeld || touchRightHeld ) return;
+        if ( battleTouch && battleHUD ) {
+            if ( std::abs( int32_t( x * 320 ) - touchStart.x ) >= 6 || std::abs( int32_t( y * 240 ) - touchStart.y ) >= 6 ) touchViewportGesture = true;
+            return;
+        }
+        const auto point = touchPosition( x, y );
+        const int32_t localX = point.x - crop.x, localY = point.y - crop.y;
+        // Use physical stylus displacement, independent of the moving virtual crop.
+        if ( std::abs( localX - touchStart.x ) >= 10 || std::abs( localY - touchStart.y ) >= 10 ) touchViewportGesture = true;
+        // Ignore small pen jitter so tapping a button near an edge cannot pan or cancel its click.
+        if ( !touchViewportGesture ) return;
+        const int32_t shiftX = localX < 128 ? localX - 128 : ( localX > 192 ? localX - 192 : 0 );
+        const int height = detailHeight();
+        const int low = height / 2 - 24, high = height / 2 + 24;
+        const int32_t shiftY = localY < low ? localY - low : ( localY > high ? localY - high : 0 );
+        const uint32_t elapsed = touchMotionInitialized ? now - lastTouchMotion : 16;
+        lastTouchMotion = now;
+        touchMotionInitialized = true;
+        const double blend = 1.0 - std::exp( -static_cast<double>( std::min<uint32_t>( elapsed, 50 ) ) / 90.0 );
+        cameraX = std::clamp( cameraX + shiftX * blend, 0.0, double( frameSize.width - 320 ) );
+        cameraY = std::clamp( cameraY + shiftY * blend, 0.0, double( detailFrameHeight() - height ) );
+        const fheroes2::Point nextCrop{ static_cast<int32_t>( std::round( cameraX ) ), static_cast<int32_t>( std::round( cameraY ) ) };
+        touchViewportChanged = touchViewportChanged || nextCrop != crop;
+        if ( nextCrop != crop ) touchViewportGesture = true;
+        crop = nextCrop;
+        // Touch moves the camera only on motion events: a still press cannot keep scrolling.
+        target = crop;
+    }
+    bool smokeTest()
+    {
+        static const bool enabled = std::filesystem::exists( "sdmc:/3ds/fheroes2/menu-smoke.enabled" );
+        return enabled;
+    }
+    void requestCapture() { capture = true; }
+    bool consumeCapture() { const bool result = capture; capture = false; return result; }
+}
+#endif
