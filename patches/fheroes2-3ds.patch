+            const ResourceDialogElement cost( used[i], std::to_string( price.Get( used[i] ) ) );
+            cost.draw( window, { 159 + columnWidth * int( i ) + ( columnWidth - cost.area().width ) / 2, 57 } );
+            const int32_t total = price.Get( used[i] ) * count;
+            const int totalWidth = 352 / int( used.size() );
+            const ResourceDialogElement totalCost( used[i], std::to_string( total ) );
+            totalCost.draw( upperWindow, { 24 + int( i ) * totalWidth + ( totalWidth - totalCost.area().width ) / 2, 136 } );
+            Text( std::to_string( funds.Get( used[i] ) ) + " - " + std::to_string( total ) + " = " + std::to_string( funds.Get( used[i] ) - total ), FontType::smallWhite() )
