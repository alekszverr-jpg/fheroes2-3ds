+                return false;
+            }
+            u8 model = 255;
+            const Result result = CFGU_GetSystemModel( &model );
+            cfguExit();
+            if ( R_FAILED( result ) ) {
+                ERROR_LOG( "Cannot determine 3DS model: " << result )
+                return false;
+            }
+            return supportsHighResolutionModel( model );
+        }();
+        return supported;
+    }
+    bool highResolutionEnabled() { return highResolution; }
+    void setHighResolutionEnabled( const bool enabled )
+    {
+        if ( highResolution == enabled ) return;
+        highResolution = enabled;
+        displayRefresh = true;
+    }
+    void setDisplayPreferenceSaveCallback( void ( *callback )() ) { saveDisplayPreference = callback; }
+    bool consumeDisplayRefresh() { const bool refresh = displayRefresh; displayRefresh = false; return refresh; }
+    bool handleDisplayController( const int button, const bool pressed )
+    {
+        // R remains the pointer-speed modifier. Capture only Start in this chord, including its release.
+        if ( button == SDL_CONTROLLER_BUTTON_RIGHTSHOULDER ) displayModifierHeld = pressed;
+        if ( button != SDL_CONTROLLER_BUTTON_START ) return false;
+        if ( !pressed ) {
+            const bool captured = displayStartCaptured;
+            displayStartCaptured = false;
+            return captured;
+        }
+        if ( displayStartCaptured ) return true;
+        if ( !displayModifierHeld ) return false;
