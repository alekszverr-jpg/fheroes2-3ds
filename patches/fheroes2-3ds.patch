+        }
+        std::string availability = _( "Available: %{count}" );
+        StringReplace( availability, "%{count}", available );
+        Text( availability, FontType::smallWhite() ).draw( variants.size() > 1 ? 162 : 126, 110, variants.size() > 1 ? 100 : 170, window );
