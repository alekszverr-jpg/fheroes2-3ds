+Spell Interface3DS::showSpellBook( const HeroBase & hero, const std::vector<Spell> & availableSpells, const bool canCast,
+                                 size_t & page, const std::function<void( const std::string & )> & status,
+                                 SpellBook::Filter & filter, const bool switchFilters )
+{
+    using namespace fheroes2;
+    std::vector<Spell> spells;
+    const auto refill = [&]() {
+        spells.clear();
+        std::copy_if( availableSpells.begin(), availableSpells.end(), std::back_inserter( spells ), [&]( const Spell & spell ) {
+            return filter == SpellBook::Filter::CMBT ? spell.isCombat() : spell.isAdventure();
+        } );
+    };
+    refill();
+    const CursorRestorer hideCursor( false );
+    const bool evil = Settings::Get().isEvilInterfaceEnabled();
+    const uint8_t background = GetColorId( 35, 29, 24 ), border = GetColorId( 150, 115, 63 );
+    Image top( 400, 240 ), bottom( 320, 240 ), content;
+    page = spells.empty() ? 0 : std::min( page / 6 * 6, ( spells.size() - 1 ) / 6 * 6 );
+    size_t selected = page;
+    int scroll = 0;
+    const std::array<Rect, 4> controls{ Rect{ 4, 206, 40, 28 }, { 48, 206, 40, 28 }, { 92, 206, 140, 28 }, { 236, 206, 80, 28 } };
+    const std::array<std::string, 4> labels{ "<", ">", canCast ? _( "Cast Spell" ) : "?", _( "Exit" ) };
+    std::vector<std::unique_ptr<ButtonBase>> buttons;
+    for ( size_t i = 0; i < controls.size(); ++i ) {
+        Sprite released, pressed;
+        makeButtonSprites( released, pressed, "", { controls[i].width - 6, 22 }, evil, evil ? ICN::STONEBAK_EVIL : ICN::STONEBAK );
+        if ( i < 2 ) {
+            const uint8_t white = GetColorId( 255, 255, 255 );
+            for ( int row = -5; row <= 5; ++row ) {
+                const int width = 6 - std::abs( row ), x = released.width() / 2 - 3;
+                Fill( released, i == 0 ? x + std::abs( row ) : x, released.height() / 2 + row, width, 1, white );
+                Fill( pressed, i == 0 ? x + std::abs( row ) - 1 : x - 1, pressed.height() / 2 + row + 1, width, 1, white );
+            }
+        }
+        else {
+            Text label( labels[i], Text( labels[i], FontType::normalWhite() ).width() <= released.width() - 8 ? FontType::normalWhite() : FontType::smallWhite() );
+            label.fitToOneRow( released.width() - 8 );
+            label.draw( 4, ( released.height() - label.height() ) / 2, released.width() - 8, released );
