+Troop Interface3DS::showRecruit( const Monster & original, const uint32_t available, const bool allowDowngradedMonster, const Funds & funds )
+{
+    using namespace fheroes2;
+    const CursorRestorer cursorRestorer( false );
+    Image window( 320, 240 ), upperWindow;
+    const bool evil = Settings::Get().isEvilInterfaceEnabled();
+    const uint8_t border = GetColorId( 150, 115, 63 );
+    const Image background = Interface3DS::makeClassicPanelBackground( 320, evil );
+    const Image upperBackground = Interface3DS::makeClassicPanelBackground( 400, evil );
+    upperWindow = upperBackground;
+    // Reuse the original recruitment cost card, including its own title rail and shadow.
+    const auto & originalCost = Assets::getImage( ICN::RECRBKG, 0 );
+    const auto & costTitle = Assets::getImage( ICN::BLDGXTRA, 0 );
+    Sprite costCard( 132, 67 ); costCard.reset();
+    Copy( costTitle, 3, 58, costCard, 3, 0, 63, 14 );
+    Copy( costTitle, costTitle.width() - 66, 58, costCard, 66, 0, 63, 14 );
+    Copy( originalCost, 138, 54, costCard, 0, 0, 3, 63 );
+    Copy( originalCost, 267, 54, costCard, 129, 0, 3, 63 );
+    Copy( originalCost, 138, 117, costCard, 0, 63, 132, 4 );
+    Text( _( "Cost per troop:" ), FontType::smallWhite() ).draw( 3, 3, 126, costCard );
+    if ( evil ) ApplyPalette( costCard, PAL::GetPalette( PAL::PaletteType::GOOD_TO_EVIL_INTERFACE ) );
+    const std::array<int, 7> resources{ Resource::GOLD, Resource::WOOD, Resource::MERCURY, Resource::ORE, Resource::SULFUR, Resource::CRYSTAL, Resource::GEMS };
+    std::vector<Monster> variants{ original };
+    while ( allowDowngradedMonster && variants.back().GetDowngrade() != variants.back() )
+        variants.push_back( variants.back().GetDowngrade() );
+    size_t variant = 0;
+    uint32_t maximum = 0, count = 0;
+    const auto resetCount = [&]() {
+        maximum = available;
+        const Funds price = variants[variant].GetCost();
+        for ( const int resource : resources )
+            if ( price.Get( resource ) > 0 )
+                maximum = std::min( maximum, uint32_t( std::max<int32_t>( 0, funds.Get( resource ) ) / price.Get( resource ) ) );
+        count = maximum;
+    };
+    resetCount();
+    enum
+    {
+        Minus,
+        Plus,
+        Minimum,
+        Maximum,
+        Previous,
+        Next,
+        Confirm,
+        Cancel
+    };
+    std::vector<std::unique_ptr<ButtonBase>> buttons;
+    const std::array<std::string, 8> labels{ "-", "+", "MIN", "MAX", "<", ">", _( "Okay" ), _( "Cancel" ) };
+    const std::array<Rect, 8> areas{ Rect{ 70, 128, 20, 16 }, { 218, 128, 20, 16 }, { 24, 128, 36, 16 },  { 248, 128, 36, 16 },
+                                     { 126, 104, 16, 10 },      { 266, 104, 16, 10 },   { 12, 186, 116, 24 }, { 172, 186, 116, 24 } };
+    for ( size_t i = 0; i < labels.size(); ++i ) {
+        if ( i >= Confirm ) {
+            const int icn = i == Confirm ? ( evil ? ICN::UNIFORM_EVIL_OKAY_BUTTON : ICN::UNIFORM_GOOD_OKAY_BUTTON )
+                                        : ( evil ? ICN::UNIFORM_EVIL_CANCEL_BUTTON : ICN::UNIFORM_GOOD_CANCEL_BUTTON );
+            buttons.emplace_back( std::make_unique<Button>( 0, 0, icn, 0, 1 ) );
+            continue;
+        }
+        Sprite released, pressed;
+        makeButtonSprites( released, pressed, "", { areas[i].width, areas[i].height }, evil, evil ? ICN::UNIFORMBAK_EVIL : ICN::UNIFORMBAK_GOOD );
+        const Text label( ( i == Previous || i == Next ) ? "" : labels[i], FontType::smallWhite() );
+        label.draw( 4, ( released.height() - label.height( released.width() - 8 ) ) / 2, released.width() - 8, released );
+        label.draw( 3, ( pressed.height() - label.height( pressed.width() - 8 ) ) / 2 + 1, pressed.width() - 8, pressed );
+        if ( i == Previous || i == Next ) {
+            for ( int dx = 0; dx < 5; ++dx ) {
+                const int x = released.width() / 2 + ( i == Previous ? dx - 2 : 2 - dx );
+                for ( int dy = -dx; dy <= dx; ++dy ) {
+                    SetPixel( released, x, released.height() / 2 + dy, GetColorId( 255, 220, 150 ) );
+                    SetPixel( pressed, x - 1, pressed.height() / 2 + dy + 1, GetColorId( 255, 220, 150 ) );
+                }
+            }
+        }
+        buttons.emplace_back( std::make_unique<ButtonSprite>( areas[i].x, areas[i].y, std::move( released ), std::move( pressed ) ) );
+    }
+    // Custom button frames add borders to the requested content size. Position from their actual hit areas.
+    buttons[Minimum]->setPosition( 24, 128 );
+    buttons[Maximum]->setPosition( 296 - buttons[Maximum]->area().width, 128 );
+    buttons[Minus]->setPosition( 28 + buttons[Minimum]->area().width, 128 );
+    buttons[Plus]->setPosition( buttons[Maximum]->area().x - buttons[Plus]->area().width - 4, 128 );
+    const int quantityX = buttons[Minus]->area().x + buttons[Minus]->area().width + 4;
+    const int quantityWidth = buttons[Plus]->area().x - quantityX - 4;
+    if ( Platform3DS::smokeTest() ) {
+        const std::array<int, 4> row{ Minimum, Minus, Plus, Maximum };
+        for ( size_t i = 1; i < row.size(); ++i ) {
+            const auto & left = buttons[row[i - 1]]->area();
+            if ( left.x + left.width >= buttons[row[i]]->area().x )
+                throw std::runtime_error( "Recruit quantity buttons overlap" );
+        }
+        if ( quantityWidth < 60 )
+            throw std::runtime_error( "Recruit quantity text has no room" );
+    }
+    for ( const int action : { Confirm, Cancel } )
+        buttons[action]->setPosition( ( action == Confirm ? 88 : 232 ) - buttons[action]->area().width / 2, 186 );
+    const auto hitArea = [&]( const int action ) {
+        return action == Confirm ? Rect{ 24, 180, 128, 38 } : action == Cancel ? Rect{ 168, 180, 128, 38 } : buttons[action]->area();
+    };
+    const Rect slider{ 24, 158, 272, 22 };
+    const Rect portraitArea{ 24, 38, 96, 90 };
+    std::vector<int> portraitFrames;
+    Rect portraitBounds;
+    size_t portraitFrame = 0;
+    Uint32 portraitTick = SDL_GetTicks();
+    Image firstPortrait;
+    bool capturedIdle = false;
+    const auto preparePortrait = [&]() {
+        const AnimationReference reference( variants[variant].GetID() );
+        const auto & standing = reference.getAnimationVector( Monster_Info::STAND_STILL );
+        if ( standing.empty() ) throw std::runtime_error( "Recruit portrait has no standing frame" );
+        portraitFrames.assign( 12, standing.front() );
+        const auto & idle = reference.getAnimationVector( Monster_Info::IDLE );
+        portraitFrames.insert( portraitFrames.end(), idle.begin(), idle.end() );
+        const int icn = variants[variant].GetMonsterSprite();
+        const auto & first = Assets::getImage( icn, portraitFrames.front() );
+        int32_t left = first.x(), top = first.y(), right = left + first.width(), bottom = top + first.height();
+        for ( const int frame : portraitFrames ) {
+            const auto & sprite = Assets::getImage( icn, frame );
+            left = std::min( left, sprite.x() ); top = std::min( top, sprite.y() );
+            right = std::max( right, sprite.x() + sprite.width() ); bottom = std::max( bottom, sprite.y() + sprite.height() );
