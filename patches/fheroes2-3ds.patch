+void Interface3DS::testChestChoice()
+{
+    using namespace fheroes2;
+    Heroes hero( Heroes::LORDKILBURN, Race::KNGT );
+    const auto experienceBefore = hero.GetExperience();
+    const auto goldBefore = world.GetKingdom( hero.GetColor() ).GetFunds().Get( Resource::GOLD );
+    const auto cropBefore = Platform3DS::viewport();
+    Image frameBefore;
+    Copy( Display::instance(), frameBefore );
+    const std::string header = _( "Treasure Chest" );
+    const std::string body = _( "After scouring the area, you fall upon a hidden treasure cache. You may take the gold or distribute the gold to the peasants for experience. Do you wish to keep the gold?" );
+    const auto controller = []( const int button, const bool pressed ) {
+        SDL_Event event{}; event.type = pressed ? SDL_CONTROLLERBUTTONDOWN : SDL_CONTROLLERBUTTONUP;
+        event.cbutton.button = button; event.cbutton.state = pressed ? SDL_PRESSED : SDL_RELEASED;
+        return event;
+    };
+    const auto touch = []( const Uint32 type, const int x, const int y ) {
+        SDL_Event event{}; event.type = type; event.tfinger.touchId = 1; event.tfinger.fingerId = 0;
+        event.tfinger.x = x / 320.0f; event.tfinger.y = y / 240.0f;
+        return event;
+    };
+    const auto run = [&]( const std::string & text, std::vector<TimedEvent> sequence, const uint32_t gold = 2000, const uint32_t experience = 1500 ) {
+        return runInjectedInput( [&]() { return Dialog::SelectGoldOrExp( header, text, gold, experience, hero ) ? 1 : 0; }, std::move( sequence ) );
+    };
+    Platform3DS::requestCapture();
+    if ( run( body, { { 300, touch( SDL_FINGERDOWN, 80, 218 ) }, { 100, touch( SDL_FINGERUP, 0, 0 ) } } ) != 1 )
+        throw std::runtime_error( "Chest gold tap changed the upstream reward branch" );
+    if ( run( body, { { 300, touch( SDL_FINGERDOWN, 240, 218 ) }, { 100, touch( SDL_FINGERUP, 0, 0 ) } } ) != 0 )
+        throw std::runtime_error( "Chest experience tap changed the upstream reward branch" );
+    if ( run( body, { { 300, controller( SDL_CONTROLLER_BUTTON_DPAD_RIGHT, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_DPAD_RIGHT, false ) },
+                     { 100, controller( SDL_CONTROLLER_BUTTON_A, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_A, false ) } } ) != 0 )
+        throw std::runtime_error( "Chest D-pad selection differs" );
+    if ( run( body, { { 300, controller( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } } ) != 0 )
+        throw std::runtime_error( "Chest Escape no longer chooses experience" );
+    if ( run( body, { { 300, touch( SDL_FINGERDOWN, 80, 218 ) }, { 100, touch( SDL_FINGERMOTION, 160, 190 ) }, { 100, touch( SDL_FINGERUP, 0, 0 ) },
+                     { 100, touch( SDL_FINGERDOWN, 240, 218 ) }, { 100, touch( SDL_FINGERUP, 0, 0 ) } } ) != 0 )
+        throw std::runtime_error( "Chest drag chose gold" );
+    const auto nestedBefore = nestedInformationReturns;
+    if ( run( body, { { 300, touch( SDL_FINGERDOWN, 80, 132 ) }, { 900, touch( SDL_FINGERUP, 0, 0 ) },
+                     { 300, touch( SDL_FINGERDOWN, 240, 218 ) }, { 100, touch( SDL_FINGERUP, 0, 0 ) } } ) != 0
+         || nestedInformationReturns != nestedBefore + 1 ) throw std::runtime_error( "Chest gold information chose a reward or lost the dialog" );
+    const auto experienceInfoBefore = nestedInformationReturns;
+    if ( run( body, { { 300, controller( SDL_CONTROLLER_BUTTON_DPAD_RIGHT, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_DPAD_RIGHT, false ) },
+                     { 100, controller( SDL_CONTROLLER_BUTTON_B, true ) }, { 500, controller( SDL_CONTROLLER_BUTTON_B, false ) },
+                     { 100, controller( SDL_CONTROLLER_BUTTON_A, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_A, false ) } } ) != 0
+         || nestedInformationReturns != experienceInfoBefore + 1 ) throw std::runtime_error( "Chest experience information lost selection" );
+    std::string longText;
+    for ( int i = 0; i < 6; ++i ) longText += body + "\n";
+    if ( run( longText, { { 300, touch( SDL_FINGERDOWN, 160, 80 ) }, { 100, touch( SDL_FINGERMOTION, 160, 25 ) }, { 100, touch( SDL_FINGERUP, 0, 0 ) },
+                         { 100, touch( SDL_FINGERDOWN, 80, 218 ) }, { 100, touch( SDL_FINGERUP, 0, 0 ) } } ) != 1 || lastMessageScroll <= 0 )
+        throw std::runtime_error( "Long chest text hid the gold choice" );
+    if ( hero.GetExperience() != experienceBefore || world.GetKingdom( hero.GetColor() ).GetFunds().Get( Resource::GOLD ) != goldBefore )
+        throw std::runtime_error( "Chest dialog granted a reward instead of leaving it to the caller" );
+    auto & settings = Settings::Get();
+    const auto originalInterface = settings.getInterfaceType();
+    settings.setInterfaceType( InterfaceType::EVIL );
+    if ( run( body, { { 300, controller( SDL_CONTROLLER_BUTTON_START, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_START, false ) } }, 1000, 500 ) != 1 )
+        throw std::runtime_error( "Evil chest primary confirmation differs" );
+    settings.setInterfaceType( originalInterface );
+    if ( Platform3DS::viewport() != cropBefore || std::memcmp( frameBefore.image(), Display::instance().image(), frameBefore.width() * frameBefore.height() ) != 0 )
+        throw std::runtime_error( "Chest changed the game context" );
+    COUT( "3DS CHEST SMOKE: PASS gold experience dpad escape drag_cancel nested_gold nested_experience long_text evil caller_rewards context_restore" )
+}
+void Interface3DS::testLevelUp()
+{
+    using namespace fheroes2;
+    Heroes hero( Heroes::LORDKILBURN, Race::KNGT );
+    hero.LearnSkill( Skill::Secondary( Skill::Secondary::PATHFINDING, Skill::Level::BASIC ) );
+    const Skill::Secondary first( Skill::Secondary::PATHFINDING, Skill::Level::ADVANCED );
+    const Skill::Secondary second( Skill::Secondary::EAGLE_EYE, Skill::Level::EXPERT );
+    const Skill::Secondary none;
+    const auto experience = hero.GetExperience();
+    const auto skillCount = hero.GetSecondarySkills().Count();
+    const auto skillLevels = hero.GetSecondarySkills().GetTotalLevel();
+    const std::array<int, 4> primary{ hero.GetAttack(), hero.GetDefense(), hero.GetPower(), hero.GetKnowledge() };
+    const auto crop = Platform3DS::viewport();
