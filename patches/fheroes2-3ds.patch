+    };
+    const auto information = [&]() {
+        const Monster & monster = variants[variant];
+        std::string body = _( "Attack" ) + std::string( ": " ) + std::to_string( monster.GetAttack() ) + "\n" + _( "Defense" ) + ": "
+                           + std::to_string( monster.GetDefense() ) + "\n" + _( "Damage" ) + ": " + std::to_string( monster.GetDamageMin() ) + " - "
+                           + std::to_string( monster.GetDamageMax() ) + "\n" + _( "Hit Points" ) + ": " + std::to_string( monster.GetHitPoints() ) + "\n" + _( "Speed" )
+                           + ": " + Troop( monster, 1 ).GetSpeedString();
+        for ( const auto & property : getMonsterPropertiesDescription( monster.GetID() ) )
