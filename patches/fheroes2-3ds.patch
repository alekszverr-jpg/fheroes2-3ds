+    stats += "\n" + std::string( _( "Speed" ) ) + ": " + troop.GetSpeedString() + "\n" + _( "Morale" ) + ": " + Morale::String( troop.GetMorale() )
+             + "\n" + _( "Luck" ) + ": " + Luck::String( troop.GetLuck() );
+    const Text statText( stats, FontType::normalWhite() );
