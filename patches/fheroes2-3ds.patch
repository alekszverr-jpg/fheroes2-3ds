+    using namespace fheroes2;
+    using Platform3DS::PanelInputType;
+    using Platform3DS::PanelKey;
+    using TimedEvent = std::pair<Uint32, SDL_Event>;
+    int runInjectedInput( const std::function<int()> & dialog, std::vector<TimedEvent> sequence )
+    {
+        SDL_Thread * worker = SDL_CreateThread( []( void * data ) -> int {
+            auto & steps = *static_cast<std::vector<TimedEvent> *>( data );
+            for ( auto & step : steps ) {
+                SDL_Delay( step.first );
+                if ( SDL_PushEvent( &step.second ) != 1 ) return 1;
+            }
+            return 0;
+        }, "dialog-smoke", &sequence );
+        if ( !worker ) throw std::runtime_error( "Cannot start dialog test input" );
+        int result = 0, status = 0;
+        try { result = dialog(); }
+        catch ( ... ) { SDL_WaitThread( worker, &status ); throw; }
+        SDL_WaitThread( worker, &status );
+        if ( status ) throw std::runtime_error( "Dialog test input injection failed" );
+        auto & events = LocalEvent::Get();
+        events.HandleEvents( false, true );
+        if ( events.MouseClickLeft() || events.isMouseRightButtonPressed() || Platform3DS::hasModalImages() )
+            throw std::runtime_error( "Modal input or image layer leaked after close" );
+        return result;
+    }
+    int lastScroll = 0;
+    std::string lastStats;
+    size_t lastEffects = 0;
+    class CardScope
+    {
+    public:
+        CardScope( const Image & top, const Image * bottom )
+        {
+            Platform3DS::pushModalImages( &top, bottom );
+            Platform3DS::freezeViewportFollow( LocalEvent::Get().getMouseCursorPos(), SDL_GetTicks() );
+            LocalEvent::Get().resetFor3DSPanel();
+        }
+        ~CardScope()
+        {
+            Platform3DS::popModalImages();
+            LocalEvent::Get().resetFor3DSPanel();
+            auto & display = Display::instance();
+            display.updateNextRenderRoi( { 0, 0, display.width(), display.height() } );
+            display.render();
+        }
+    };
+    class Portrait
+    {
+    public:
+        Portrait( const Troop & troop, bool animated ) : _icn( troop.GetMonsterSprite() ), _mirror( troop.isModes( Battle::CAP_MIRRORIMAGE ) )
+        {
+            const AnimationReference reference( troop.GetID() );
+            const auto & standing = reference.getAnimationVector( Monster_Info::STAND_STILL );
+            if ( standing.empty() ) throw std::runtime_error( "Army card has no standing frame" );
+            _frames.assign( 12, standing.front() );
+            if ( animated ) {
+                const auto & idle = reference.getAnimationVector( Monster_Info::IDLE );
+                _frames.insert( _frames.end(), idle.begin(), idle.end() );
+            }
+            const auto & first = Assets::getImage( _icn, _frames.front() );
+            int32_t left = first.x(), top = first.y(), right = left + first.width(), bottom = top + first.height();
+            for ( const int frame : _frames ) {
+                const auto & sprite = Assets::getImage( _icn, frame );
+                left = std::min( left, sprite.x() ); top = std::min( top, sprite.y() );
+                right = std::max( right, sprite.x() + sprite.width() ); bottom = std::max( bottom, sprite.y() + sprite.height() );
+            }
+            _bounds = { left, top, right - left, bottom - top };
+        }
+        void draw( Image & output, const Rect & area, size_t frame, bool reflected ) const
+        {
+            Image icon( _bounds.width, _bounds.height ); icon.reset();
+            Sprite sprite = Assets::getImage( _icn, _frames[frame % _frames.size()] );
+            if ( _mirror ) ApplyPalette( sprite, PAL::GetPalette( PAL::PaletteType::MIRROR_IMAGE ) );
+            Blit( sprite, icon, sprite.x() - _bounds.x, sprite.y() - _bounds.y );
+            const double scale = std::min( double( area.width ) / icon.width(), double( area.height ) / icon.height() );
+            Image resized( std::max( 1, int( icon.width() * scale ) ), std::max( 1, int( icon.height() * scale ) ) );
+            resized.reset(); Resize( icon, resized );
+            Blit( resized, output, area.x + ( area.width - resized.width() ) / 2, area.y + ( area.height - resized.height() ) / 2, reflected );
+        }
+    private:
+        int _icn;
+        bool _mirror;
+        Rect _bounds;
+        std::vector<int> _frames;
+    };
+}
