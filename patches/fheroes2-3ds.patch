+namespace
+{
+    using namespace fheroes2;
+    using Platform3DS::PanelInputType;
+    using Platform3DS::PanelKey;
+    unsigned nestedInformationReturns = 0;
+    int lastMessageScroll = 0;
+
+    bool hasInformation( const DialogElement * element )
+    {
+        return dynamic_cast<const ArtifactDialogElement *>( element ) || dynamic_cast<const ResourceDialogElement *>( element )
+               || dynamic_cast<const SpellDialogElement *>( element ) || dynamic_cast<const LuckDialogElement *>( element )
+               || dynamic_cast<const MoraleDialogElement *>( element ) || dynamic_cast<const ExperienceDialogElement *>( element )
+               || dynamic_cast<const PrimarySkillDialogElement *>( element ) || dynamic_cast<const SecondarySkillDialogElement *>( element );
+    }
+    bool isPassive( const DialogElement * element )
+    {
+        return dynamic_cast<const TextDialogElement *>( element ) || dynamic_cast<const CustomImageDialogElement *>( element )
+               || dynamic_cast<const AnimationDialogElement *>( element ) || dynamic_cast<const CustomAnimationDialogElement *>( element );
+    }
+    class ModalScope
+    {
+    public:
+        ModalScope( const Image & image, const bool information )
+        {
+            // Register before resetting input so an opening pen hold remains captured.
+            Platform3DS::pushModalImages( information ? &image : nullptr, information ? nullptr : &image );
+            Platform3DS::freezeViewportFollow( LocalEvent::Get().getMouseCursorPos(), SDL_GetTicks() );
+            LocalEvent::Get().resetFor3DSPanel();
+        }
+        ~ModalScope()
+        {
+            Platform3DS::popModalImages();
+            LocalEvent::Get().resetFor3DSPanel();
+            auto & display = Display::instance();
+            display.updateNextRenderRoi( { 0, 0, display.width(), display.height() } );
+            display.render();
+        }
+        ModalScope( const ModalScope & ) = delete;
+        ModalScope & operator=( const ModalScope & ) = delete;
+    };
+    struct Answer
+    {
+        int value;
+        std::unique_ptr<ButtonBase> button;
+    };
+    struct ChestChoice
+    {
+        std::array<std::string, 2> labels;
+        std::array<std::string, 2> details;
+    };
+    using TimedEvent = std::pair<Uint32, SDL_Event>;
+    int runInjectedInput( const std::function<int()> & dialog, std::vector<TimedEvent> sequence )
+    {
+        SDL_Thread * worker = SDL_CreateThread( []( void * data ) -> int {
+            auto & steps = *static_cast<std::vector<TimedEvent> *>( data );
+            for ( auto & step : steps ) {
+                SDL_Delay( step.first );
+                if ( SDL_PushEvent( &step.second ) != 1 ) return 1;
+            }
+            return 0;
+        }, "dialog-smoke", &sequence );
+        if ( !worker ) throw std::runtime_error( "Cannot start dialog test input" );
+        int result = 0, status = 0;
+        try { result = dialog(); }
+        catch ( ... ) { SDL_WaitThread( worker, &status ); throw; }
+        SDL_WaitThread( worker, &status );
+        if ( status ) throw std::runtime_error( "Dialog test input injection failed" );
+        auto & events = LocalEvent::Get();
+        events.HandleEvents( false, true );
+        if ( events.MouseClickLeft() || events.isMouseRightButtonPressed() || Platform3DS::hasModalImages() )
+            throw std::runtime_error( "Modal input or image layer leaked after close" );
+        return result;
+    }
+}
+
+bool Interface3DS::supportsMessage( const int buttons, const std::vector<const fheroes2::DialogElement *> & elements )
+{
+    if ( buttons != Dialog::ZERO && buttons != Dialog::OK && buttons != Dialog::CANCEL
+         && buttons != ( Dialog::OK | Dialog::CANCEL ) && buttons != ( Dialog::YES | Dialog::NO ) ) return false;
+    // Custom interactive elements (hotkey editor, monster info, editor selections) retain their original event loops.
+    return std::all_of( elements.begin(), elements.end(), [buttons]( const auto * element ) {
+        return element && element->area().width <= ( buttons ? 296 : 376 )
+               && ( hasInformation( element ) || isPassive( element ) || ( !buttons && dynamic_cast<const fheroes2::MonsterDialogElement *>( element ) ) );
+    } );
+}
+
+static int showNativeMessage( const fheroes2::TextBase & header, const fheroes2::TextBase & body, const int buttons,
+                              const std::vector<const fheroes2::DialogElement *> & elements, const ChestChoice * chest = nullptr )
+{
+    using namespace fheroes2;
+    const bool information = buttons == Dialog::ZERO;
+    const CursorRestorer cursorRestorer( false );
+    Image window( information ? 400 : 320, 240 );
+    const int width = window.width() - 24;
+    const int rewardHeight = chest ? std::max( elements[0]->area().height, elements[1]->area().height ) : 0;
+    const int viewHeight = chest ? std::min( 100, 160 - rewardHeight ) : information ? 204 : 180;
+    const uint8_t background = GetColorId( 35, 29, 24 );
+    const uint8_t border = GetColorId( 150, 115, 63 );
+    const int headerHeight = header.empty() ? 0 : header.height( width ) + 8;
+    int height = headerHeight + ( body.empty() ? 0 : body.height( width ) + 8 );
+    std::vector<Point> offsets( elements.size() );
+    for ( size_t first = 0; !chest && first < elements.size(); ) {
+        size_t last = first;
+        int rowWidth = 0, rowHeight = 0;
+        while ( last < elements.size() ) {
+            const auto size = elements[last]->area();
+            if ( last > first && rowWidth + 10 + size.width > width ) break;
+            rowWidth += ( last > first ? 10 : 0 ) + size.width;
+            rowHeight = std::max( rowHeight, int( size.height ) );
+            ++last;
+        }
+        int x = ( width - rowWidth ) / 2;
+        for ( size_t i = first; i < last; ++i ) {
+            offsets[i] = { x, height + rowHeight - elements[i]->area().height };
+            x += elements[i]->area().width + 10;
+        }
+        height += rowHeight + 10;
+        first = last;
+    }
+    Image content( width, std::max( height, viewHeight ) );
+    content.fill( background );
+    header.draw( 0, 0, width, content );
+    body.draw( 0, headerHeight, width, content );
+    if ( !chest ) for ( size_t i = 0; i < elements.size(); ++i ) elements[i]->draw( content, offsets[i] );
+    else for ( size_t i = 0; i < elements.size(); ++i )
+        offsets[i] = { 80 + int( i ) * 160 - elements[i]->area().width / 2, 8 + viewHeight + 12 };
+
+    std::vector<Answer> answers;
+    const bool evil = Settings::Get().isEvilInterfaceEnabled();
+    if ( buttons & Dialog::YES ) answers.push_back( { Dialog::YES, std::make_unique<Button>( 0, 204, evil ? ICN::BUTTON_SMALL_YES_EVIL : ICN::BUTTON_SMALL_YES_GOOD, 0, 1 ) } );
+    if ( buttons & Dialog::OK ) answers.push_back( { Dialog::OK, std::make_unique<Button>( 0, 204, evil ? ICN::UNIFORM_EVIL_OKAY_BUTTON : ICN::UNIFORM_GOOD_OKAY_BUTTON, 0, 1 ) } );
+    if ( buttons & Dialog::NO ) answers.push_back( { Dialog::NO, std::make_unique<Button>( 0, 204, evil ? ICN::BUTTON_SMALL_NO_EVIL : ICN::BUTTON_SMALL_NO_GOOD, 0, 1 ) } );
+    if ( buttons & Dialog::CANCEL ) answers.push_back( { Dialog::CANCEL, std::make_unique<Button>( 0, 204, evil ? ICN::UNIFORM_EVIL_CANCEL_BUTTON : ICN::UNIFORM_GOOD_CANCEL_BUTTON, 0, 1 ) } );
+    if ( chest ) for ( size_t i = 0; i < answers.size(); ++i ) {
+        Sprite released, pressed;
+        makeButtonSprites( released, pressed, "", { 136, 30 }, evil, evil ? ICN::STONEBAK_EVIL : ICN::STONEBAK );
+        // Use the normal game font: the upstream button font does not contain all translated glyphs on this build.
+        const Text label( chest->labels[i], FontType::normalWhite() );
+        label.draw( 4, ( released.height() - label.height( released.width() - 8 ) ) / 2, released.width() - 8, released );
+        label.draw( 3, ( pressed.height() - label.height( pressed.width() - 8 ) ) / 2 + 1, pressed.width() - 8, pressed );
+        answers[i].button = std::make_unique<ButtonSprite>( 0, 204, std::move( released ), std::move( pressed ) );
+    }
+    for ( size_t i = 0; i < answers.size(); ++i ) {
+        const auto & button = answers[i].button;
+        button->setPosition( ( window.width() * ( 2 * int( i ) + 1 ) / ( 2 * int( answers.size() ) ) ) - button->area().width / 2,
+                             202 + ( 32 - button->area().height ) / 2 );
+    }
+
+    int scroll = 0, selected = 0, pressed = -1;
+    int touchedElement = -1;
+    Point start, last;
+    uint32_t began = 0;
+    bool down = false, moved = false;
+    int result = Dialog::ZERO;
+    bool closed = false;
+    const ModalScope scope( window, information );
+    COUT( "3DS MESSAGE screen=" << ( information ? "top" : "bottom" ) << " content_height=" << height << " buttons=" << buttons << " chest=" << ( chest != nullptr ) )
+    const auto draw = [&]() {
+        window.fill( background );
+        StandardWindow::renderBackgroundImage( window, { 0, 0, window.width(), 240 }, 0, evil );
+        DrawBorder( window, border );
+        Copy( content, 0, scroll, window, 12, 8, width, viewHeight );
+        if ( height > viewHeight ) {
+            const Text hint( "^ " + std::to_string( ( scroll + 31 ) / 32 + 1 ) + "/" + std::to_string( ( height - viewHeight + 31 ) / 32 + 1 ) + " v", FontType::smallYellow() );
+            hint.draw( 0, chest ? 8 + viewHeight + 2 : information ? 224 : 190, window.width(), window );
+        }
+        if ( information ) {
+            if ( height <= viewHeight ) Text( "A / L", FontType::smallWhite() ).draw( 0, 224, window.width(), window );
+        }
+        if ( chest ) for ( size_t i = 0; i < elements.size(); ++i ) {
+            elements[i]->draw( window, offsets[i] );
+            Text( chest->details[i], FontType::smallWhite() ).draw( 12 + int( i ) * 160, 184, 136, window );
+        }
+        for ( size_t i = 0; i < answers.size(); ++i ) {
+            auto & button = answers[i].button;
+            if ( pressed == int( i ) && !moved ) button->press(); else button->release();
+            button->draw( window );
+            if ( int( i ) == selected ) {
+                const auto roi = button->area();
+                Fill( window, roi.x, roi.y + roi.height + 1, roi.width, 2, border );
+            }
+        }
+        Display::instance().render();
+    };
+    const auto buttonAt = [&]( const Point point ) {
+        for ( size_t i = 0; i < answers.size(); ++i ) if ( answers[i].button->area() & point ) return int( i );
+        return -1;
+    };
+    const auto elementAt = [&]( const Point point ) {
+        if ( chest ) {
+            for ( size_t i = 0; i < elements.size(); ++i ) {
+                const Rect roi{ offsets[i].x, offsets[i].y, elements[i]->area().width, elements[i]->area().height };
+                if ( roi & point ) return int( i );
+            }
+            return -1;
+        }
+        if ( point.y < 8 || point.y >= 8 + viewHeight ) return -1;
+        for ( size_t i = 0; i < elements.size(); ++i ) {
+            const Rect roi{ 12 + offsets[i].x, 8 + offsets[i].y - scroll, elements[i]->area().width, elements[i]->area().height };
+            if ( roi & point ) return int( i );
+        }
+        return -1;
+    };
+    const auto showInformation = [&]() {
+        if ( touchedElement >= 0 && hasInformation( elements[touchedElement] ) ) {
+            const Image * lowerDialog = Platform3DS::modalBottomImage();
+            if ( Platform3DS::smokeTest() ) Platform3DS::requestCapture();
+            elements[touchedElement]->showPopup( Dialog::ZERO );
+            if ( lowerDialog && Platform3DS::modalBottomImage() == lowerDialog ) ++nestedInformationReturns;
+            down = false; pressed = -1;
+        }
+    };
+    draw();
+    auto & events = LocalEvent::Get();
+    while ( !closed && events.HandleEvents() ) {
+        Platform3DS::PanelInput input;
+        while ( !closed && Platform3DS::consumePanelInput( input ) ) {
+            if ( input.type == PanelInputType::KeyUp ) {
+                if ( information && input.key == PanelKey::Information ) closed = true;
+            }
+            else if ( input.type == PanelInputType::Key ) {
+                switch ( input.key ) {
+                case PanelKey::Up: scroll -= 32; break;
+                case PanelKey::Down: scroll += 32; break;
+                case PanelKey::Left: if ( !answers.empty() ) selected = ( selected + int( answers.size() ) - 1 ) % answers.size(); break;
+                case PanelKey::Right: if ( !answers.empty() ) selected = ( selected + 1 ) % answers.size(); break;
+                case PanelKey::Confirm: if ( !answers.empty() ) result = answers[selected].value; closed = true; break;
+                case PanelKey::Cancel:
+                    if ( information ) closed = true;
+                    else if ( answers.size() == 1 ) { result = answers.front().value; closed = true; }
+                    else for ( const auto & answer : answers ) if ( answer.value == Dialog::NO || answer.value == Dialog::CANCEL ) { result = answer.value; closed = true; }
+                    break;
+                case PanelKey::Information:
+                    if ( chest && !down ) touchedElement = selected;
+                    if ( information ) closed = true; else showInformation();
+                    break;
+                }
+            }
+            else if ( input.type == PanelInputType::TouchDown ) {
+                start = last = input.position; began = SDL_GetTicks(); down = true; moved = false;
+                pressed = buttonAt( last ); touchedElement = elementAt( last );
+                if ( pressed >= 0 ) selected = pressed;
+            }
+            else if ( input.type == PanelInputType::TouchMove && down ) {
+                if ( std::abs( input.position.x - start.x ) >= 10 || std::abs( input.position.y - start.y ) >= 10 ) moved = true;
+                if ( moved && pressed < 0 && ( !chest || start.y < 8 + viewHeight ) ) scroll += last.y - input.position.y;
+                last = input.position;
+            }
+            else if ( input.type == PanelInputType::TouchUp ) {
+                if ( information && !moved ) closed = true;
+                else if ( down && !moved && pressed >= 0 && buttonAt( last ) == pressed ) { result = answers[pressed].value; closed = true; }
+                down = false; pressed = -1;
+            }
+            scroll = std::clamp( scroll, 0, std::max( 0, height - viewHeight ) );
+        }
+        if ( !information && down && !moved && pressed < 0 && SDL_GetTicks() - began >= 550 ) {
+            showInformation();
+            // Passive elements have no popup. Do not repeatedly attempt to open one.
+            touchedElement = -1;
+        }
+        if ( !chest ) for ( size_t i = 0; i < elements.size(); ++i ) elements[i]->update( content, offsets[i] );
+        if ( !closed ) draw();
+    }
+    lastMessageScroll = scroll;
+    COUT( "3DS MESSAGE CLOSED result=" << result << " scroll=" << scroll )
+    return result;
+}
+
+int Interface3DS::showMessage( const fheroes2::TextBase & header, const fheroes2::TextBase & body, const int buttons,
+                              const std::vector<const fheroes2::DialogElement *> & elements )
+{
+    return showNativeMessage( header, body, buttons, elements );
+}
+
+bool Interface3DS::showChestChoice( const std::string & header, const std::string & body, const uint32_t gold, const uint32_t experience,
+                                   const uint32_t totalGold, const uint32_t experienceNeeded )
+{
+    using namespace fheroes2;
+    const ResourceDialogElement goldElement( Resource::GOLD, std::to_string( gold ) );
+    const ExperienceDialogElement experienceElement( experience );
+    const ChestChoice chest{ { _( "Gold" ), _( "Experience" ) },
+                             { _( "Total: " ) + std::to_string( totalGold ), _( "Need: " ) + std::to_string( experienceNeeded ) } };
+    const int result = showNativeMessage( Text( header, FontType::normalYellow() ), Text( body, FontType::normalWhite() ),
+                                         Dialog::YES | Dialog::NO, { &goldElement, &experienceElement }, &chest );
+    // The caller grants rewards: true keeps the gold; false gives the peasants the gold for experience.
+    return result == Dialog::YES;
+}
+
+void Interface3DS::testNativeMessages()
+{
+    using namespace fheroes2;
+    using TimedEvent = std::pair<Uint32, SDL_Event>;
+    auto & events = LocalEvent::Get();
+    const auto controller = []( const int button, const bool pressed ) {
+        SDL_Event event{};
+        event.type = pressed ? SDL_CONTROLLERBUTTONDOWN : SDL_CONTROLLERBUTTONUP;
+        event.cbutton.button = button; event.cbutton.state = pressed ? SDL_PRESSED : SDL_RELEASED;
+        return event;
+    };
+    const auto touch = []( const Uint32 type, const int x, const int y ) {
+        SDL_Event event{}; event.type = type; event.tfinger.touchId = 1; event.tfinger.fingerId = 0;
+        event.tfinger.x = x / 320.0f; event.tfinger.y = y / 240.0f;
+        return event;
+    };
+    const auto run = [&]( const TextBase & title, const TextBase & text, const int buttons, const std::vector<const DialogElement *> & elements,
+                          std::vector<TimedEvent> sequence ) {
+        return runInjectedInput( [&]() { return fheroes2::showMessage( title, text, buttons, elements ); }, std::move( sequence ) );
+    };
+    const Text title( _( "Next Hero" ), FontType::normalYellow() );
+    const Text text( _( "Select the next Hero." ), FontType::normalWhite() );
+    Image strip( 320, 40 ); strip.fill( GetColorId( 60, 40, 20 ) );
+    const Image * previousStrip = Platform3DS::commandStripImage();
+    Platform3DS::setCommandStripImage( &strip );
+    const auto crop = Platform3DS::viewport();
+    Image savedDisplay;
+    Copy( Display::instance(), savedDisplay );
+    Platform3DS::requestCapture();
+    if ( run( title, text, Dialog::ZERO, {}, { { 300, controller( SDL_CONTROLLER_BUTTON_B, false ) } } ) != Dialog::ZERO )
+        throw std::runtime_error( "Information requested a game answer" );
+    if ( Platform3DS::viewport() != crop || Platform3DS::commandStripImage() != &strip )
+        throw std::runtime_error( "Information changed viewport or strip state" );
+    Platform3DS::setCommandStripImage( previousStrip );
+    // At the bottom edge, suspending the 200px strip must not discard the saved y=280 crop.
+    Platform3DS::setCommandStripImage( &strip );
+    Platform3DS::resetViewportFollow();
+    Platform3DS::followCursor( { 799, 479 }, SDL_GetTicks(), false );
+    const auto edgeCrop = Platform3DS::viewport();
+    if ( edgeCrop.y != 280 ) throw std::runtime_error( "Bottom-edge test did not reach strip limit" );
+    Platform3DS::setCommandStripImage( nullptr );
+    run( title, text, Dialog::ZERO, {}, { { 300, controller( SDL_CONTROLLER_BUTTON_B, false ) } } );
+    if ( Platform3DS::viewport() != edgeCrop ) throw std::runtime_error( "Information discarded the suspended strip viewport" );
+    Platform3DS::setCommandStripImage( previousStrip );
+    Platform3DS::requestCapture();
+    if ( run( title, text, Dialog::OK, {}, { { 300, controller( SDL_CONTROLLER_BUTTON_START, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_START, false ) } } ) != Dialog::OK )
+        throw std::runtime_error( "OK confirmation differs" );
+    if ( run( title, text, Dialog::YES | Dialog::NO, {}, { { 300, touch( SDL_FINGERDOWN, 240, 218 ) }, { 100, touch( SDL_FINGERUP, 0, 0 ) } } ) != Dialog::NO )
+        throw std::runtime_error( "Native touchscreen NO selection differs" );
+    if ( run( title, text, Dialog::OK | Dialog::CANCEL, {}, {
+             { 300, touch( SDL_FINGERDOWN, 80, 218 ) }, { 100, touch( SDL_FINGERMOTION, 160, 170 ) }, { 100, touch( SDL_FINGERUP, 0, 0 ) },
+             { 200, controller( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } } ) != Dialog::CANCEL )
+        throw std::runtime_error( "Dragging out of a dialog button activated it" );
+    // Start in R+Start must switch rendering, never confirm the active dialog.
+    if ( run( title, text, Dialog::OK | Dialog::CANCEL, {}, {
+             { 200, controller( SDL_CONTROLLER_BUTTON_RIGHTSHOULDER, true ) },
+             { 100, controller( SDL_CONTROLLER_BUTTON_START, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_RIGHTSHOULDER, false ) },
+             { 100, controller( SDL_CONTROLLER_BUTTON_START, false ) },
+             { 100, controller( SDL_CONTROLLER_BUTTON_RIGHTSHOULDER, true ) },
+             { 100, controller( SDL_CONTROLLER_BUTTON_START, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_START, false ) },
+             { 100, controller( SDL_CONTROLLER_BUTTON_RIGHTSHOULDER, false ) },
+             { 200, controller( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } } ) != Dialog::CANCEL
+         || !Platform3DS::highResolutionEnabled() ) throw std::runtime_error( "Display chord answered a dialog or failed to restore wide mode" );
+    std::string longBody;
+    for ( int i = 0; i < 24; ++i ) longBody += text.text() + "\n";
+    if ( run( title, Text( longBody, FontType::normalWhite() ), Dialog::OK, {}, {
+             { 300, touch( SDL_FINGERDOWN, 160, 150 ) }, { 100, touch( SDL_FINGERMOTION, 160, 40 ) }, { 100, touch( SDL_FINGERUP, 0, 0 ) },
+             { 200, controller( SDL_CONTROLLER_BUTTON_START, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_START, false ) } } ) != Dialog::OK || lastMessageScroll <= 0 )
+        throw std::runtime_error( "Long text did not scroll with fixed confirmation" );
+    const auto nestedBefore = nestedInformationReturns;
+    if ( run( title, Text( longBody, FontType::normalWhite() ), Dialog::ZERO, {}, {
+             { 300, controller( SDL_CONTROLLER_BUTTON_DPAD_DOWN, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_DPAD_DOWN, false ) },
+             { 100, controller( SDL_CONTROLLER_BUTTON_DPAD_DOWN, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_DPAD_DOWN, false ) },
+             { 100, controller( SDL_CONTROLLER_BUTTON_A, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_A, false ) } } ) != Dialog::ZERO || lastMessageScroll <= 0 )
+        throw std::runtime_error( "Long top information did not scroll" );
+    const ResourceDialogElement gold( Resource::GOLD, "200" );
+    if ( run( Text{}, Text{}, Dialog::YES | Dialog::NO, { &gold }, {
+             { 300, touch( SDL_FINGERDOWN, 160, 24 ) }, { 900, touch( SDL_FINGERUP, 0, 0 ) },
+             { 300, controller( SDL_CONTROLLER_BUTTON_START, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_START, false ) } } ) != Dialog::YES
+         || nestedInformationReturns != nestedBefore + 1 ) throw std::runtime_error( "Nested information lost the lower dialog or selected an answer" );
+    if ( std::memcmp( savedDisplay.image(), Display::instance().image(), savedDisplay.width() * savedDisplay.height() ) != 0 )
+        throw std::runtime_error( "Native dialogs modified the game frame" );
+    Platform3DS::setCommandStripImage( previousStrip );
+    events.resetFor3DSPanel();
+    COUT( "3DS NATIVE MESSAGES SMOKE: PASS top_info bottom_ok native_touch_no drag_cancel long_scroll nested_info release_isolation" )
+}
+
+void Interface3DS::testChestChoice()
+{
+    using namespace fheroes2;
+    Heroes hero( Heroes::LORDKILBURN, Race::KNGT );
+    const auto experienceBefore = hero.GetExperience();
+    const auto goldBefore = world.GetKingdom( hero.GetColor() ).GetFunds().Get( Resource::GOLD );
+    const auto cropBefore = Platform3DS::viewport();
+    Image frameBefore;
+    Copy( Display::instance(), frameBefore );
+    const std::string header = _( "Treasure Chest" );
+    const std::string body = _( "After scouring the area, you fall upon a hidden treasure cache. You may take the gold or distribute the gold to the peasants for experience. Do you wish to keep the gold?" );
+    const auto controller = []( const int button, const bool pressed ) {
+        SDL_Event event{}; event.type = pressed ? SDL_CONTROLLERBUTTONDOWN : SDL_CONTROLLERBUTTONUP;
+        event.cbutton.button = button; event.cbutton.state = pressed ? SDL_PRESSED : SDL_RELEASED;
+        return event;
+    };
+    const auto touch = []( const Uint32 type, const int x, const int y ) {
+        SDL_Event event{}; event.type = type; event.tfinger.touchId = 1; event.tfinger.fingerId = 0;
+        event.tfinger.x = x / 320.0f; event.tfinger.y = y / 240.0f;
+        return event;
+    };
+    const auto run = [&]( const std::string & text, std::vector<TimedEvent> sequence, const uint32_t gold = 2000, const uint32_t experience = 1500 ) {
+        return runInjectedInput( [&]() { return Dialog::SelectGoldOrExp( header, text, gold, experience, hero ) ? 1 : 0; }, std::move( sequence ) );
+    };
+    Platform3DS::requestCapture();
+    if ( run( body, { { 300, touch( SDL_FINGERDOWN, 80, 218 ) }, { 100, touch( SDL_FINGERUP, 0, 0 ) } } ) != 1 )
+        throw std::runtime_error( "Chest gold tap changed the upstream reward branch" );
+    if ( run( body, { { 300, touch( SDL_FINGERDOWN, 240, 218 ) }, { 100, touch( SDL_FINGERUP, 0, 0 ) } } ) != 0 )
+        throw std::runtime_error( "Chest experience tap changed the upstream reward branch" );
+    if ( run( body, { { 300, controller( SDL_CONTROLLER_BUTTON_DPAD_RIGHT, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_DPAD_RIGHT, false ) },
+                     { 100, controller( SDL_CONTROLLER_BUTTON_A, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_A, false ) } } ) != 0 )
+        throw std::runtime_error( "Chest D-pad selection differs" );
+    if ( run( body, { { 300, controller( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } } ) != 0 )
+        throw std::runtime_error( "Chest Escape no longer chooses experience" );
+    if ( run( body, { { 300, touch( SDL_FINGERDOWN, 80, 218 ) }, { 100, touch( SDL_FINGERMOTION, 160, 190 ) }, { 100, touch( SDL_FINGERUP, 0, 0 ) },
+                     { 100, touch( SDL_FINGERDOWN, 240, 218 ) }, { 100, touch( SDL_FINGERUP, 0, 0 ) } } ) != 0 )
+        throw std::runtime_error( "Chest drag chose gold" );
+    const auto nestedBefore = nestedInformationReturns;
+    if ( run( body, { { 300, touch( SDL_FINGERDOWN, 80, 132 ) }, { 900, touch( SDL_FINGERUP, 0, 0 ) },
+                     { 300, touch( SDL_FINGERDOWN, 240, 218 ) }, { 100, touch( SDL_FINGERUP, 0, 0 ) } } ) != 0
+         || nestedInformationReturns != nestedBefore + 1 ) throw std::runtime_error( "Chest gold information chose a reward or lost the dialog" );
+    const auto experienceInfoBefore = nestedInformationReturns;
+    if ( run( body, { { 300, controller( SDL_CONTROLLER_BUTTON_DPAD_RIGHT, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_DPAD_RIGHT, false ) },
+                     { 100, controller( SDL_CONTROLLER_BUTTON_B, true ) }, { 500, controller( SDL_CONTROLLER_BUTTON_B, false ) },
+                     { 100, controller( SDL_CONTROLLER_BUTTON_A, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_A, false ) } } ) != 0
+         || nestedInformationReturns != experienceInfoBefore + 1 ) throw std::runtime_error( "Chest experience information lost selection" );
+    std::string longText;
+    for ( int i = 0; i < 6; ++i ) longText += body + "\n";
+    if ( run( longText, { { 300, touch( SDL_FINGERDOWN, 160, 80 ) }, { 100, touch( SDL_FINGERMOTION, 160, 25 ) }, { 100, touch( SDL_FINGERUP, 0, 0 ) },
+                         { 100, touch( SDL_FINGERDOWN, 80, 218 ) }, { 100, touch( SDL_FINGERUP, 0, 0 ) } } ) != 1 || lastMessageScroll <= 0 )
+        throw std::runtime_error( "Long chest text hid the gold choice" );
+    if ( hero.GetExperience() != experienceBefore || world.GetKingdom( hero.GetColor() ).GetFunds().Get( Resource::GOLD ) != goldBefore )
+        throw std::runtime_error( "Chest dialog granted a reward instead of leaving it to the caller" );
+    auto & settings = Settings::Get();
+    const auto originalInterface = settings.getInterfaceType();
+    settings.setInterfaceType( InterfaceType::EVIL );
+    if ( run( body, { { 300, controller( SDL_CONTROLLER_BUTTON_START, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_START, false ) } }, 1000, 500 ) != 1 )
+        throw std::runtime_error( "Evil chest primary confirmation differs" );
+    settings.setInterfaceType( originalInterface );
+    if ( Platform3DS::viewport() != cropBefore || std::memcmp( frameBefore.image(), Display::instance().image(), frameBefore.width() * frameBefore.height() ) != 0 )
+        throw std::runtime_error( "Chest changed the game context" );
+    COUT( "3DS CHEST SMOKE: PASS gold experience dpad escape drag_cancel nested_gold nested_experience long_text evil caller_rewards context_restore" )
+}
