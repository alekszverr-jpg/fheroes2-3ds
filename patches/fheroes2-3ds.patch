+        panelInputs.clear();
+    }
+    bool hasModalImages() { return !modalImages.empty(); }
+    const fheroes2::Image * modalTopImage()
+    {
+        for ( auto layer = modalImages.rbegin(); layer != modalImages.rend(); ++layer ) if ( layer->top ) return layer->top;
+        return nullptr;
+    }
+    const fheroes2::Image * modalBottomImage()
+    {
+        for ( auto layer = modalImages.rbegin(); layer != modalImages.rend(); ++layer ) if ( layer->bottom ) return layer->bottom;
+        return nullptr;
+    }
+    bool handleModalTouch( const PanelInputType type, const float x, const float y )
+    {
+        if ( !hasModalImages() && !modalTouchCaptured ) return false;
+        if ( hasModalImages() ) {
