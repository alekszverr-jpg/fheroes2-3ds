+        { Battle::SP_STONESKIN, Spell::STONESKIN }, { Battle::SP_DRAGONSLAYER, Spell::DRAGONSLAYER }, { Battle::SP_STEELSKIN, Spell::STEELSKIN },
+        { Battle::SP_ANTIMAGIC, Spell::ANTIMAGIC }, { Battle::SP_CURSE, Spell::CURSE }, { Battle::SP_SLOW, Spell::SLOW },
+        { Battle::SP_BERSERKER, Spell::BERSERKER }, { Battle::SP_HYPNOTIZE, Spell::HYPNOTIZE }, { Battle::SP_BLIND, Spell::BLIND },
+        { Battle::SP_PARALYZE, Spell::PARALYZE }, { Battle::SP_STONE, Spell::PETRIFY } };
+    if ( troop.isBattle() ) for ( const auto & mode : modes ) if ( troop.isModes( mode.first ) ) {
+        const Spell spell( mode.second ); const uint32_t duration = troop.GetAffectedDuration( mode.first );
+        properties += std::string( spell.GetName() ) + ( duration ? " (" + std::to_string( duration ) + ")" : "" ) + "\n" + getSpellDescription( spell, nullptr ) + "\n\n";
+        ++effectCount;
+    }
+    while ( !properties.empty() && properties.back() == '\n' ) properties.pop_back();
+    const Text description( properties, FontType::normalWhite() );
+    std::vector<std::unique_ptr<ResourceDialogElement>> resources;
+    int resourceRowHeight = 0;
+    if ( interactive && ( flags & Dialog::UPGRADE ) ) {
+        const Funds cost = troop.GetTotalUpgradeCost();
+        for ( int resource : { Resource::GOLD, Resource::WOOD, Resource::MERCURY, Resource::ORE, Resource::SULFUR, Resource::CRYSTAL, Resource::GEMS } ) {
+            if ( !cost.Get( resource ) ) continue;
+            resources.emplace_back( std::make_unique<ResourceDialogElement>( resource, std::to_string( cost.Get( resource ) ) ) );
+            resourceRowHeight = std::max<int32_t>( resourceRowHeight, resources.back()->area().height + 4 );
+        }
+    }
+    const int costBottom = resources.empty() ? 0 : 128 + int( ( resources.size() + 1 ) / 2 ) * resourceRowHeight;
+    int descriptionY = std::max( statHeight, costBottom ) + 8;
+    if ( descriptionY < 188 && descriptionY + Text( "A", FontType::normalWhite() ).height() > 188 ) descriptionY = 188;
+    const int height = properties.empty() ? std::max( statHeight, costBottom ) : descriptionY + description.height( 376 );
+    Image contentBase( 376, std::max( height, 188 ) ); contentBase.fill( background );
+    statText.draw( 144, 4, 232, contentBase ); description.draw( 0, descriptionY, 376, contentBase );
+    if ( !resources.empty() ) {
+        Text( _( "Upgrade" ), FontType::normalYellow() ).draw( 0, 108, 132, contentBase );
+        for ( size_t i = 0; i < resources.size(); ++i ) {
+            const int columns = resources.size() == 1 ? 1 : 2, width = 132 / columns;
+            resources[i]->draw( contentBase, { int( i % columns ) * width + ( width - resources[i]->area().width ) / 2,
+                                               128 + int( i / columns ) * resourceRowHeight } );
+        }
+    }
+    Image content;
+    const Portrait portrait( troop, interactive );
+    const Rect portraitArea{ 0, 4, 132, resources.empty() ? 146 : 100 };
+    std::vector<int> actions;
+    if ( interactive && ( flags & Dialog::UPGRADE ) ) actions.push_back( Dialog::UPGRADE );
+    if ( interactive && ( flags & Dialog::DISMISS ) ) actions.push_back( Dialog::DISMISS );
+    if ( interactive ) actions.push_back( Dialog::CANCEL );
+    std::vector<std::unique_ptr<ButtonBase>> buttons;
+    for ( size_t i = 0; i < actions.size(); ++i ) {
+        Sprite released, pressed;
+        makeButtonSprites( released, pressed, "", { 284, 22 }, evil, evil ? ICN::STONEBAK_EVIL : ICN::STONEBAK );
+        const Text text( actions[i] == Dialog::UPGRADE ? _( "Upgrade" ) : actions[i] == Dialog::DISMISS ? _( "Dismiss" ) : _( "Exit" ), FontType::normalWhite() );
+        text.draw( 4, ( released.height() - text.height() ) / 2, released.width() - 8, released );
+        text.draw( 3, ( pressed.height() - text.height() ) / 2 + 1, pressed.width() - 8, pressed );
+        const int x = ( 320 - released.width() ) / 2;
+        buttons.emplace_back( std::make_unique<ButtonSprite>( x, 206 - int( actions.size() - 1 - i ) * 32, std::move( released ), std::move( pressed ) ) );
