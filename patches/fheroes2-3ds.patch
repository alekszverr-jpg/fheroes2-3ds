+    auto scrolledHold = std::vector<TimedEvent>{}; for ( int i = 0; i < 4; ++i ) press( scrolledHold, SDL_CONTROLLER_BUTTON_DPAD_DOWN );
+    scrolledHold.insert( scrolledHold.end(), held.begin(), held.end() ); const auto heldAfterScroll = nestedInformationReturns;
+    if ( run( item.GetName(), longText, { &artifact }, scrolledHold ) != Dialog::OK || nestedInformationReturns != heldAfterScroll + 1 ) throw std::runtime_error( "Text scrolling moved the fixed artifact hit target" );
