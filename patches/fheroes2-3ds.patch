+        Image icon( portraitBounds.width, portraitBounds.height );
+        icon.reset();
+        Blit( creature, icon, creature.x() - portraitBounds.x, creature.y() - portraitBounds.y );
+        const double scale = std::min( double( portraitArea.width ) / icon.width(), double( portraitArea.height ) / icon.height() );
+        const int iconWidth = std::max( 1, int( icon.width() * scale ) ), iconHeight = std::max( 1, int( icon.height() * scale ) );
+        Image scaledIcon( iconWidth, iconHeight );
+        scaledIcon.reset();
+        Resize( icon, scaledIcon );
+        Blit( scaledIcon, window, portraitArea.x + ( portraitArea.width - iconWidth ) / 2, portraitArea.y + ( portraitArea.height - iconHeight ) / 2 );
+        Blit( costCard, window, 156, 38 );
+        addGradientShadow( costCard, window, { 156, 38 }, { -3, 3 } );
+        const Monster & monster = variants[variant];
+        Text( monster.GetMultiName(), FontType::normalYellow() ).draw( 24, 24, 352, upperWindow );
+        Text( _( "Attack" ) + std::string( ": " ) + std::to_string( monster.GetAttack() ) + "\n" + _( "Defense" ) + ": " + std::to_string( monster.GetDefense() ), FontType::normalWhite() ).draw( 24, 56, 176, upperWindow );
+        Text( _( "Damage" ) + std::string( ": " ) + std::to_string( monster.GetDamageMin() ) + " - " + std::to_string( monster.GetDamageMax() ) + "\n" + _( "Hit Points" ) + ": " + std::to_string( monster.GetHitPoints() ), FontType::normalWhite() ).draw( 200, 56, 176, upperWindow );
+        Text( _( "Resource cost:" ), FontType::normalYellow() ).draw( 24, 110, 352, upperWindow );
