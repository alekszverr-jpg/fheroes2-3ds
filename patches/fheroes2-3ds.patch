+    if ( classicFrame ) {
+        if ( classicChoice || ( classicIllustrated && textHeight > 0 ) ) upperWindow = Interface3DS::makeClassicPanelBackground( 400, evil );
+        chestBackground = Interface3DS::makeClassicPanelBackground( 320, evil );
+    }
+    std::array<Image, 2> rewardImages;
+    if ( classicChoice ) for ( size_t i = 0; i < elements.size(); ++i ) {
+        Image skillImage;
+        const Image * original = nullptr;
