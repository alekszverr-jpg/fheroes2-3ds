 void Dialog::Marketplace( Kingdom & kingdom, bool fromTradingPost )
 {
+#if defined( __3DS__ )
+    // The native panel selects a trade. Resource mutations stay in this game dialog.
+    COUT( "3DS marketplace: prepare players" )
+    const auto & players = Settings::Get().GetPlayers();
+    const bool gift = std::count_if( players.begin(), players.end(), []( const Player * player ) {
+        return player && world.GetKingdom( player->GetColor() ).isPlay();
+    } ) >= 2;
+    while ( true ) {
+        const uint32_t markets = fromTradingPost ? 3 : kingdom.GetCountMarketplace();
+        COUT( "3DS marketplace: opening panel markets=" << markets )
+        const auto choice = Interface3DS::showMarketplace( kingdom.GetFunds(), markets, fromTradingPost, gift );
+        if ( choice.action == Interface3DS::MarketChoice::Action::Close ) return;
+        if ( choice.action == Interface3DS::MarketChoice::Action::Gift ) {
+            if ( gift ) Dialog::MakeGiftResource( kingdom );
+            continue;
+        }
+        const uint32_t cost = GetTradeCosts( kingdom, choice.from, choice.to, fromTradingPost );
+        if ( !cost || !choice.units ) continue;
+        const uint64_t sell = uint64_t( choice.units ) * ( choice.to == Resource::GOLD ? 1 : cost );
+        const uint64_t buy = uint64_t( choice.units ) * ( choice.to == Resource::GOLD ? cost : 1 );
+        const auto funds = kingdom.GetFunds();
+        if ( sell > uint64_t( std::max<int32_t>( 0, funds.Get( choice.from ) ) )
+             || buy > uint64_t( std::numeric_limits<int32_t>::max() - std::max<int32_t>( 0, funds.Get( choice.to ) ) ) ) continue;
+        kingdom.OddFundsResource( Funds( choice.from, static_cast<uint32_t>( sell ) ) );
+        kingdom.AddFundsResource( Funds( choice.to, static_cast<uint32_t>( buy ) ) );
+    }
+#endif
     fheroes2::Display & display = fheroes2::Display::instance();
 
     const bool isEvilInterface = Settings::Get().isEvilInterfaceEnabled();
