+        areas.push_back( buttons.back()->area() );
+    }
+    const Rect slider( 12, 189, 296, 12 );
+    GiftChoice choice; int selected = 0, focus = 0, pressed = -1;
+    bool down = false, moved = false, sliding = false, closed = false; Point start;
+    const MarketScope scope( top, bottom );
+    const auto maximum = [&]() -> int32_t {
+        const int recipients = Color::Count( choice.recipients );
+        return recipients ? std::max<int32_t>( 0, funds.Get( resources[selected] ) ) / recipients : 0;
+    };
+    const auto enabled = [&]( int index ) {
+        if ( index < buttonStart ) return true;
