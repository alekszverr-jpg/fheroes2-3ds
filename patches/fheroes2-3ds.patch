+int Interface3DS::showArmyInfo( const Troop & troop, const int flags, const bool reflected )
+{
+    using namespace fheroes2;
+    const bool interactive = ( flags & Dialog::BUTTONS ) != 0;
+    const CursorRestorer cursorRestorer( false );
+    const bool evil = Settings::Get().isEvilInterfaceEnabled();
+    const uint8_t background = GetColorId( 35, 29, 24 ), border = GetColorId( 150, 115, 63 );
+    Image top( 400, 240 ), bottom( 320, 240 );
+    std::string stats = _( "Attack Skill" ) + std::string( ": " ) + troop.GetAttackString() + "\n" + _( "Defense Skill" ) + ": " + troop.GetDefenseString();
+    if ( getMonsterData( troop.GetID() ).battleStats.shots > 0 )
+        stats += "\n" + std::string( troop.isBattle() ? _( "Shots Left" ) : _( "Shots" ) ) + ": " + troop.GetShotString();
+    const Monster monster = troop.GetMonster();
+    stats += "\n" + std::string( _( "Damage" ) ) + ": " + std::to_string( monster.GetDamageMin() ) + " - " + std::to_string( monster.GetDamageMax() );
+    stats += "\n" + std::string( _( "Hit Points" ) ) + ": " + std::to_string( monster.GetHitPoints() );
+    if ( troop.isBattle() && troop.GetCount() ) stats += "\n" + std::string( _( "Hit Points Left" ) ) + ": " + std::to_string( troop.GetHitPointsLeft() );
+    stats += "\n" + std::string( _( "Speed" ) ) + ": " + troop.GetSpeedString() + "\n" + _( "Morale" ) + ": " + Morale::String( troop.GetMorale() )
+             + "\n" + _( "Luck" ) + ": " + Luck::String( troop.GetLuck() );
+    const Text statText( stats, FontType::normalWhite() );
+    const int statHeight = std::max<int32_t>( 154, statText.height( 232 ) + 8 );
+    std::string properties;
+    for ( const auto & description : getMonsterPropertiesDescription( troop.GetID() ) ) properties += description + "\n\n";
+    size_t effectCount = 0;
+    const std::array<std::pair<uint32_t, int>, 15> modes{ std::pair<uint32_t,int>{ Battle::SP_BLOODLUST, Spell::BLOODLUST },
+        { Battle::SP_BLESS, Spell::BLESS }, { Battle::SP_HASTE, Spell::HASTE }, { Battle::SP_SHIELD, Spell::SHIELD },
+        { Battle::SP_STONESKIN, Spell::STONESKIN }, { Battle::SP_DRAGONSLAYER, Spell::DRAGONSLAYER }, { Battle::SP_STEELSKIN, Spell::STEELSKIN },
+        { Battle::SP_ANTIMAGIC, Spell::ANTIMAGIC }, { Battle::SP_CURSE, Spell::CURSE }, { Battle::SP_SLOW, Spell::SLOW },
+        { Battle::SP_BERSERKER, Spell::BERSERKER }, { Battle::SP_HYPNOTIZE, Spell::HYPNOTIZE }, { Battle::SP_BLIND, Spell::BLIND },
+        { Battle::SP_PARALYZE, Spell::PARALYZE }, { Battle::SP_STONE, Spell::PETRIFY } };
+    if ( troop.isBattle() ) for ( const auto & mode : modes ) if ( troop.isModes( mode.first ) ) {
+        const Spell spell( mode.second ); const uint32_t duration = troop.GetAffectedDuration( mode.first );
+        properties += std::string( spell.GetName() ) + ( duration ? " (" + std::to_string( duration ) + ")" : "" ) + "\n" + getSpellDescription( spell, nullptr ) + "\n\n";
+        ++effectCount;
+    }
+    while ( !properties.empty() && properties.back() == '\n' ) properties.pop_back();
+    const Text description( properties, FontType::normalWhite() );
+    std::vector<std::unique_ptr<ResourceDialogElement>> resources;
+    int resourceRowHeight = 0;
+    if ( interactive && ( flags & Dialog::UPGRADE ) ) {
+        const Funds cost = troop.GetTotalUpgradeCost();
+        for ( int resource : { Resource::GOLD, Resource::WOOD, Resource::MERCURY, Resource::ORE, Resource::SULFUR, Resource::CRYSTAL, Resource::GEMS } ) {
+            if ( !cost.Get( resource ) ) continue;
+            resources.emplace_back( std::make_unique<ResourceDialogElement>( resource, std::to_string( cost.Get( resource ) ) ) );
+            resourceRowHeight = std::max<int32_t>( resourceRowHeight, resources.back()->area().height + 4 );
+        }
+    }
+    const int costBottom = resources.empty() ? 0 : 128 + int( ( resources.size() + 1 ) / 2 ) * resourceRowHeight;
+    int descriptionY = std::max( statHeight, costBottom ) + 8;
+    if ( descriptionY < 188 && descriptionY + Text( "A", FontType::normalWhite() ).height() > 188 ) descriptionY = 188;
+    const int height = properties.empty() ? std::max( statHeight, costBottom ) : descriptionY + description.height( 376 );
+    Image contentBase( 376, std::max( height, 188 ) ); contentBase.fill( background );
+    statText.draw( 144, 4, 232, contentBase ); description.draw( 0, descriptionY, 376, contentBase );
+    if ( !resources.empty() ) {
+        Text( _( "Upgrade" ), FontType::normalYellow() ).draw( 0, 108, 132, contentBase );
+        for ( size_t i = 0; i < resources.size(); ++i ) {
+            const int columns = resources.size() == 1 ? 1 : 2, width = 132 / columns;
+            resources[i]->draw( contentBase, { int( i % columns ) * width + ( width - resources[i]->area().width ) / 2,
+                                               128 + int( i / columns ) * resourceRowHeight } );
+        }
+    }
+    Image content;
+    const Portrait portrait( troop, interactive );
+    const Rect portraitArea{ 0, 4, 132, resources.empty() ? 146 : 100 };
+    std::vector<int> actions;
+    if ( interactive && ( flags & Dialog::UPGRADE ) ) actions.push_back( Dialog::UPGRADE );
+    if ( interactive && ( flags & Dialog::DISMISS ) ) actions.push_back( Dialog::DISMISS );
+    if ( interactive ) actions.push_back( Dialog::CANCEL );
+    std::vector<std::unique_ptr<ButtonBase>> buttons;
+    for ( size_t i = 0; i < actions.size(); ++i ) {
+        Sprite released, pressed;
+        makeButtonSprites( released, pressed, "", { 284, 22 }, evil, evil ? ICN::STONEBAK_EVIL : ICN::STONEBAK );
+        const Text text( actions[i] == Dialog::UPGRADE ? _( "Upgrade" ) : actions[i] == Dialog::DISMISS ? _( "Dismiss" ) : _( "Exit" ), FontType::normalWhite() );
+        text.draw( 4, ( released.height() - text.height() ) / 2, released.width() - 8, released );
+        text.draw( 3, ( pressed.height() - text.height() ) / 2 + 1, pressed.width() - 8, pressed );
+        const int x = ( 320 - released.width() ) / 2;
+        buttons.emplace_back( std::make_unique<ButtonSprite>( x, 206 - int( actions.size() - 1 - i ) * 32, std::move( released ), std::move( pressed ) ) );
+    }
+    int scroll = 0, selected = int( actions.size() ) - 1, pressed = -1, result = Dialog::ZERO;
+    bool closed = false, down = !interactive && Platform3DS::isPhysicalTouchHeld(), moved = false;
+    Point start = Platform3DS::physicalTouchPosition(), last = start;
+    Uint32 began = SDL_GetTicks(), animationTick = began;
+    size_t frame = 0;
+    const CardScope scope( top, interactive ? &bottom : nullptr );
+    const auto draw = [&]() {
+        top.fill( background ); StandardWindow::renderBackgroundImage( top, { 0, 0, 400, 240 }, 0, evil ); DrawBorder( top, border );
+        const std::string title = std::string( troop.GetName() ) + " (" + std::to_string( troop.GetCount() ) + ")";
+        Text( title, Text( title, FontType::normalYellow() ).height( 376 ) <= 22 ? FontType::normalYellow() : FontType::smallYellow() ).draw( 12, 8, 376, top );
+        Copy( contentBase, content );
+        portrait.draw( content, portraitArea, frame, reflected );
+        Copy( content, 0, scroll, top, 12, 32, 376, 188 );
+        if ( height > 188 ) Text( "^ " + std::to_string( ( scroll + 31 ) / 32 + 1 ) + "/" + std::to_string( ( height - 188 + 31 ) / 32 + 1 ) + " v", FontType::smallYellow() ).draw( 0, 224, 400, top );
+        if ( interactive ) {
+            bottom.fill( background ); StandardWindow::renderBackgroundImage( bottom, { 0, 0, 320, 240 }, 0, evil ); DrawBorder( bottom, border );
+            for ( size_t i = 0; i < buttons.size(); ++i ) {
+                if ( down && !moved && pressed == int( i ) ) buttons[i]->press(); else buttons[i]->release(); buttons[i]->draw( bottom );
+                if ( selected == int( i ) ) { const Rect area = buttons[i]->area(); Fill( bottom, area.x, area.y + area.height + 1, area.width, 2, border ); }
+            }
+        }
+        Display::instance().render();
+    };
+    const auto activate = [&]( int index ) {
+        if ( index < 0 || index >= int( actions.size() ) ) return;
+        const int action = actions[index]; down = false; pressed = -1;
+        if ( action == Dialog::CANCEL ) { result = Dialog::CANCEL; closed = true; }
+        else if ( action == Dialog::DISMISS ) {
+            if ( showStandardTextMessage( troop.GetPluralName( troop.GetCount() ), _( "Are you sure you want to dismiss this army?" ), Dialog::YES | Dialog::NO ) == Dialog::YES ) { result = action; closed = true; }
+        }
+        else if ( flags & Dialog::UPGRADE_DISABLE ) showResourceMessage( Text( "", {} ), Text( _( "You can't afford to upgrade your troops!" ), FontType::normalWhite() ), Dialog::OK, troop.GetTotalUpgradeCost() );
+        else if ( showResourceMessage( Text( "", {} ), Text( _( "Your troops can be upgraded, but it will cost you dearly. Do you wish to upgrade them?" ), FontType::normalWhite() ), Dialog::YES | Dialog::NO, troop.GetTotalUpgradeCost() ) == Dialog::YES ) { result = action; closed = true; }
+    };
+    const auto information = [&]( int index ) {
+        if ( index < 0 || index >= int( actions.size() ) ) return;
+        const int action = actions[index]; down = false; pressed = -1;
+        if ( action == Dialog::UPGRADE ) showResourceMessage( Text( _( "Upgrade" ), FontType::normalYellow() ), Text( _( "Upgrade your troops." ), FontType::normalWhite() ), Dialog::ZERO, troop.GetTotalUpgradeCost() );
+        else showStandardTextMessage( action == Dialog::DISMISS ? _( "Dismiss" ) : _( "Exit" ), action == Dialog::DISMISS ? _( "Dismiss this army." ) : _( "Exit this menu." ), Dialog::ZERO );
+    };
+    draw();
+    if ( Platform3DS::smokeTest() && ( !Save( top, troop.isBattle() ? "sdmc:/3ds/fheroes2/army-info-battle-top.bmp" : "sdmc:/3ds/fheroes2/army-info-top.bmp" ) || ( interactive && !Save( bottom, troop.isBattle() ? "sdmc:/3ds/fheroes2/army-info-battle-bottom.bmp" : "sdmc:/3ds/fheroes2/army-info-bottom.bmp" ) ) ) ) throw std::runtime_error( "Cannot save army card" );
+    if ( Platform3DS::smokeTest() && interactive && !troop.isBattle() && !( flags & Dialog::UPGRADE ) && ( flags & Dialog::DISMISS ) ) {
+        if ( !Save( top, "sdmc:/3ds/fheroes2/army-info-no-upgrade-top.bmp" ) || !Save( bottom, "sdmc:/3ds/fheroes2/army-info-no-upgrade-bottom.bmp" ) )
+            throw std::runtime_error( "Cannot save army card without upgrade" );
+    }
+    auto & events = LocalEvent::Get();
+    while ( !closed && events.HandleEvents() ) {
+        bool redraw = false; Platform3DS::PanelInput input;
+        while ( !closed && Platform3DS::consumePanelInput( input ) ) {
+            redraw = true;
+            if ( input.type == PanelInputType::KeyUp && !interactive && input.key == PanelKey::Information ) closed = true;
+            else if ( input.type == PanelInputType::Key ) {
+                switch ( input.key ) {
+                case PanelKey::Up: scroll -= 32; break;
+                case PanelKey::Down: scroll += 32; break;
+                case PanelKey::Left: if ( interactive ) selected = ( selected + int( actions.size() ) - 1 ) % actions.size(); break;
+                case PanelKey::Right: if ( interactive ) selected = ( selected + 1 ) % actions.size(); break;
+                case PanelKey::Confirm: if ( interactive ) activate( selected ); else closed = true; break;
+                case PanelKey::Cancel: result = interactive ? Dialog::CANCEL : Dialog::ZERO; closed = true; break;
+                case PanelKey::Information: if ( interactive ) information( selected ); break;
+                }
+            }
+            else if ( input.type == PanelInputType::TouchDown ) {
+                start = last = input.position; began = SDL_GetTicks(); down = true; moved = false; pressed = -1;
+                if ( interactive ) for ( size_t i = 0; i < buttons.size(); ++i ) if ( buttons[i]->area() & start ) { pressed = int( i ); selected = pressed; }
+            }
+            else if ( input.type == PanelInputType::TouchMove && down ) {
+                moved = moved || std::abs( input.position.x - start.x ) >= 6 || std::abs( input.position.y - start.y ) >= 6;
+                if ( moved && pressed < 0 ) scroll += last.y - input.position.y;
+                last = input.position;
+            }
+            else if ( input.type == PanelInputType::TouchUp ) {
+                if ( !interactive ) closed = true;
+                else if ( down && !moved && pressed >= 0 && ( buttons[pressed]->area() & last ) ) activate( pressed );
+                down = false; pressed = -1;
+            }
+            scroll = std::clamp( scroll, 0, std::max( 0, height - 188 ) );
+        }
+        if ( interactive && down && !moved && pressed >= 0 && SDL_GetTicks() - began >= 550 ) { information( pressed ); redraw = true; }
+        const Uint32 now = SDL_GetTicks();
+        if ( interactive && now - animationTick >= 75 ) { frame += ( now - animationTick ) / 75; animationTick = now; redraw = true; }
+        if ( redraw && !closed ) draw();
+    }
+    lastScroll = scroll; lastStats = stats; lastEffects = effectCount;
+    return result;
+}
+void Interface3DS::testArmyInfo()
+{
+    using namespace fheroes2;
+    const auto key = []( int button, bool down ) {
+        SDL_Event e{}; e.type = down ? SDL_CONTROLLERBUTTONDOWN : SDL_CONTROLLERBUTTONUP;
+        e.cbutton.button = button; e.cbutton.state = down ? SDL_PRESSED : SDL_RELEASED; return e;
+    };
+    const auto touch = []( Uint32 type, int x, int y ) {
+        SDL_Event e{}; e.type = type; e.tfinger.touchId = 1; e.tfinger.fingerId = 0;
+        e.tfinger.x = x / 320.0f; e.tfinger.y = y / 240.0f; return e;
+    };
+    const auto crop = Platform3DS::viewport(); const auto * strip = Platform3DS::commandStripImage();
+    Image frame; Copy( Display::instance(), frame );
+    const auto run = [&]( const Troop & troop, int flags, std::vector<TimedEvent> sequence, bool held = false ) {
+        const auto id = troop.GetID(); const auto count = troop.GetCount();
+        if ( held ) { SDL_Event e = touch( SDL_FINGERDOWN, 50, 180 ); SDL_PushEvent( &e ); LocalEvent::Get().HandleEvents(); }
+        const int result = runInjectedInput( [&]() { return Dialog::ArmyInfo( troop, flags, false ); }, std::move( sequence ) );
+        if ( troop.GetID() != id || troop.GetCount() != count || Platform3DS::viewport() != crop || Platform3DS::commandStripImage() != strip
+             || std::memcmp( frame.image(), Display::instance().image(), frame.width() * frame.height() ) != 0 )
+            throw std::runtime_error( "Army card changed troop/frame/viewport/strip" );
+        return result;
+    };
+    const auto close = std::vector<TimedEvent>{ { 250, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } };
+    const Troop archer( Monster::ARCHER, 10 ); const int flags = Dialog::BUTTONS | Dialog::UPGRADE | Dialog::DISMISS;
+    if ( run( archer, flags, { { 250, key( SDL_CONTROLLER_BUTTON_A, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_A, false ) } } ) != Dialog::CANCEL )
+        throw std::runtime_error( "Army card default close differs" );
+    const auto confirmation = [&]( int y, bool accept, bool disabled = false ) {
+        std::vector<TimedEvent> sequence{ { 250, touch( SDL_FINGERDOWN, 160, y ) }, { 80, touch( SDL_FINGERUP, 0, 0 ) },
+            { 200, key( accept ? SDL_CONTROLLER_BUTTON_A : SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) },
+            { 80, key( accept ? SDL_CONTROLLER_BUTTON_A : SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } };
+        if ( !accept || disabled ) { sequence.emplace_back( 200, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) ); sequence.emplace_back( 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) ); }
+        return run( archer, flags | ( disabled ? Dialog::UPGRADE_DISABLE : 0 ), std::move( sequence ) );
+    };
+    if ( confirmation( 155, true ) != Dialog::UPGRADE || confirmation( 155, false ) != Dialog::CANCEL
+         || confirmation( 155, true, true ) != Dialog::CANCEL || confirmation( 185, true ) != Dialog::DISMISS
+         || confirmation( 185, false ) != Dialog::CANCEL ) throw std::runtime_error( "Army card confirmation contract differs" );
+    if ( run( archer, Dialog::BUTTONS, close ) != Dialog::CANCEL ) throw std::runtime_error( "Army card forbidden actions differ" );
+    if ( run( archer, flags, { { 250, touch( SDL_FINGERDOWN, 160, 155 ) }, { 80, touch( SDL_FINGERMOTION, 160, 120 ) },
+        { 80, touch( SDL_FINGERUP, 0, 0 ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } } ) != Dialog::CANCEL )
+        throw std::runtime_error( "Army card drag activated action" );
+    if ( run( archer, flags, { { 250, key( SDL_CONTROLLER_BUTTON_DPAD_RIGHT, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_DPAD_RIGHT, false ) },
+        { 80, key( SDL_CONTROLLER_BUTTON_B, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_B, false ) },
+        { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } } ) != Dialog::CANCEL )
+        throw std::runtime_error( "Army card nested information differs" );
+    const Troop ranger( Monster::RANGER, 8 );
+    if ( run( ranger, Dialog::BUTTONS | Dialog::DISMISS, close ) != Dialog::CANCEL )
+        throw std::runtime_error( "Army card without upgrade differs" );
+    const Troop dragon( Monster::BLACK_DRAGON, 5 );
+    if ( run( dragon, 0, { { 250, touch( SDL_FINGERMOTION, 50, 20 ) }, { 80, touch( SDL_FINGERUP, 0, 0 ) } }, true ) != Dialog::ZERO || lastScroll <= 0 )
+        throw std::runtime_error( "Army card held-stylus scroll differs" );
+    struct BattleTroop final : Troop {
+        BattleTroop() : Troop( Monster::ARCHER, 3 ) {}
+        bool isBattle() const override { return true; }
+        bool isModes( uint32_t mode ) const override { return ( mode & ( Battle::SP_BLESS | Battle::CAP_MIRRORIMAGE ) ) != 0; }
+        uint32_t GetAffectedDuration( uint32_t ) const override { return 3; }
+        std::string GetAttackString() const override { return "9 (3)"; }
+        std::string GetDefenseString() const override { return "8 (2)"; }
+        std::string GetShotString() const override { return "4"; }
+        uint32_t GetHitPointsLeft() const override { return 17; }
+    } battle;
+    if ( run( battle, 0, { { 250, key( SDL_CONTROLLER_BUTTON_DPAD_DOWN, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_DPAD_DOWN, false ) },
+        { 80, key( SDL_CONTROLLER_BUTTON_B, false ) } } ) != Dialog::ZERO || lastScroll <= 0 || lastEffects != 1 || lastStats.find( "9 (3)" ) == std::string::npos
+        || lastStats.find( "8 (2)" ) == std::string::npos || lastStats.find( "17" ) == std::string::npos ) throw std::runtime_error( "Army card battle statistics/effects differ" );
+    const auto previous = Settings::Get().getInterfaceType(); Settings::Get().setInterfaceType( InterfaceType::EVIL );
+    const Troop redDragon( Monster::RED_DRAGON, 5 ); const int evil = run( redDragon, flags, close );
+    Settings::Get().setInterfaceType( previous );
+    if ( evil != Dialog::CANCEL ) throw std::runtime_error( "Army card Evil UI differs" );
+    COUT( "3DS ARMY INFO SMOKE: PASS actual_dialog upgrade_dismiss_confirm_cancel unaffordable forbidden_actions drag held_scroll battle_stats_effects nested_info evil unchanged_troop_frame_context" )
+}
