+    if ( run( [&]() { return surrender( 500 ); }, { { 250, touch( SDL_FINGERDOWN, 150, 137 ) }, { 80, touch( SDL_FINGERUP, 150, 137 ) } } ) != 1 ) throw std::runtime_error( "Affordable surrender not accepted" );
