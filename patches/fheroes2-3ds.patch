+        catch ( ... ) { SDL_WaitThread( worker, &status ); throw; }
+        SDL_WaitThread( worker, &status );
+        if ( status ) throw std::runtime_error( "Dialog test input injection failed" );
+        auto & events = LocalEvent::Get();
+        events.HandleEvents( false, true );
+        if ( events.MouseClickLeft() || events.isMouseRightButtonPressed() || Platform3DS::hasModalImages() )
