+    const auto run = [&]( const std::string & title, const std::string & body, const std::vector<const DialogElement *> & elements, std::vector<TimedEvent> steps, int buttons = Dialog::OK ) {
+        const int result = runInjectedInput( [&]() { return fheroes2::showMessage( Text( title, FontType::normalYellow() ), Text( body, FontType::normalWhite() ), buttons, elements ); }, std::move( steps ) );
+        if ( viewport != Platform3DS::viewport() || strip != Platform3DS::commandStripImage() || hud != Platform3DS::battleHUDImage()
+             || hero.GetExperience() != experience || !( funds == world.GetKingdom( hero.GetColor() ).GetFunds() )
+             || std::memcmp( saved.image(), Display::instance().image(), saved.width() * saved.height() ) ) throw std::runtime_error( "Illustrated message changed caller/frame/context" );
+        return result;
+    };
+    const ResourceDialogElement gold( Resource::GOLD, "200" );
+    const Artifact item( Artifact::GOLDEN_BOW ); const ArtifactDialogElement artifact( item );
+    const Spell haste( Spell::HASTE ); const SpellDialogElement spell( haste, &hero );
