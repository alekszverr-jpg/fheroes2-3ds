+int Interface3DS::showHeroRecruit( const Castle & castle, const Heroes & hero, const std::string & description )
+{
+    using namespace fheroes2;
+    const CursorRestorer hideCursor( false );
+    const bool evil = Settings::Get().isEvilInterfaceEnabled();
+    const uint8_t background = GetColorId( 35, 29, 24 ), border = GetColorId( 150, 115, 63 );
+    const auto & frame = Assets::getImage( ICN::SURRENDR, 4 );
+    Image original( frame.width(), frame.height() ); original.fill( background );
+    Blit( frame, original, 0, 0 ); hero.PortraitRedraw( 5, 6, PORT_BIG, original );
+    const double scale = std::min( 2.0, 136.0 / std::max( original.width(), original.height() ) );
+    Image portrait( int( original.width() * scale ), int( original.height() * scale ) ); portrait.reset(); Resize( original, portrait );
+    std::string details = description + "\n\n";
+    for ( const auto & stat : { std::pair<int, int>{ Skill::Primary::ATTACK, hero.GetAttack() }, { Skill::Primary::DEFENSE, hero.GetDefense() },
+                               { Skill::Primary::POWER, hero.GetPower() }, { Skill::Primary::KNOWLEDGE, hero.GetKnowledge() } } )
+        details += std::string( Skill::Primary::String( stat.first ) ) + ": " + std::to_string( stat.second ) + "\n";
+    details += std::string( _( "Army" ) ) + ":\n";
+    for ( size_t i = 0; i < hero.GetArmy().Size(); ++i ) {
+        const auto * troop = hero.GetArmy().GetTroop( i );
+        if ( troop->isValid() ) details += std::string( troop->GetName() ) + ": " + std::to_string( troop->GetCount() ) + "\n";
+    }
+    if ( !details.empty() && details.back() == '\n' ) details.pop_back();
+    const Text body( details, FontType::normalWhite() );
+    Image content( 376, std::max<int32_t>( 188, std::max( portrait.height() + 8, body.height( 224 ) + 8 ) ) ); content.fill( background );
+    Blit( portrait, content, 0, 4 ); body.draw( 152, 4, 224, content );
+    Image top( 400, 240 ), bottom( 320, 240 );
+    std::array<std::unique_ptr<ButtonBase>, 2> buttons;
+    for ( size_t i = 0; i < buttons.size(); ++i ) {
+        Sprite released, pressed;
+        makeButtonSprites( released, pressed, "", { 142, 22 }, evil, evil ? ICN::STONEBAK_EVIL : ICN::STONEBAK );
+        const std::string label = i ? _( "Cancel" ) : _( "Recruit Hero" );
+        Text text( label, Text( label, FontType::normalWhite() ).width() <= released.width() - 8 ? FontType::normalWhite() : FontType::smallWhite() );
+        text.fitToOneRow( released.width() - 8 );
+        text.draw( 4, ( released.height() - text.height() ) / 2, released.width() - 8, released );
+        text.draw( 3, ( pressed.height() - text.height() ) / 2 + 1, pressed.width() - 8, pressed );
+        buttons[i] = std::make_unique<ButtonSprite>( i ? 166 : 6, 206, std::move( released ), std::move( pressed ) );
+    }
+    const auto cost = getResourceDialogElements( PaymentConditions::RecruitHero() );
+    const RecruitHeroScope scope( top, bottom );
+    int selected = 1, scroll = 0, pressed = -1;
+    bool down = false, moved = false; Point start, last; Uint32 began = 0;
+    const auto information = [&]() {
+        down = false; pressed = -1;
+        const CustomImageDialogElement image( original );
+        showStandardTextMessage( _( "Recruit Hero" ), details, Dialog::ZERO, { &image } );
+    };
+    const auto draw = [&]() {
+        top.fill( background ); StandardWindow::renderBackgroundImage( top, { 0, 0, 400, 240 }, 0, evil ); DrawRect( top, { 0, 0, 400, 240 }, border );
+        Text title( _( "Recruit Hero" ), FontType::normalYellow() ); title.draw( 12, 8, 376, top );
+        Copy( content, 0, scroll, top, 12, 32, 376, 188 );
+        if ( content.height() > 188 ) Text( "^ " + std::to_string( ( scroll + 31 ) / 32 + 1 ) + "/" + std::to_string( ( content.height() - 188 + 31 ) / 32 + 1 ) + " v", FontType::smallYellow() ).draw( 0, 224, 400, top );
+        bottom.fill( background ); StandardWindow::renderBackgroundImage( bottom, { 0, 0, 320, 240 }, 0, evil ); DrawRect( bottom, { 0, 0, 320, 240 }, border );
+        Text name( hero.GetName(), FontType::normalYellow() ); name.fitToOneRow( 296 ); name.draw( 12, 8, 296, bottom );
+        Text( _( "building3DS|Cost" ), FontType::normalWhite() ).draw( 12, 34, 296, bottom );
+        for ( size_t i = 0; i < cost.size(); ++i ) cost[i].draw( bottom, { 160 - cost[i].area().width / 2, 54 + int( i ) * 40 } );
+        Text( std::string( _( "Gold in Treasury:" ) ) + " " + std::to_string( castle.GetKingdom().GetFunds().gold ), FontType::normalWhite() ).draw( 12, 110, 296, bottom );
+        std::string reason;
+        if ( castle.AllowBuyHero( &reason ) ) buttons[0]->enable(); else buttons[0]->disable();
+        Text( reason, FontType::smallWhite() ).draw( 12, 146, 296, bottom );
+        Text( "B: " + std::string( _( "Details" ) ), FontType::smallWhite() ).draw( 12, 188, 296, bottom );
+        for ( size_t i = 0; i < buttons.size(); ++i ) {
+            if ( down && !moved && pressed == int( i ) ) buttons[i]->press(); else buttons[i]->release();
+            buttons[i]->draw( bottom ); if ( selected == int( i ) ) DrawRect( bottom, buttons[i]->area(), border );
+        }
+        lastRecruitScroll = scroll; Display::instance().render();
+    };
+    draw();
