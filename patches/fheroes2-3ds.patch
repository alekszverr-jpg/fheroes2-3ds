+        rewardImages[i].reset(); Resize( *original, rewardImages[i] );
+    }
+    if ( buttons & Dialog::YES ) answers.push_back( { Dialog::YES, std::make_unique<Button>( 0, 204, evil ? ICN::BUTTON_SMALL_YES_EVIL : ICN::BUTTON_SMALL_YES_GOOD, 0, 1 ) } );
+    if ( buttons & Dialog::OK ) answers.push_back( { Dialog::OK, std::make_unique<Button>( 0, 204, evil ? ICN::UNIFORM_EVIL_OKAY_BUTTON : ICN::UNIFORM_GOOD_OKAY_BUTTON, 0, 1 ) } );
+    if ( buttons & Dialog::NO ) answers.push_back( { Dialog::NO, std::make_unique<Button>( 0, 204, evil ? ICN::BUTTON_SMALL_NO_EVIL : ICN::BUTTON_SMALL_NO_GOOD, 0, 1 ) } );
+    if ( buttons & Dialog::CANCEL ) answers.push_back( { Dialog::CANCEL, std::make_unique<Button>( 0, 204, evil ? ICN::UNIFORM_EVIL_CANCEL_BUTTON : ICN::UNIFORM_GOOD_CANCEL_BUTTON, 0, 1 ) } );
+    if ( choice ) for ( size_t i = 0; i < answers.size(); ++i ) {
+        Sprite released, pressed;
+        makeButtonSprites( released, pressed, "", classicChoice ? Size{ 116, 24 } : Size{ 136, 30 }, evil, classicChoice ? ( evil ? ICN::UNIFORMBAK_EVIL : ICN::UNIFORMBAK_GOOD ) : ( evil ? ICN::STONEBAK_EVIL : ICN::STONEBAK ) );
+        // Use the normal game font: the upstream button font does not contain all translated glyphs on this build.
+        const Text label( choice->labels[i], FontType::normalWhite() );
+        label.draw( 4, ( released.height() - label.height( released.width() - 8 ) ) / 2, released.width() - 8, released );
+        label.draw( 3, ( pressed.height() - label.height( pressed.width() - 8 ) ) / 2 + 1, pressed.width() - 8, pressed );
+        if ( classicChoice ) addGradientShadow( released, chestBackground, { choiceCentre( i ) - released.width() / 2, 168 + ( 32 - released.height() ) / 2 }, { -3, 3 } );
+        answers[i].button = std::make_unique<ButtonSprite>( 0, 204, std::move( released ), std::move( pressed ) );
+    }
+    for ( size_t i = 0; i < answers.size(); ++i ) {
+        const auto & button = answers[i].button;
+        button->setPosition( ( classicFrame ? choiceCentre( i ) : ( window.width() * ( 2 * int( i ) + 1 ) / ( 2 * int( answers.size() ) ) ) ) - button->area().width / 2,
+                             buttonRow + ( 32 - button->area().height ) / 2 );
+    }
+
+    if ( classicConfirmation ) for ( const auto & answer : answers ) {
+        const int icn = answer.value == Dialog::YES ? ( evil ? ICN::BUTTON_SMALL_YES_EVIL : ICN::BUTTON_SMALL_YES_GOOD )
+                      : answer.value == Dialog::NO ? ( evil ? ICN::BUTTON_SMALL_NO_EVIL : ICN::BUTTON_SMALL_NO_GOOD )
+                      : answer.value == Dialog::OK ? ( evil ? ICN::UNIFORM_EVIL_OKAY_BUTTON : ICN::UNIFORM_GOOD_OKAY_BUTTON )
+                                                   : ( evil ? ICN::UNIFORM_EVIL_CANCEL_BUTTON : ICN::UNIFORM_GOOD_CANCEL_BUTTON );
+        addGradientShadow( Assets::getImage( icn, 0 ), chestBackground, answer.button->area().getPosition(), { -3, 3 } );
+    }
+    int scroll = 0, selected = 0, pressed = -1;
+    int touchedElement = -1;
+    Point start, last;
+    uint32_t began = 0;
+    bool down = heldPosition != nullptr, moved = false;
+    if ( heldPosition ) start = last = *heldPosition;
+    int result = Dialog::ZERO;
+    bool closed = false;
+    const ModalScope scope( window, information, !upperWindow.empty() ? &upperWindow : nullptr );
+    COUT( "3DS MESSAGE screen=" << ( information ? "top" : "bottom" ) << " content_height=" << height << " buttons=" << buttons << " choice=" << ( choice != nullptr ) )
+    int capturedChestScroll = -1;
+    const auto draw = [&]() {
+        if ( classicConfirmation ) {
+            window = chestBackground;
+            const int visibleScroll = classicIllustrated ? std::min( scroll, elementMaximum ) : scroll;
+            Copy( content, 0, visibleScroll, window, 24, 24, elementWidth, viewHeight );
+            if ( classicIllustrated && !upperWindow.empty() ) {
+                const int textScroll = std::min( scroll, textMaximum );
+                Copy( textContent, 0, textScroll, upperWindow, 24, 24, width, 176 );
+                if ( textMaximum > 0 ) Text( "^ " + std::to_string( ( textScroll + 31 ) / 32 + 1 ) + "/" + std::to_string( ( textMaximum + 31 ) / 32 + 1 ) + " v", FontType::smallWhite() ).draw( 24, 202, width, upperWindow );
+            }
+            if ( height > viewHeight ) Text( "^ " + std::to_string( ( visibleScroll + 31 ) / 32 + 1 ) + "/" + std::to_string( ( height - viewHeight + 31 ) / 32 + 1 ) + " v", FontType::smallWhite() ).draw( 24, 154, width, window );
+        }
+        else if ( classicChoice ) {
+            window = chestBackground;
+            Copy( content, 0, scroll, upperWindow, 24, 24, width, viewHeight );
+            if ( height > viewHeight ) Text( "^ " + std::to_string( ( scroll + 31 ) / 32 + 1 ) + "/" + std::to_string( ( height - viewHeight + 31 ) / 32 + 1 ) + " v", FontType::smallWhite() ).draw( 24, 202, width, upperWindow );
+        }
+        else {
+        window.fill( background );
+        StandardWindow::renderBackgroundImage( window, { 0, 0, window.width(), 240 }, 0, evil );
+        DrawBorder( window, border );
+        Copy( content, 0, scroll, window, 12, 8, width, viewHeight );
+        if ( height > viewHeight ) {
+            const Text hint( "^ " + std::to_string( ( scroll + 31 ) / 32 + 1 ) + "/" + std::to_string( ( height - viewHeight + 31 ) / 32 + 1 ) + " v", FontType::smallYellow() );
+            hint.draw( 0, choice ? 8 + viewHeight + 2 : information ? 224 : 190, window.width(), window );
+        }
+        if ( information ) {
+            if ( height <= viewHeight ) Text( "A / L", FontType::smallWhite() ).draw( 0, 224, window.width(), window );
+        }
+        }
+        if ( choice ) for ( size_t i = 0; i < elements.size(); ++i ) {
+            if ( classicChoice ) {
+                Blit( rewardImages[i], window, choiceCentre( i ) - rewardImages[i].width() / 2, ( choice->classicSkill ? 98 : 110 ) - rewardImages[i].height() );
+                if ( !choice->classicSkill ) {
+                    Text amount( choice->quantities[i], FontType::normalWhite() ); amount.fitToOneRow( 128 );
+                    amount.draw( choiceCentre( i ) - 64, 118, 128, window );
+                }
+            }
+            else elements[i]->draw( window, offsets[i] );
+            const int detailWidth = classicChoice && elements.size() == 1 ? 264 : 136;
+            Text detail( choice->details[i], choice->classicSkill ? FontType::normalWhite() : FontType::smallWhite() );
+            if ( choice->classicSkill && detail.height( detailWidth ) > 51 ) detail.fitToOneRow( detailWidth );
+            detail.draw( classicChoice ? choiceCentre( i ) - detailWidth / 2 : 12 + int( i ) * 160,
+                         classicChoice ? ( choice->classicSkill ? 104 : 144 ) : 184, detailWidth, window );
+        }
+        for ( size_t i = 0; i < answers.size(); ++i ) {
+            auto & button = answers[i].button;
+            if ( pressed == int( i ) && !moved ) button->press(); else button->release();
+            button->draw( window );
+            if ( int( i ) == selected ) {
+                const auto roi = button->area();
+                if ( classicFrame ) DrawRect( window, { roi.x - 2, roi.y - 2, roi.width + 4, roi.height + 4 }, GetColorId( 255, 220, 70 ) );
+                else Fill( window, roi.x, roi.y + roi.height + 1, roi.width, 2, border );
+            }
+        }
+        if ( classicChoice && Platform3DS::smokeTest() && capturedChestScroll != scroll ) {
+            capturedChestScroll = scroll;
+            std::string prefix = choice->classicSkill ? ( elements.size() == 2 ? "level-choice" : dynamic_cast<const PrimarySkillDialogElement *>( elements[0] ) ? "level-primary" : "level-single" ) : "chest";
+            if ( evil ) prefix += "-evil";
+            if ( height > viewHeight ) prefix += "-long";
+            if ( !Save( upperWindow, "sdmc:/3ds/fheroes2/" + prefix + "-top.bmp" ) || !Save( window, "sdmc:/3ds/fheroes2/" + prefix + "-bottom.bmp" ) ) throw std::runtime_error( "Cannot capture chest panels" );
+        }
+        if ( classicConfirmation && Platform3DS::smokeTest() && capturedChestScroll != scroll ) {
+            capturedChestScroll = scroll;
+            std::string prefix = confirmationPair ? ( buttons & Dialog::YES ? "confirm-yesno" : "confirm-okcancel" ) : ( buttons & Dialog::OK ? "confirm-ok" : "confirm-cancel" );
+            if ( classicIllustrated ) {
+                prefix = elements.size() > 1 ? "message-mixed" : dynamic_cast<const ArtifactDialogElement *>( elements[0] ) ? "message-artifact"
+                       : dynamic_cast<const SpellDialogElement *>( elements[0] ) ? "message-spell" : "message-resource";
+            }
+            if ( evil ) prefix += "-evil";
+            if ( scrollMaximum > 0 ) prefix += "-long";
+            if ( !Save( window, "sdmc:/3ds/fheroes2/" + prefix + "-bottom.bmp" )
+                 || ( classicIllustrated && !upperWindow.empty() && !Save( upperWindow, "sdmc:/3ds/fheroes2/" + prefix + "-top.bmp" ) ) ) throw std::runtime_error( "Cannot capture confirmation" );
+        }
+        Display::instance().render();
+    };
+    const auto buttonAt = [&]( const Point point ) {
+        for ( size_t i = 0; i < answers.size(); ++i ) if ( ( classicFrame ? Rect{ choiceCentre( i ) - 64, classicChoice ? 158 : 166, 128, classicChoice ? 48 : 44 } : answers[i].button->area() ) & point ) return int( i );
+        return -1;
+    };
+    const auto elementAt = [&]( const Point point ) {
+        if ( choice ) {
+            for ( size_t i = 0; i < elements.size(); ++i ) {
+                const Rect roi = classicChoice ? Rect{ choiceCentre( i ) - 64, 42, 128, choice->classicSkill ? 116 : 88 } : Rect{ offsets[i].x, offsets[i].y, elements[i]->area().width, elements[i]->area().height };
+                if ( roi & point ) return int( i );
+            }
+            return -1;
+        }
+        const int originY = classicIllustrated ? 24 : 8;
+        if ( point.y < originY || point.y >= originY + viewHeight ) return -1;
+        for ( size_t i = 0; i < elements.size(); ++i ) {
+            const Rect roi{ ( classicIllustrated ? 24 : 12 ) + offsets[i].x, originY + offsets[i].y - ( classicIllustrated ? std::min( scroll, elementMaximum ) : scroll ), elements[i]->area().width, elements[i]->area().height };
+            if ( roi & point ) return int( i );
+        }
+        return -1;
+    };
+    const auto showInformation = [&]() {
+        if ( touchedElement >= 0 && hasInformation( elements[touchedElement] ) ) {
+            const Image * lowerDialog = Platform3DS::modalBottomImage();
+            if ( Platform3DS::smokeTest() ) Platform3DS::requestCapture();
+            elements[touchedElement]->showPopup( Dialog::ZERO );
+            if ( lowerDialog && Platform3DS::modalBottomImage() == lowerDialog ) ++nestedInformationReturns;
+            down = false; pressed = -1;
+        }
