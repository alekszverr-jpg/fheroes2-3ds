+    using TimedEvent = std::pair<Uint32, SDL_Event>;
+    int runInjectedInput( const std::function<int()> & dialog, std::vector<TimedEvent> sequence )
+    {
+        SDL_Thread * worker = SDL_CreateThread( []( void * data ) -> int {
+            auto & steps = *static_cast<std::vector<TimedEvent> *>( data );
+            for ( auto & step : steps ) {
+                SDL_Delay( step.first );
+                if ( SDL_PushEvent( &step.second ) != 1 ) return 1;
+            }
+            return 0;
+        }, "dialog-smoke", &sequence );
+        if ( !worker ) throw std::runtime_error( "Cannot start dialog test input" );
+        int result = 0, status = 0;
+        try { result = dialog(); }
+        catch ( ... ) { SDL_WaitThread( worker, &status ); throw; }
+        SDL_WaitThread( worker, &status );
+        if ( status ) throw std::runtime_error( "Dialog test input injection failed" );
+        auto & events = LocalEvent::Get();
+        events.HandleEvents( false, true );
+        if ( events.MouseClickLeft() || events.isMouseRightButtonPressed() || Platform3DS::hasModalImages() )
+            throw std::runtime_error( "Modal input or image layer leaked after close" );
+        return result;
+    }
+    class BookScope
+    {
+    public:
+        BookScope( const Image & top, const Image * bottom, bool retainTop = false )
+        {
+            Platform3DS::pushModalImages( retainTop ? nullptr : &top, bottom );
+            Platform3DS::freezeViewportFollow( LocalEvent::Get().getMouseCursorPos(), SDL_GetTicks() );
+            LocalEvent::Get().resetFor3DSPanel();
+        }
+        ~BookScope()
+        {
+            Platform3DS::popModalImages();
+            LocalEvent::Get().resetFor3DSPanel();
+            auto & display = Display::instance();
+            display.updateNextRenderRoi( { 0, 0, display.width(), display.height() } );
+            display.render();
+        }
+    };
+    int lastScroll = 0;
+}
+int Interface3DS::showBattleHeroActions( const HeroBase & hero, const bool cast, const bool retreat, const bool surrender, const bool heroScreen )
+{
+    using namespace fheroes2;
+    const CursorRestorer hideCursor( false );
+    Image top, bottom( 320, 240 );
+    const auto crop = Platform3DS::viewport();
+    Copy( Display::instance(), crop.x, crop.y, bottom, 0, 0, 320, Platform3DS::detailHeight() );
+    const bool evil = Settings::Get().isEvilInterfaceEnabled();
+    StandardWindow::renderBackgroundImage( bottom, { 0, 116, 320, 124 }, 0, evil );
+    Text title( hero.GetName(), FontType::normalYellow() ); title.fitToOneRow( 304 ); title.draw( 8, 120, 304, bottom );
+    const std::array<bool, 4> enabled{ cast, retreat, surrender, true };
+    const std::array<std::string, 4> labels{ _( "Cast Spell" ), _( "Retreat" ), _( "Surrender" ), _( "Exit" ) };
+    const std::array<Rect, 4> areas{ Rect{ 6, 140, 150, 44 }, { 164, 140, 150, 44 }, { 6, 188, 150, 44 }, { 164, 188, 150, 44 } };
+    std::vector<std::unique_ptr<ButtonBase>> buttons;
+    for ( size_t i = 0; i < areas.size(); ++i ) {
+        Sprite released, pressed;
+        makeButtonSprites( released, pressed, "", { 144, 38 }, evil, evil ? ICN::STONEBAK_EVIL : ICN::STONEBAK );
+        const auto & icon = Assets::getImage( ICN::VIEWGEN, 9 + int( i ) * 2 );
+        Image thumbnail( 28, 28 ); thumbnail.reset(); Resize( icon, thumbnail );
+        Blit( thumbnail, released, 5, 5 ); Blit( thumbnail, pressed, 4, 6 );
+        Text label( labels[i], FontType::smallWhite() );
+        label.draw( 36, ( released.height() - label.height( 106 ) ) / 2, 106, released );
+        label.draw( 35, ( pressed.height() - label.height( 106 ) ) / 2 + 1, 106, pressed );
+        buttons.emplace_back( std::make_unique<ButtonSprite>( areas[i].x, areas[i].y, std::move( released ), std::move( pressed ) ) );
+        if ( !enabled[i] ) buttons.back()->disable();
+    }
+    const BookScope scope( top, &bottom, true );
+    int selected = 3, pressed = -1; bool down = false, moved = false;
+    Point start; int result = 0; bool closed = false;
+    const auto draw = [&]() {
+        for ( size_t i = 0; i < buttons.size(); ++i ) {
+            if ( down && !moved && pressed == int( i ) ) buttons[i]->press(); else buttons[i]->release();
+            buttons[i]->draw( bottom );
+            const auto & area = areas[i]; const uint8_t color = selected == int( i ) ? GetColorId( 255, 225, 96 ) : GetColorId( 90, 65, 40 );
+            Fill( bottom, area.x, area.y, area.width, 1, color ); Fill( bottom, area.x, area.y + area.height - 1, area.width, 1, color );
+            Fill( bottom, area.x, area.y, 1, area.height, color ); Fill( bottom, area.x + area.width - 1, area.y, 1, area.height, color );
+        }
+        Display::instance().render();
+    };
+    const auto activate = [&]( int index ) {
+        if ( enabled[index] ) { result = index == 3 ? 0 : index + 1; closed = true; }
+    };
+    draw();
+    if ( Platform3DS::smokeTest() && !Save( bottom, "sdmc:/3ds/fheroes2/hero-actions-bottom.bmp" ) ) throw std::runtime_error( "Cannot save hero actions" );
+    auto & events = LocalEvent::Get();
+    while ( !closed && events.HandleEvents() ) {
+        Platform3DS::PanelInput input; bool redraw = false;
+        while ( !closed && Platform3DS::consumePanelInput( input ) ) {
+            redraw = true;
+            if ( input.type == PanelInputType::Key ) {
+                switch ( input.key ) {
+                case PanelKey::Toggle: case PanelKey::Cancel: closed = true; break;
+                case PanelKey::Confirm: activate( selected ); break;
+                case PanelKey::Up: case PanelKey::Down: selected ^= 2; break;
+                case PanelKey::Left: case PanelKey::Right: selected ^= 1; break;
+                default: break;
+                }
+            }
+            else if ( input.type == PanelInputType::TouchDown ) {
+                down = true; moved = false; start = input.position; pressed = -1;
+                for ( size_t i = 0; i < areas.size(); ++i ) if ( areas[i] & start ) { pressed = int( i ); selected = pressed; }
+            }
+            else if ( input.type == PanelInputType::TouchMove && down )
+                moved = moved || std::abs( input.position.x - start.x ) >= 6 || std::abs( input.position.y - start.y ) >= 6;
+            else if ( input.type == PanelInputType::TouchUp ) {
+                if ( down && !moved && pressed >= 0 ) activate( pressed );
+                else if ( down && !moved && heroScreen && ( Rect{ 0, 116, 320, 24 } & start ) ) { result = 4; closed = true; }
+                down = false; pressed = -1;
+            }
+        }
+        if ( redraw && !closed ) draw();
+    }
+    return result;
+}
