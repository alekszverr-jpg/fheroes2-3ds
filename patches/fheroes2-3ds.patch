+std::vector<uint32_t> Interface3DS::castleBuildingChoices( const Castle & castle )
+{
+    std::vector<uint32_t> result;
+    const auto priorities = fheroes2::getBuildingDrawingPriorities( castle.GetRace(), Settings::Get().getCurrentMapInfo().version );
+    for ( const auto id : priorities ) {
+        if ( !castle.isBuild( id ) ) continue;
+        const uint32_t dwelling = castle.GetActualDwelling( id );
+        if ( dwelling != BUILD_NOTHING ) { if ( dwelling == id ) result.push_back( id ); continue; }
+        if ( ( id & BUILD_MAGEGUILD ) != 0 ) {
+            if ( id == uint32_t( BUILD_MAGEGUILD1 ) << ( castle.GetLevelMageGuild() - 1 ) ) result.push_back( id );
+            continue;
+        }
+        // Match only actions handled by Castle::OpenDialog; towers are part of the castle illustration.
+        switch ( id ) {
+        case BUILD_CASTLE: case BUILD_TENT: case BUILD_THIEVESGUILD: case BUILD_TAVERN: case BUILD_SHRINE: case BUILD_CAPTAIN:
+        case BUILD_STATUE: case BUILD_WEL2: case BUILD_MOAT: case BUILD_SPEC: case BUILD_SHIPYARD: case BUILD_MARKETPLACE: case BUILD_WELL:
+            result.push_back( id ); break;
+        default: break;
+        }
+    }
+    const auto rank = [&]( uint32_t id ) {
+        for ( int tier = 0; tier < 6; ++tier ) if ( castle.GetActualDwelling( uint32_t( DWELLING_MONSTER1 ) << tier ) == id ) return tier;
+        if ( id & BUILD_MAGEGUILD ) return 7;
+        switch ( id ) {
+        case BUILD_CASTLE: case BUILD_TENT: return 6;
+        case BUILD_MARKETPLACE: return 8;
+        case BUILD_WELL: return 9;
+        case BUILD_TAVERN: case BUILD_SHRINE: return 10;
+        case BUILD_THIEVESGUILD: return 11;
+        case BUILD_SHIPYARD: return 12;
+        default: return 13;
+        }
+    };
+    std::stable_sort( result.begin(), result.end(), [&]( uint32_t left, uint32_t right ) { return rank( left ) < rank( right ); } );
+    return result;
+}
+uint32_t Interface3DS::showCastleBuildings( const Castle & castle )
+{
