+bool Interface3DS::showBattleSurrender( const HeroBase & hero, const uint32_t cost, Kingdom & kingdom )
+{
+    using namespace fheroes2;
+    while ( true ) {
+        const bool affordable = kingdom.AllowPayment( Funds( Resource::GOLD, cost ) );
+        const bool market = !affordable && kingdom.GetCountMarketplace();
+        Image content( 376, 512 ); content.fill( backgroundColor() );
+        std::string title = hero.isCaptain() ? _( "Captain of %{name} states:" ) : _( "%{name} states:" ); StringReplace( title, "%{name}", hero.GetName() );
+        int y = paragraph( content, 0, title, FontType::normalYellow() );
+        Image portrait( 120, 112 ); portrait.fill( backgroundColor() ); hero.PortraitRedraw( 0, 0, PORT_BIG, portrait ); Blit( portrait, content, 8, y );
+        std::string text = _( "\"I will accept your surrender and grant you and your troops safe passage for the price of %{price} gold.\"" ); StringReplace( text, "%{price}", cost );
+        y = std::max( y + 120, paragraph( content, y, text, FontType::normalWhite(), 244, 132 ) );
+        y = paragraph( content, y, std::string( _( "Gold" ) ) + ": " + std::to_string( kingdom.GetFunds().gold ) );
+        if ( !affordable ) { text = _( "Not enough gold (%{gold})" ); StringReplace( text, "%{gold}", cost - kingdom.GetFunds().gold ); y = paragraph( content, y, text ); }
+        Image full( 376, std::max( 204, y ) ); Copy( content, 0, 0, full, 0, 0, 376, std::max( 204, y ) );
+        const int choice = report( full, { _( "Surrender" ), _( "Marketplace" ), _( "Cancel" ) }, { affordable, market, true }, _( "Surrender" ), "battle-surrender" );
+        if ( choice == 0 ) return true;
+        if ( choice != 1 ) return false;
+        // Leave the native image layer before opening the original marketplace; then refresh funds and availability.
+        Dialog::Marketplace( kingdom, false );
+    }
+}
