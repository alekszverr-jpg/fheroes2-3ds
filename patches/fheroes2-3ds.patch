+void Interface3DS::testNativeMessages()
+{
+    using namespace fheroes2;
+    using TimedEvent = std::pair<Uint32, SDL_Event>;
+    auto & events = LocalEvent::Get();
+    const auto controller = []( const int button, const bool pressed ) {
+        SDL_Event event{};
+        event.type = pressed ? SDL_CONTROLLERBUTTONDOWN : SDL_CONTROLLERBUTTONUP;
+        event.cbutton.button = button;
+        event.cbutton.state = pressed ? SDL_PRESSED : SDL_RELEASED;
+        return event;
+    };
+    const auto touch = []( const Uint32 type, const int x, const int y ) {
+        SDL_Event event{}; event.type = type; event.tfinger.touchId = 1; event.tfinger.fingerId = 0;
+        event.tfinger.x = x / 320.0f; event.tfinger.y = y / 240.0f;
+        return event;
+    };
+    const auto run = [&]( const TextBase & title, const TextBase & text, const int buttons, const std::vector<const DialogElement *> & elements,
+                          std::vector<TimedEvent> sequence ) {
+        return runInjectedInput( [&]() { return fheroes2::showMessage( title, text, buttons, elements ); }, std::move( sequence ) );
+    };
+    const Text title( _( "Next Hero" ), FontType::normalYellow() );
+    const Text text( _( "Select the next Hero." ), FontType::normalWhite() );
+    Image strip( 320, 40 ); strip.fill( GetColorId( 60, 40, 20 ) );
+    const Image * previousStrip = Platform3DS::commandStripImage();
+    Platform3DS::setCommandStripImage( &strip );
+    const auto crop = Platform3DS::viewport();
+    Image savedDisplay;
+    Copy( Display::instance(), savedDisplay );
+    Platform3DS::requestCapture();
+    if ( run( title, text, Dialog::ZERO, {}, { { 300, controller( SDL_CONTROLLER_BUTTON_B, false ) } } ) != Dialog::ZERO )
+        throw std::runtime_error( "Information requested a game answer" );
+    if ( Platform3DS::viewport() != crop || Platform3DS::commandStripImage() != &strip )
+        throw std::runtime_error( "Information changed viewport or strip state" );
+    Platform3DS::setCommandStripImage( previousStrip );
+    // At the bottom edge, suspending the 200px strip must not discard the saved y=280 crop.
+    Platform3DS::setCommandStripImage( &strip );
+    Platform3DS::resetViewportFollow();
+    Platform3DS::followCursor( { 799, 479 }, SDL_GetTicks(), false );
+    const auto edgeCrop = Platform3DS::viewport();
+    if ( edgeCrop.y != 280 ) throw std::runtime_error( "Bottom-edge test did not reach strip limit" );
+    Platform3DS::setCommandStripImage( nullptr );
+    run( title, text, Dialog::ZERO, {}, { { 300, controller( SDL_CONTROLLER_BUTTON_B, false ) } } );
+    if ( Platform3DS::viewport() != edgeCrop ) throw std::runtime_error( "Information discarded the suspended strip viewport" );
+    Platform3DS::setCommandStripImage( previousStrip );
+    Platform3DS::requestCapture();
+    if ( run( title, text, Dialog::OK, {}, { { 300, controller( SDL_CONTROLLER_BUTTON_START, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_START, false ) } } ) != Dialog::OK )
+        throw std::runtime_error( "OK confirmation differs" );
+    if ( run( title, text, Dialog::YES | Dialog::NO, {}, { { 300, touch( SDL_FINGERDOWN, 240, 218 ) }, { 100, touch( SDL_FINGERUP, 0, 0 ) } } ) != Dialog::NO )
+        throw std::runtime_error( "Native touchscreen NO selection differs" );
+    if ( run( title, text, Dialog::OK | Dialog::CANCEL, {}, {
+             { 300, touch( SDL_FINGERDOWN, 80, 218 ) }, { 100, touch( SDL_FINGERMOTION, 160, 170 ) }, { 100, touch( SDL_FINGERUP, 0, 0 ) },
+             { 200, controller( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } } ) != Dialog::CANCEL )
+        throw std::runtime_error( "Dragging out of a dialog button activated it" );
+    // Start in R+Start must switch rendering, never confirm the active dialog.
+    if ( run( title, text, Dialog::OK | Dialog::CANCEL, {}, {
+             { 200, controller( SDL_CONTROLLER_BUTTON_RIGHTSHOULDER, true ) },
+             { 100, controller( SDL_CONTROLLER_BUTTON_START, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_RIGHTSHOULDER, false ) },
+             { 100, controller( SDL_CONTROLLER_BUTTON_START, false ) },
+             { 100, controller( SDL_CONTROLLER_BUTTON_RIGHTSHOULDER, true ) },
+             { 100, controller( SDL_CONTROLLER_BUTTON_START, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_START, false ) },
+             { 100, controller( SDL_CONTROLLER_BUTTON_RIGHTSHOULDER, false ) },
+             { 200, controller( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } } ) != Dialog::CANCEL
+         || !Platform3DS::highResolutionEnabled() ) throw std::runtime_error( "Display chord answered a dialog or failed to restore wide mode" );
+    std::string longBody;
+    for ( int i = 0; i < 24; ++i ) longBody += text.text() + "\n";
+    if ( run( title, Text( longBody, FontType::normalWhite() ), Dialog::OK, {}, {
+             { 300, touch( SDL_FINGERDOWN, 160, 150 ) }, { 100, touch( SDL_FINGERMOTION, 160, 40 ) }, { 100, touch( SDL_FINGERUP, 0, 0 ) },
+             { 200, controller( SDL_CONTROLLER_BUTTON_START, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_START, false ) } } ) != Dialog::OK || lastMessageScroll <= 0 )
+        throw std::runtime_error( "Long text did not scroll with fixed confirmation" );
+    const auto nestedBefore = nestedInformationReturns;
+    if ( run( title, Text( longBody, FontType::normalWhite() ), Dialog::ZERO, {}, {
+             { 300, controller( SDL_CONTROLLER_BUTTON_DPAD_DOWN, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_DPAD_DOWN, false ) },
+             { 100, controller( SDL_CONTROLLER_BUTTON_DPAD_DOWN, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_DPAD_DOWN, false ) },
+             { 100, controller( SDL_CONTROLLER_BUTTON_A, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_A, false ) } } ) != Dialog::ZERO || lastMessageScroll <= 0 )
+        throw std::runtime_error( "Long top information did not scroll" );
+    const ResourceDialogElement gold( Resource::GOLD, "200" );
+    if ( run( Text{}, Text{}, Dialog::YES | Dialog::NO, { &gold }, {
+             { 300, touch( SDL_FINGERDOWN, 160, 24 ) }, { 900, touch( SDL_FINGERUP, 0, 0 ) },
+             { 300, controller( SDL_CONTROLLER_BUTTON_START, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_START, false ) } } ) != Dialog::YES
+         || nestedInformationReturns != nestedBefore + 1 ) throw std::runtime_error( "Nested information lost the lower dialog or selected an answer" );
+    if ( std::memcmp( savedDisplay.image(), Display::instance().image(), savedDisplay.width() * savedDisplay.height() ) != 0 )
+        throw std::runtime_error( "Native dialogs modified the game frame" );
+    Platform3DS::setCommandStripImage( previousStrip );
+    events.resetFor3DSPanel();
+    testBattleLog();
+    testArmySplit();
+    testArmyInfo();
+    testCombatSpellBook();
+    testAdventureSpellBook();
+    testBattleHeroActions();
+    testBattleOutcome();
+    COUT( "3DS NATIVE MESSAGES SMOKE: PASS top_info bottom_ok native_touch_no drag_cancel long_scroll nested_info release_isolation" )
+}
