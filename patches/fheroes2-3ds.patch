+        case SDL_CONTROLLER_BUTTON_DPAD_RIGHT: bit = 2; break;
+        case SDL_CONTROLLER_BUTTON_DPAD_UP: bit = 4; break;
+        case SDL_CONTROLLER_BUTTON_DPAD_DOWN: bit = 8; break;
