+namespace
+{
+    // Keep the user's choice across turns and loads in this session.
+    bool stripVisible = false;
+    int buttonAt( const fheroes2::Point point )
+    {
+        return point.x >= 0 && point.x < 320 && point.y >= 200 && point.y < 240 ? point.x / 40 : -1;
+    }
+}
+bool Interface3DS::queueDpadScroll( Interface::GameArea & area )
+{
+    const auto dpad = Platform3DS::adventureScrollDirection();
+    if ( dpad == fheroes2::Point() || area.isDragScroll() || Settings::Get().ScrollSpeed() == SCROLL_SPEED_NONE ) return false;
+    const int direction = ( dpad.x < 0 ? Interface::SCROLL_LEFT : dpad.x > 0 ? Interface::SCROLL_RIGHT : Interface::SCROLL_NONE )
+                          | ( dpad.y < 0 ? Interface::SCROLL_TOP : dpad.y > 0 ? Interface::SCROLL_BOTTOM : Interface::SCROLL_NONE );
+    area.SetScroll( direction );
+    area.SetUpdateCursor();
+    return true;
+}
+Interface3DS::CommandStrip::CommandStrip() : _image( 320, 40 ) {}
+Interface3DS::CommandStrip::~CommandStrip() { suspend(); }
+void Interface3DS::CommandStrip::toggle()
+{
+    stripVisible = !stripVisible;
+    _pressed = -1;
+    _dirty = true;
+    LocalEvent::Get().resetFor3DSPanel();
+    COUT( "3DS COMMAND STRIP visible=" << stripVisible )
+}
+bool Interface3DS::CommandStrip::present( const std::array<bool, 8> & enabled, const int movementFrame, const bool evil )
+{
+    if ( _enabled != enabled || _movementFrame != movementFrame || _evil != evil ) {
+        _enabled = enabled; _movementFrame = movementFrame; _evil = evil; _dirty = true;
+    }
+    const bool redraw = _dirty;
+    if ( stripVisible && _dirty ) draw();
+    _dirty = false;
+    Platform3DS::setCommandStripImage( stripVisible ? &_image : nullptr );
+    return redraw;
+}
+void Interface3DS::CommandStrip::suspend() { Platform3DS::setCommandStripImage( nullptr ); }
+void Interface3DS::CommandStrip::draw()
+{
+    _image.fill( fheroes2::GetColorId( 28, 21, 15 ) );
+    const std::array<int, 8> frames{ 0, _movementFrame, 4, 6, 8, 10, 12, 14 };
+    for ( int i = 0; i < 8; ++i ) {
+        const auto & sprite = Assets::getImage( _evil ? ICN::ADVEBTNS : ICN::ADVBTNS, frames[i] + ( i == _pressed && !_dragged && _enabled[i] ? 1 : 0 ) );
+        fheroes2::Image scaled( 40, 40 );
+        fheroes2::Resize( sprite, scaled );
+        if ( !_enabled[i] ) fheroes2::ApplyPalette( scaled, PAL::GetPalette( PAL::PaletteType::DARKENING ) );
+        fheroes2::Blit( scaled, _image, i * 40, 0 );
+    }
+}
+Interface3DS::StripAction Interface3DS::CommandStrip::processInput()
+{
+    StripAction action;
+    Platform3DS::PanelInput input;
+    while ( Platform3DS::consumePanelInput( input ) ) {
+        switch ( input.type ) {
+        case Platform3DS::PanelInputType::TouchDown:
+            _start = _last = input.position;
+            _pressed = buttonAt( input.position );
+            _started = SDL_GetTicks(); _dragged = false; _dirty = true;
+            break;
+        case Platform3DS::PanelInputType::TouchMove:
+            _last = input.position;
+            if ( std::abs( _last.x - _start.x ) >= 10 || std::abs( _last.y - _start.y ) >= 10 || buttonAt( _last ) != _pressed ) {
+                _dragged = true; _dirty = true;
+            }
+            break;
+        case Platform3DS::PanelInputType::TouchUp:
+            // SDL reports (0,0) on release. Match against the last real pen position.
+            if ( _pressed >= 0 && !_dragged && buttonAt( _last ) == _pressed ) {
+                const bool information = SDL_GetTicks() - _started >= 550;
+                if ( information || _enabled[_pressed] ) action = { _pressed, information };
+            }
+            _pressed = -1; _dirty = true;
+            break;
+        case Platform3DS::PanelInputType::Key:
+        case Platform3DS::PanelInputType::KeyUp: break;
+        }
+    }
+    if ( action.index < 0 && _pressed >= 0 && !_dragged && SDL_GetTicks() - _started >= 550 ) {
+        action = { _pressed, true };
+        _pressed = -1; _dirty = true;
+    }
+    if ( action.index >= 0 ) COUT( "3DS COMMAND STRIP index=" << action.index << " info=" << action.information )
+    return action;
+}
+void Interface3DS::showStripInformation( const int index )
+{
+    const std::array<const char *, 8> titles{ _( "Next Hero" ), _( "Hero Movement" ), _( "Kingdom Summary" ), _( "Cast Spell" ),
+                                             _( "End Turn" ), _( "Adventure Options" ), _( "File Options" ), _( "System Options" ) };
+    const std::array<const char *, 8> descriptions{
+        _( "Select the next Hero." ),
+        _( "Start the Hero's movement along the current path or re-visit the object occupied by the Hero." ),
+        _( "View a summary of your Kingdom." ), _( "Cast an adventure spell." ), _( "End your turn and let the computer take its turn." ),
+        _( "Bring up the adventure options menu." ),
+        _( "Bring up the file options menu, allowing you to load, save, start a new game or quit." ),
+        _( "Bring up the system options menu, allowing you to customize your game." ) };
+    if ( index >= 0 && index < 8 ) fheroes2::showStandardTextMessage( titles[index], descriptions[index], Dialog::ZERO );
+}
+void Interface3DS::captureCommandPanelPreview()
+{
+    const bool previousVisible = stripVisible;
+    stripVisible = true;
+    CommandStrip strip;
+    const std::array<bool, 8> enabled{ true, true, true, true, true, true, true, true };
+    strip.present( enabled, 2, false );
+    Platform3DS::requestCapture();
+    fheroes2::Display::instance().render();
+    auto & events = LocalEvent::Get();
+    const auto touch = [&events]( const Uint32 type, const float x, const float y ) {
+        SDL_Event event{}; event.type = type; event.tfinger.touchId = 1; event.tfinger.fingerId = 0;
+        event.tfinger.x = x; event.tfinger.y = y;
+        if ( SDL_PushEvent( &event ) != 1 ) throw std::runtime_error( "Strip smoke injection failed" );
+        for ( int attempt = 0; attempt < 4 && SDL_HasEvent( type ); ++attempt ) events.HandleEvents( false, true );
+        if ( SDL_HasEvent( type ) ) throw std::runtime_error( "Strip smoke event not drained" );
+    };
+    events.resetFor3DSPanel();
+    for ( int i = 0; i < 8; ++i ) {
+        touch( SDL_FINGERDOWN, ( i * 40 + 20 ) / 320.0f, 220 / 240.0f );
+        touch( SDL_FINGERUP, 0, 0 );
+        const auto action = strip.processInput();
+        if ( action.index != i || action.information || events.MouseClickLeft() ) throw std::runtime_error( "Strip tap action or isolation differs" );
+    }
+    auto disabled = enabled; disabled[3] = false;
+    strip.present( disabled, 18, false );
+    touch( SDL_FINGERDOWN, 140 / 320.0f, 220 / 240.0f ); touch( SDL_FINGERUP, 0, 0 );
+    if ( strip.processInput().index >= 0 ) throw std::runtime_error( "Disabled spell was activated" );
+    touch( SDL_FINGERDOWN, 140 / 320.0f, 220 / 240.0f ); strip.processInput(); SDL_Delay( 600 );
+    const auto info = strip.processInput();
+    if ( info.index != 3 || !info.information ) throw std::runtime_error( "Disabled spell information unavailable" );
+    strip.suspend(); touch( SDL_FINGERUP, 0, 0 );
+    if ( events.MouseClickLeft() ) throw std::runtime_error( "Strip held release leaked after suspension" );
+    strip.present( enabled, 2, false );
+    touch( SDL_FINGERDOWN, 20 / 320.0f, 220 / 240.0f );
+    touch( SDL_FINGERMOTION, 80 / 320.0f, 180 / 240.0f ); touch( SDL_FINGERUP, 0, 0 );
+    if ( strip.processInput().index >= 0 || events.MouseClickLeft() ) throw std::runtime_error( "Strip drag activated command or map" );
+    // Real map touches remain playable above the strip.
+    touch( SDL_FINGERDOWN, .5f, .5f ); touch( SDL_FINGERUP, 0, 0 );
+    if ( !events.MouseClickLeft() ) throw std::runtime_error( "Map tap above strip swallowed" );
+    strip.toggle(); strip.present( enabled, 2, false );
+    if ( Platform3DS::commandStripImage() ) throw std::runtime_error( "Strip toggle did not hide" );
+    stripVisible = previousVisible;
+    strip.suspend(); events.resetFor3DSPanel();
+    COUT( "3DS COMMAND STRIP SMOKE: PASS" )
+    // Exercise the production scroll dispatcher and real GameArea on a synthetic map.
+    // No tiles, game actions, player turns or saves are processed by this test.
+    class TestInterface final : public Interface::BaseInterface
+    {
+    public:
+        TestInterface() : BaseInterface( false ) {}
+        void redraw( uint32_t ) override {}
+        void mouseCursorAreaClickLeft( int32_t ) override {}
+        void mouseCursorAreaPressRight( int32_t ) const override {}
+        void mouseCursorAreaLongPressLeft( int32_t ) override {}
+        void reset() override {}
+        void updateCursor( int32_t ) override {}
+    } testInterface;
+    world.generateUninitializedMap( 72 );
+    auto & area = testInterface.getGameArea();
+    area.generate( { 640, 480 }, false );
+    const auto narrowROI = area.GetROI();
+    area.generate( { fheroes2::Display::instance().width(), fheroes2::Display::instance().height() }, false );
+    if ( area.GetROI().width != narrowROI.width + 160 || area.GetROI().height != narrowROI.height )
+        throw std::runtime_error( "Wide frame did not expand only map width" );
+    auto & settings = Settings::Get();
+    const int previousScrollSpeed = settings.ScrollSpeed();
+    settings.SetScrollSpeed( 2 );
+    const auto centre = area.getCurrentCenterInPixels();
+    const auto button = [&events]( const int id, const bool down ) {
+        SDL_Event event{}; event.type = down ? SDL_CONTROLLERBUTTONDOWN : SDL_CONTROLLERBUTTONUP;
+        event.cbutton.button = id; event.cbutton.state = down ? SDL_PRESSED : SDL_RELEASED;
+        if ( SDL_PushEvent( &event ) != 1 ) throw std::runtime_error( "Map scroll injection failed" );
+        for ( int attempt = 0; attempt < 4 && SDL_HasEvent( event.type ); ++attempt ) events.HandleEvents( false, true );
+        if ( SDL_HasEvent( event.type ) ) throw std::runtime_error( "Map scroll event not drained" );
+    };
+    Platform3DS::setAdventureInputActive( true );
+    button( SDL_CONTROLLER_BUTTON_DPAD_RIGHT, true );
+    button( SDL_CONTROLLER_BUTTON_DPAD_DOWN, true );
+    for ( int i = 0; i < 5; ++i ) {
+        if ( !queueDpadScroll( area ) ) throw std::runtime_error( "Held D-pad did not queue map scroll" );
+        area.Scroll();
+    }
+    const auto moved = area.getCurrentCenterInPixels();
+    if ( moved.x <= centre.x || moved.y <= centre.y || events.isAnyKeyPressed() )
+        throw std::runtime_error( "D-pad did not pan map diagonally or triggered hero hotkey" );
+    button( SDL_CONTROLLER_BUTTON_DPAD_RIGHT, false );
+    button( SDL_CONTROLLER_BUTTON_DPAD_DOWN, false );
+    if ( queueDpadScroll( area ) || area.NeedScroll() ) throw std::runtime_error( "Released D-pad queued another map scroll" );
+    area.Scroll();
+    if ( area.getCurrentCenterInPixels() != moved ) throw std::runtime_error( "Map moved after D-pad release" );
+    button( SDL_CONTROLLER_BUTTON_DPAD_LEFT, true );
+    button( SDL_CONTROLLER_BUTTON_DPAD_UP, true );
+    for ( int i = 0; i < 5; ++i ) { queueDpadScroll( area ); area.Scroll(); }
+    if ( area.getCurrentCenterInPixels() != centre ) throw std::runtime_error( "Reverse diagonal scroll differs" );
+    settings.SetScrollSpeed( SCROLL_SPEED_NONE );
+    if ( queueDpadScroll( area ) ) throw std::runtime_error( "D-pad ignored disabled scrolling setting" );
+    settings.SetScrollSpeed( previousScrollSpeed );
+    button( SDL_CONTROLLER_BUTTON_DPAD_LEFT, false ); button( SDL_CONTROLLER_BUTTON_DPAD_UP, false );
+    Platform3DS::setAdventureInputActive( false ); Platform3DS::cancelAdventureScroll();
+    events.resetFor3DSPanel();
+    COUT( "3DS MAP SCROLL SMOKE: PASS virtual=800x480 map_width_extra=160 diagonal_hold_release=ok" )
+}
+#endif
