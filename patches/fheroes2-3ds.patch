+Troop Interface3DS::showRecruit( const Monster & original, const uint32_t available, const bool allowDowngradedMonster, const Funds & funds )
+{
+    using namespace fheroes2;
+    const CursorRestorer cursorRestorer( false );
+    Image window( 320, 240 );
+    const bool evil = Settings::Get().isEvilInterfaceEnabled();
+    const uint8_t border = GetColorId( 150, 115, 63 );
+    const std::array<int, 7> resources{ Resource::GOLD, Resource::WOOD, Resource::MERCURY, Resource::ORE, Resource::SULFUR, Resource::CRYSTAL, Resource::GEMS };
+    std::vector<Monster> variants{ original };
+    while ( allowDowngradedMonster && variants.back().GetDowngrade() != variants.back() )
+        variants.push_back( variants.back().GetDowngrade() );
+    size_t variant = 0;
+    uint32_t maximum = 0, count = 0;
+    const auto resetCount = [&]() {
+        maximum = available;
+        const Funds price = variants[variant].GetCost();
+        for ( const int resource : resources )
+            if ( price.Get( resource ) > 0 )
+                maximum = std::min( maximum, uint32_t( std::max<int32_t>( 0, funds.Get( resource ) ) / price.Get( resource ) ) );
+        count = maximum;
+    };
+    resetCount();
+    enum
+    {
+        Minus,
+        Plus,
+        Minimum,
+        Maximum,
+        Previous,
+        Next,
+        Confirm,
+        Cancel
+    };
+    std::vector<std::unique_ptr<ButtonBase>> buttons;
+    const std::array<std::string, 8> labels{ "-", "+", "MIN", "MAX", "<", ">", _( "Okay" ), _( "Cancel" ) };
+    const std::array<Rect, 8> areas{ Rect{ 70, 128, 32, 28 }, { 218, 128, 32, 28 }, { 10, 128, 52, 28 },  { 258, 128, 52, 28 },
+                                     { 126, 94, 28, 22 },      { 266, 94, 28, 22 },   { 12, 204, 136, 30 }, { 172, 204, 136, 30 } };
+    for ( size_t i = 0; i < labels.size(); ++i ) {
+        Sprite released, pressed;
+        makeButtonSprites( released, pressed, "", { areas[i].width, areas[i].height }, evil, evil ? ICN::STONEBAK_EVIL : ICN::STONEBAK );
+        const Text label( labels[i], i < Confirm ? FontType::smallWhite() : FontType::normalWhite() );
+        label.draw( 4, ( released.height() - label.height( released.width() - 8 ) ) / 2, released.width() - 8, released );
+        label.draw( 3, ( pressed.height() - label.height( pressed.width() - 8 ) ) / 2 + 1, pressed.width() - 8, pressed );
+        buttons.emplace_back( std::make_unique<ButtonSprite>( areas[i].x, areas[i].y, std::move( released ), std::move( pressed ) ) );
+    }
+    // Custom button frames add borders to the requested content size. Position from their actual hit areas.
+    buttons[Minimum]->setPosition( 12, 128 );
+    buttons[Maximum]->setPosition( 308 - buttons[Maximum]->area().width, 128 );
+    buttons[Minus]->setPosition( 16 + buttons[Minimum]->area().width, 128 );
+    buttons[Plus]->setPosition( buttons[Maximum]->area().x - buttons[Plus]->area().width - 4, 128 );
+    const int quantityX = buttons[Minus]->area().x + buttons[Minus]->area().width + 4;
+    const int quantityWidth = buttons[Plus]->area().x - quantityX - 4;
+    if ( Platform3DS::smokeTest() ) {
+        const std::array<int, 4> row{ Minimum, Minus, Plus, Maximum };
+        for ( size_t i = 1; i < row.size(); ++i ) {
+            const auto & left = buttons[row[i - 1]]->area();
+            if ( left.x + left.width >= buttons[row[i]]->area().x )
+                throw std::runtime_error( "Recruit quantity buttons overlap" );
+        }
+        if ( quantityWidth < 60 )
+            throw std::runtime_error( "Recruit quantity text has no room" );
+    }
+    const Rect slider{ 12, 158, 296, 22 };
+    const Rect portraitArea{ 12, 34, 104, 90 };
+    std::vector<int> portraitFrames;
+    Rect portraitBounds;
+    size_t portraitFrame = 0;
+    Uint32 portraitTick = SDL_GetTicks();
+    Image firstPortrait;
+    bool capturedIdle = false;
+    const auto preparePortrait = [&]() {
+        const AnimationReference reference( variants[variant].GetID() );
+        const auto & standing = reference.getAnimationVector( Monster_Info::STAND_STILL );
+        if ( standing.empty() ) throw std::runtime_error( "Recruit portrait has no standing frame" );
+        portraitFrames.assign( 12, standing.front() );
+        const auto & idle = reference.getAnimationVector( Monster_Info::IDLE );
+        portraitFrames.insert( portraitFrames.end(), idle.begin(), idle.end() );
+        const int icn = variants[variant].GetMonsterSprite();
+        const auto & first = Assets::getImage( icn, portraitFrames.front() );
+        int32_t left = first.x(), top = first.y(), right = left + first.width(), bottom = top + first.height();
+        for ( const int frame : portraitFrames ) {
+            const auto & sprite = Assets::getImage( icn, frame );
+            left = std::min( left, sprite.x() ); top = std::min( top, sprite.y() );
+            right = std::max( right, sprite.x() + sprite.width() ); bottom = std::max( bottom, sprite.y() + sprite.height() );
+        }
+        portraitBounds = { left, top, right - left, bottom - top };
+        portraitFrame = 0;
+        portraitTick = SDL_GetTicks();
+    };
+    preparePortrait();
+    int pressed = -1;
+    bool down = false, moved = false, sliding = false, closed = false, accepted = false;
+    Point start, last;
+    uint32_t began = 0;
+    const ModalScope scope( window, false );
+    const auto enabled = [&]( const int action ) {
+        if ( action == Previous || action == Next )
+            return variants.size() > 1;
+        if ( action == Confirm )
+            return count > 0;
+        if ( action == Minus || action == Minimum )
+            return count > 1;
+        if ( action == Plus || action == Maximum )
+            return count < maximum;
+        return true;
+    };
+    const auto draw = [&]() {
+        window.fill( GetColorId( 35, 29, 24 ) );
+        StandardWindow::renderBackgroundImage( window, { 0, 0, 320, 240 }, 0, evil );
+        DrawBorder( window, border );
+        std::string title = _( "Recruit %{name}" );
+        StringReplace( title, "%{name}", variants[variant].GetMultiName() );
+        const Text titleText( title, FontType::normalYellow() );
+        Text( title, titleText.height( 296 ) <= 26 ? FontType::normalYellow() : FontType::smallYellow() ).draw( 12, 6, 296, window );
+        const Sprite & creature = Assets::getImage( variants[variant].GetMonsterSprite(), portraitFrames[portraitFrame] );
+        Image icon( portraitBounds.width, portraitBounds.height );
+        icon.reset();
+        Blit( creature, icon, creature.x() - portraitBounds.x, creature.y() - portraitBounds.y );
+        const double scale = std::min( double( portraitArea.width ) / icon.width(), double( portraitArea.height ) / icon.height() );
+        const int iconWidth = std::max( 1, int( icon.width() * scale ) ), iconHeight = std::max( 1, int( icon.height() * scale ) );
+        Image scaledIcon( iconWidth, iconHeight );
+        scaledIcon.reset();
+        Resize( icon, scaledIcon );
+        Blit( scaledIcon, window, portraitArea.x + ( portraitArea.width - iconWidth ) / 2, portraitArea.y + ( portraitArea.height - iconHeight ) / 2 );
+        Text( _( "Cost per troop:" ), FontType::smallWhite() ).draw( 126, 36, 182, window );
+        const Funds price = variants[variant].GetCost();
+        std::vector<int> used;
+        for ( const int resource : resources )
+            if ( price.Get( resource ) > 0 )
+                used.push_back( resource );
+        for ( size_t i = 0; i < used.size(); ++i ) {
+            const int columnWidth = 182 / int( used.size() );
+            const ResourceDialogElement cost( used[i], std::to_string( price.Get( used[i] ) ) );
+            cost.draw( window, { 126 + columnWidth * int( i ) + ( columnWidth - cost.area().width ) / 2, 53 } );
+            const int32_t total = price.Get( used[i] ) * count;
+            Text( _( "Resource cost:" ) + std::string( " " ) + std::to_string( total ) + " (" + std::to_string( funds.Get( used[i] ) - total ) + ")",
+                  FontType::smallWhite() )
+                .draw( 12 + int( i ) * ( 296 / int( used.size() ) ), 184, 296 / int( used.size() ), window );
+        }
+        std::string availability = _( "Available: %{count}" );
+        StringReplace( availability, "%{count}", available );
+        Text( availability, FontType::smallWhite() ).draw( variants.size() > 1 ? 166 : 126, 98, variants.size() > 1 ? 96 : 182, window );
+        const Text quantity( std::to_string( count ) + "/" + std::to_string( maximum ), FontType::normalWhite() );
+        if ( quantity.width() <= quantityWidth )
+            quantity.draw( quantityX, 135, quantityWidth, window );
+        else {
+            Text( std::to_string( count ), FontType::smallWhite() ).draw( quantityX, 128, quantityWidth, window );
+            Text( "/" + std::to_string( maximum ), FontType::smallWhite() ).draw( quantityX, 143, quantityWidth, window );
+        }
+        Fill( window, 12, 166, 296, 4, GetColorId( 50, 40, 30 ) );
+        const int thumb = maximum > 0 ? int( uint64_t( count ) * 288 / maximum ) : 0;
+        Fill( window, 12 + thumb, 160, 8, 16, border );
+        for ( int i = 0; i < int( buttons.size() ); ++i ) {
+            if ( ( i == Previous || i == Next ) && variants.size() == 1 )
+                continue;
+            if ( enabled( i ) )
+                buttons[i]->enable();
+            else
+                buttons[i]->disable();
+            if ( down && !moved && pressed == i && enabled( i ) )
+                buttons[i]->press();
+            else
+                buttons[i]->release();
+            buttons[i]->draw( window );
+        }
+        if ( captureRecruitLayout ) {
+            if ( !Save( window, "sdmc:/3ds/fheroes2/recruit-large.bmp" ) ) throw std::runtime_error( "Recruit layout screenshot failed" );
+            captureRecruitLayout = false;
+        }
+        if ( captureRecruitPortrait ) {
+            Image current;
+            // Copy into a sized image; the crop must cover only the portrait, not quantity/button state.
+            if ( firstPortrait.empty() ) {
+                firstPortrait.resize( portraitArea.width, portraitArea.height );
+                Copy( window, portraitArea.x, portraitArea.y, firstPortrait, 0, 0, portraitArea.width, portraitArea.height );
+                if ( !Save( window, "sdmc:/3ds/fheroes2/recruit-static.bmp" ) ) throw std::runtime_error( "Recruit screenshot failed" );
+            }
+            else {
+                current.resize( portraitArea.width, portraitArea.height );
+                Copy( window, portraitArea.x, portraitArea.y, current, 0, 0, portraitArea.width, portraitArea.height );
+                if ( std::memcmp( firstPortrait.image(), current.image(), portraitArea.width * portraitArea.height ) != 0 && !capturedIdle ) {
+                    ++recruitPortraitChanges;
+                    capturedIdle = true;
+                    if ( !Save( window, "sdmc:/3ds/fheroes2/recruit-idle.bmp" ) ) throw std::runtime_error( "Recruit animation screenshot failed" );
+                }
+            }
+        }
+        Display::instance().render();
+    };
+    const auto information = [&]() {
+        const Monster & monster = variants[variant];
+        std::string body = _( "Attack" ) + std::string( ": " ) + std::to_string( monster.GetAttack() ) + "\n" + _( "Defense" ) + ": "
+                           + std::to_string( monster.GetDefense() ) + "\n" + _( "Damage" ) + ": " + std::to_string( monster.GetDamageMin() ) + " - "
+                           + std::to_string( monster.GetDamageMax() ) + "\n" + _( "Hit Points" ) + ": " + std::to_string( monster.GetHitPoints() ) + "\n" + _( "Speed" )
+                           + ": " + Troop( monster, 1 ).GetSpeedString();
+        for ( const auto & property : getMonsterPropertiesDescription( monster.GetID() ) )
+            body += "\n\n" + property;
+        const Image * lower = Platform3DS::modalBottomImage();
+        const MonsterDialogElement portrait( monster );
+        showNativeMessage( Text( monster.GetName(), FontType::normalYellow() ), Text( body, FontType::normalWhite() ),
+                           Dialog::ZERO, { &portrait }, nullptr, down ? &last : nullptr );
+        if ( Platform3DS::modalBottomImage() == lower )
+            ++nestedInformationReturns;
+        down = false;
+        sliding = false;
+        pressed = -1;
+    };
+    const auto activate = [&]( const int action ) {
+        if ( !enabled( action ) )
+            return;
+        switch ( action ) {
+        case Minus:
+            --count;
+            break;
+        case Plus:
+            ++count;
+            break;
+        case Minimum:
+            count = maximum > 0 ? 1 : 0;
+            break;
+        case Maximum:
+            count = maximum;
+            break;
+        case Previous:
+            variant = ( variant + 1 ) % variants.size();
+            resetCount();
+            preparePortrait();
+            break;
+        case Next:
+            variant = ( variant + variants.size() - 1 ) % variants.size();
+            resetCount();
+            preparePortrait();
+            break;
+        case Confirm:
+            accepted = true;
+            closed = true;
+            break;
+        case Cancel:
+            closed = true;
+            break;
+        }
+    };
+    const auto slide = [&]( const Point point ) {
+        if ( maximum > 0 )
+            count = std::max<uint32_t>( 1, uint64_t( std::clamp<int32_t>( point.x - 12, 0, 288 ) ) * maximum / 288 );
+    };
+    draw();
+    auto & events = LocalEvent::Get();
+    while ( !closed && events.HandleEvents() ) {
+        Platform3DS::PanelInput input;
+        while ( !closed && Platform3DS::consumePanelInput( input ) ) {
+            if ( input.type == PanelInputType::Key ) {
+                switch ( input.key ) {
+                case PanelKey::Left:
+                    activate( Minus );
+                    break;
+                case PanelKey::Right:
+                    activate( Plus );
+                    break;
+                case PanelKey::Up:
+                    activate( Maximum );
+                    break;
+                case PanelKey::Down:
+                    activate( Minimum );
+                    break;
+                case PanelKey::Confirm:
+                    activate( Confirm );
+                    break;
+                case PanelKey::Cancel:
+                    activate( Cancel );
+                    break;
+                case PanelKey::Information:
+                    information();
+                    break;
+                }
+            }
+            else if ( input.type == PanelInputType::TouchDown ) {
+                start = last = input.position;
+                began = SDL_GetTicks();
+                down = true;
+                moved = false;
+                pressed = -1;
+                sliding = slider & last;
+                if ( sliding )
+                    slide( last );
+                else
+                    for ( int i = 0; i < int( buttons.size() ); ++i )
+                        if ( buttons[i]->area() & last )
+                            pressed = i;
+            }
+            else if ( input.type == PanelInputType::TouchMove && down ) {
+                last = input.position;
+                moved = moved || std::abs( last.x - start.x ) > 6 || std::abs( last.y - start.y ) > 6;
+                if ( sliding )
+                    slide( last );
+            }
+            else if ( input.type == PanelInputType::TouchUp && down ) {
+                if ( !moved && !sliding && pressed >= 0 && ( buttons[pressed]->area() & last ) )
+                    activate( pressed );
+                down = false;
+                sliding = false;
+                pressed = -1;
+            }
+        }
+        if ( down && !moved && !sliding && ( portraitArea & start ) && SDL_GetTicks() - began >= 550 )
+            information();
+        if ( !closed ) {
+            const Uint32 now = SDL_GetTicks();
+            if ( now - portraitTick >= 75 ) {
+                portraitFrame = ( portraitFrame + ( now - portraitTick ) / 75 ) % portraitFrames.size();
+                portraitTick = now;
+            }
+            draw();
+        }
+    }
+    // The caller owns payment, dwelling availability and army placement, exactly as on desktop.
+    return { variants[variant], accepted ? count : 0 };
+}
+
+void Interface3DS::testRecruit()
+{
+    using namespace fheroes2;
+    struct RestoreFunds
+    {
+        Kingdom & kingdom;
+        Funds saved;
+        ~RestoreFunds()
+        {
+            kingdom.AddFundsResource( saved - kingdom.GetFunds() );
+        }
+    };
+    auto & kingdom = world.GetKingdom( Settings::Get().CurrentColor() );
+    const RestoreFunds restore{ kingdom, kingdom.GetFunds() };
+    const auto crop = Platform3DS::viewport();
