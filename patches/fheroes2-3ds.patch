+    if ( run( [&]() { return surrender( 500 ); }, { { 250, touch( SDL_FINGERDOWN, 150, 137 ) }, { 80, touch( SDL_FINGERMOTION, 150, 170 ) }, { 80, touch( SDL_FINGERUP, 150, 170 ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } } ) ) throw std::runtime_error( "Surrender drag accepted" );
+    if ( !( kingdom.GetFunds() == funds ) ) throw std::runtime_error( "Surrender dialog charged gold" );
+    run( [&]() { showBattleArtifact( Artifact( Artifact::SNAKE_RING ), _( "You have captured an enemy artifact!" ) ); return 0; }, { { 250, key( SDL_CONTROLLER_BUTTON_B, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_B, false ) }, { 80, key( SDL_CONTROLLER_BUTTON_A, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_A, false ) } } );
+    const auto previous = Settings::Get().getInterfaceType(); Settings::Get().setInterfaceType( InterfaceType::EVIL );
+    run( [&]() { return surrender( 500 ); }, cancel ); Settings::Get().setInterfaceType( previous );
+    Settings::Get().setInterfaceType( InterfaceType::EVIL ); run( [&]() { return necromancy( 12 ); }, okay ); Settings::Get().setInterfaceType( previous );
+    COUT( "3DS NECROMANCY SMOKE: PASS count_plural_extremes touch_controller cancel_drag evil unchanged_frame_hud_viewport release_isolation" )
+    COUT( "3DS BATTLE OUTCOME SMOKE: PASS summary_restart_ok_cancel empty_long_casualties stylus_scroll button_drag surrender_actual_dialog affordable_unaffordable unchanged_funds artifact_info evil unchanged_frame_hud_viewport release_isolation" )
