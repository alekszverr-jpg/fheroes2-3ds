diff --git a/src/engine/screen_3ds.h b/src/engine/screen_3ds.h
new file mode 100644
index 0000000..9da454e
--- /dev/null
+++ b/src/engine/screen_3ds.h
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Included inside screen.cpp's anonymous namespace after currentRGBPalette.
+class RenderEngine3DS final : public fheroes2::BaseRenderEngine
+{
+public:
+    bool isFullScreen() const override { return true; }
+    void toggleFullScreen() override {}
+    std::vector<fheroes2::ResolutionInfo> getAvailableResolutions() const override { return { { 800, 480 } }; }
+    fheroes2::Rect getActiveWindowROI() const override { return { 0, 0, 800, 480 }; }
+    fheroes2::Size getCurrentScreenResolution() const override { return { 800, 480 }; }
+    ~RenderEngine3DS() override { clear(); }
+private:
+    SDL_Window * _top = nullptr;
+    SDL_Window * _bottom = nullptr;
+    std::array<uint32_t, 256> _colors{};
+    Uint32 _reportTime = 0;
+    unsigned _frames = 0;
+    double _drawTime = 0;
+
+    void clear() override
+    {
+        SDL_DestroyWindow( _bottom ); _bottom = nullptr;
+        SDL_DestroyWindow( _top ); _top = nullptr;
+        Platform3DS::resetViewportFollow();
+    }
+    bool allocate( fheroes2::ResolutionInfo & resolution, bool ) override
+    {
+        clear();
+        resolution = { 800, 480 };
+        Platform3DS::setVirtualFrameSize( { resolution.gameWidth, resolution.gameHeight } );
+        _top = SDL_CreateWindow( "fheroes2", SDL_WINDOWPOS_UNDEFINED_DISPLAY( 0 ), SDL_WINDOWPOS_UNDEFINED_DISPLAY( 0 ), 400, 240, SDL_WINDOW_FULLSCREEN );
+        _bottom = SDL_CreateWindow( "fheroes2 detail", SDL_WINDOWPOS_UNDEFINED_DISPLAY( 1 ), SDL_WINDOWPOS_UNDEFINED_DISPLAY( 1 ), 320, 240, SDL_WINDOW_FULLSCREEN );
+        if ( !_top || !_bottom ) { ERROR_LOG( SDL_GetError() ) clear(); return false; }
+        gfxSet3D( false );
+        gfxSetScreenFormat( GFX_TOP, GSP_RGBA8_OES );
+        gfxSetScreenFormat( GFX_BOTTOM, GSP_RGBA8_OES );
+        updatePalette( StandardPaletteIndexes() );
+        _reportTime = SDL_GetTicks(); _frames = 0; _drawTime = 0;
+        COUT( "3DS native renderer ready: virtual=800x480 top=400x240 bottom=320x240 scale=1/2" )
+        return true;
+    }
+    bool isMouseCursorActive() const override { return true; }
+    void updatePalette( const std::vector<uint8_t> & ids ) override
+    {
+        if ( ids.size() != _colors.size() ) return;
+        for ( size_t i = 0; i < ids.size(); ++i ) {
+            const auto & rgb = currentRGBPalette[ids[i]];
+            _colors[i] = ( uint32_t( rgb.r ) << 24 ) | ( uint32_t( rgb.g ) << 16 ) | ( uint32_t( rgb.b ) << 8 ) | 255;
+        }
+    }
+    static void snapshot( const uint32_t * framebuffer, const int width, const char * path )
+    {
+        SDL_Surface * surface = SDL_CreateRGBSurfaceWithFormat( 0, width, 240, 32, SDL_PIXELFORMAT_RGBA8888 );
+        if ( !surface ) { ERROR_LOG( SDL_GetError() ) return; }
+        for ( int y = 0; y < 240; ++y ) {
+            auto * row = reinterpret_cast<uint32_t *>( static_cast<uint8_t *>( surface->pixels ) + y * surface->pitch );
+            for ( int x = 0; x < width; ++x ) row[x] = framebuffer[x * 240 + 239 - y];
+        }
+        if ( SDL_SaveBMP( surface, path ) < 0 ) { ERROR_LOG( SDL_GetError() ) }
+        SDL_FreeSurface( surface );
+    }
+    void render( const fheroes2::Display & display, const fheroes2::Rect & ) override
+    {
+        if ( !_top || display.empty() ) return;
+        const Uint64 begin = SDL_GetPerformanceCounter();
+        const auto & events = LocalEvent::Get();
+        const auto * panel = Platform3DS::commandPanelImage();
+        const auto * strip = Platform3DS::commandStripImage();
+        Platform3DS::followCursor( events.getMouseCursorPos(), SDL_GetTicks(),
+                                   panel || events.isMouseLeftButtonPressed() || events.isMouseRightButtonPressed() );
+        const auto crop = Platform3DS::viewport();
+        auto * top = reinterpret_cast<uint32_t *>( gfxGetFramebuffer( GFX_TOP, GFX_LEFT, nullptr, nullptr ) );
+        auto * bottom = reinterpret_cast<uint32_t *>( gfxGetFramebuffer( GFX_BOTTOM, GFX_LEFT, nullptr, nullptr ) );
+        const uint8_t * image = display.image();
+        const int frameWidth = display.width();
+        // Framebuffer columns are contiguous, stored bottom-to-top. No intermediate RGBA texture.
+        for ( int x = 0; x < 400; ++x ) {
+            uint32_t * out = top + x * 240;
+            for ( int y = 239; y >= 0; --y ) *out++ = _colors[image[y * 2 * frameWidth + x * 2]];
+        }
+        for ( int x = 0; x < 320; ++x ) {
+            uint32_t * out = bottom + x * 240;
+            for ( int y = 239; y >= 0; --y ) {
+                const uint8_t pixel = panel ? panel->image()[y * 320 + x]
+                                     : strip && y >= 200 ? strip->image()[( y - 200 ) * 320 + x]
+                                                         : image[( crop.y + y ) * frameWidth + crop.x + x];
+                *out++ = _colors[pixel];
+            }
+        }
+        const int left = crop.x / 2, right = left + 159, upper = crop.y / 2, lower = upper + Platform3DS::detailHeight() / 2 - 1;
+        const uint32_t red = 0xff3030ff;
+        for ( int x = left; x <= right; ++x ) { top[x * 240 + 239 - upper] = red; top[x * 240 + 239 - lower] = red; }
+        for ( int y = upper; y <= lower; ++y ) { top[left * 240 + 239 - y] = red; top[right * 240 + 239 - y] = red; }
+        _drawTime += 1000.0 * ( SDL_GetPerformanceCounter() - begin ) / SDL_GetPerformanceFrequency();
+        if ( Platform3DS::consumeCapture() ) {
+            snapshot( top, 400, panel || strip ? "sdmc:/3ds/fheroes2/panel-top.bmp" : "sdmc:/3ds/fheroes2/menu-top.bmp" );
+            snapshot( bottom, 320, panel || strip ? "sdmc:/3ds/fheroes2/panel-bottom.bmp" : "sdmc:/3ds/fheroes2/menu-bottom.bmp" );
+            COUT( "3DS menu snapshots saved" )
+            COUT( "3DS capture: mean_draw_ms=" << _drawTime / ( _frames + 1 ) << " used_alloc=" << mallinfo().uordblks << " linear_free=" << linearSpaceFree() )
+        }
+        gfxFlushBuffers();
+        gfxSwapBuffers();
+        gspWaitForVBlank();
+        ++_frames;
+        const Uint32 now = SDL_GetTicks();
+        if ( now - _reportTime >= 2000 ) {
+            COUT( "3DS RENDER fps=" << _frames * 1000.0 / ( now - _reportTime ) << " draw_ms=" << _drawTime / _frames
+                  << " used_alloc=" << mallinfo().uordblks << " linear_free=" << linearSpaceFree() )
+            _reportTime = now; _frames = 0; _drawTime = 0;
+        }
+    }
+};
