+void Interface3DS::testArmySplit()
+{
+    using namespace fheroes2;
+    const auto key = []( int button, bool down ) {
+        SDL_Event e{}; e.type = down ? SDL_CONTROLLERBUTTONDOWN : SDL_CONTROLLERBUTTONUP;
+        e.cbutton.button = button; e.cbutton.state = down ? SDL_PRESSED : SDL_RELEASED; return e;
+    };
+    const auto touch = []( Uint32 type, int x, int y ) {
+        SDL_Event e{}; e.type = type; e.tfinger.touchId = 1; e.tfinger.fingerId = 0;
+        e.tfinger.x = x / 320.0f; e.tfinger.y = y / 240.0f; return e;
+    };
+    const auto crop = Platform3DS::viewport(); const auto * strip = Platform3DS::commandStripImage();
+    Image frame; Copy( Display::instance(), frame );
+    const auto run = [&]( int freeSlots, int maximum, int32_t & count, bool & fast, std::vector<TimedEvent> sequence ) {
+        const int result = runInjectedInput( [&]() { return Dialog::ArmySplitTroop( freeSlots, maximum, count, fast, _( "Peasants" ) ); }, std::move( sequence ) );
+        if ( Platform3DS::viewport() != crop || Platform3DS::commandStripImage() != strip
+             || std::memcmp( frame.image(), Display::instance().image(), frame.width() * frame.height() ) != 0 )
+            throw std::runtime_error( "Army split changed frame/viewport/strip" );
+        return result;
+    };
+    int32_t count = 5; bool fast = true;
+    if ( run( 5, 10, count, fast, { { 250, key( SDL_CONTROLLER_BUTTON_A, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_A, false ) } } ) != 2 || count != 5 || !fast )
+        throw std::runtime_error( "Army fast split default differs" );
+    if ( run( 5, 10, count, fast, { { 250, touch( SDL_FINGERDOWN, 210, 178 ) }, { 80, touch( SDL_FINGERUP, 0, 0 ) },
+                                 { 80, key( SDL_CONTROLLER_BUTTON_A, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_A, false ) } } ) != 5 || !fast )
+        throw std::runtime_error( "Army fast split slots differ" );
+    if ( run( 5, 10, count, fast, { { 250, key( SDL_CONTROLLER_BUTTON_DPAD_RIGHT, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_DPAD_RIGHT, false ) },
+                                 { 80, key( SDL_CONTROLLER_BUTTON_A, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_A, false ) } } ) != 2 || count != 6 || fast )
+        throw std::runtime_error( "Army manual split count/fast-mode differs" );
+    const int savedCount = count; const bool savedFast = fast;
+    if ( run( 5, 10, count, fast, { { 250, touch( SDL_FINGERDOWN, 300, 120 ) }, { 80, touch( SDL_FINGERMOTION, 12, 120 ) }, { 80, touch( SDL_FINGERUP, 0, 0 ) },
+                                 { 80, touch( SDL_FINGERDOWN, 80, 219 ) }, { 80, touch( SDL_FINGERMOTION, 160, 120 ) }, { 80, touch( SDL_FINGERUP, 0, 0 ) },
+                                 { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } } ) != 0 || count != savedCount || fast != savedFast )
+        throw std::runtime_error( "Army split cancel/drag changed caller values" );
+    count = 0; fast = true;
+    if ( run( 1, 10, count, fast, { { 250, key( SDL_CONTROLLER_BUTTON_A, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_A, false ) } } ) != 2 || count != 1 || fast )
+        throw std::runtime_error( "Army single-slot split bounds differ" );
+    count = 0;
+    if ( run( 1, 0, count, fast, { { 250, key( SDL_CONTROLLER_BUTTON_A, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_A, false ) } } ) != 2 || count || fast )
+        throw std::runtime_error( "Army zero redistribution differs" );
+    count = 1000000000;
+    if ( run( 2, 2000000000, count, fast, { { 250, touch( SDL_FINGERDOWN, 300, 120 ) }, { 80, touch( SDL_FINGERUP, 0, 0 ) },
+                                          { 80, key( SDL_CONTROLLER_BUTTON_A, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_A, false ) } } ) != 2 || count != 2000000000 || fast )
+        throw std::runtime_error( "Army split large slider count differs" );
+    const auto previous = Settings::Get().getInterfaceType(); Settings::Get().setInterfaceType( InterfaceType::EVIL );
+    count = 5; fast = true;
+    const int evil = run( 5, 10, count, fast, { { 250, key( SDL_CONTROLLER_BUTTON_START, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_START, false ) } } );
+    Settings::Get().setInterfaceType( previous );
+    if ( evil != 2 || !fast ) throw std::runtime_error( "Army split Evil UI differs" );
+    COUT( "3DS ARMY SPLIT SMOKE: PASS actual_dialog manual_fast_slots limits slider cancel_drag large_counts evil caller_contract unchanged_context" )
+}
