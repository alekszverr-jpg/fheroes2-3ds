+    bool stripTouchCaptured = false;
+    int previousDetailHeight = 240;
+    std::deque<Platform3DS::PanelInput> panelInputs;
+    uint32_t panelControllerHeld = 0;
+    std::set<int> panelKeyboardHeld;
+    fheroes2::Size frameSize{ 800, 480 };
+    bool adventureInputActive = false;
+    uint8_t adventureDpadHeld = 0;
+    uint8_t adventureDpadCaptured = 0;
+    struct ModalImages { const fheroes2::Image * top; const fheroes2::Image * bottom; };
+    std::vector<ModalImages> modalImages;
+    bool modalTouchCaptured = false;
+}
+namespace Platform3DS
+{
+    bool supportsHighResolutionModel( const uint8_t model )
+    {
+        return model <= CFG_MODEL_N2DSXL && model != CFG_MODEL_2DS;
+    }
+    bool highResolutionSupported()
+    {
+        static const bool supported = []() {
+            if ( R_FAILED( cfguInit() ) ) return false;
+            u8 model = 255;
+            const Result result = CFGU_GetSystemModel( &model );
+            cfguExit();
+            return R_SUCCEEDED( result ) && supportsHighResolutionModel( model );
+        }();
+        return supported;
+    }
+    bool highResolutionEnabled() { return highResolution; }
+    void setHighResolutionEnabled( const bool enabled )
+    {
+        if ( highResolution == enabled ) return;
+        highResolution = enabled;
+        displayRefresh = true;
+    }
+    void setDisplayPreferenceSaveCallback( void ( *callback )() ) { saveDisplayPreference = callback; }
+    bool consumeDisplayRefresh() { const bool refresh = displayRefresh; displayRefresh = false; return refresh; }
+    bool handleDisplayController( const int button, const bool pressed )
+    {
+        // R remains the pointer-speed modifier. Capture only Start in this chord, including its release.
+        if ( button == SDL_CONTROLLER_BUTTON_RIGHTSHOULDER ) displayModifierHeld = pressed;
+        if ( button != SDL_CONTROLLER_BUTTON_START ) return false;
+        if ( !pressed ) {
+            const bool captured = displayStartCaptured;
+            displayStartCaptured = false;
+            return captured;
+        }
+        if ( displayStartCaptured ) return true;
+        if ( !displayModifierHeld ) return false;
+        displayStartCaptured = true;
+        if ( highResolutionSupported() ) {
+            setHighResolutionEnabled( !highResolution );
+            if ( saveDisplayPreference ) saveDisplayPreference();
+        }
+        return true;
+    }
+    void pushModalImages( const fheroes2::Image * top, const fheroes2::Image * bottom )
+    {
+        modalImages.push_back( { top, bottom } );
+        modalTouchCaptured = modalTouchCaptured || touchHeld || stripTouchCaptured;
+        panelInputs.clear();
+        cancelAdventureScroll();
+    }
+    void popModalImages()
+    {
