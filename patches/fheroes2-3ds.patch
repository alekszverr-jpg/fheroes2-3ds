+                Fill( top, 391, 8 + scroll * ( viewHeight - knob ) / ( content.height() - viewHeight ), 5, knob, GetColorId( 255, 225, 96 ) );
+            }
+            bottom.fill( backgroundColor() ); StandardWindow::renderBackgroundImage( bottom, { 0, 0, 320, 240 }, 0, evil );
+            Text( heading, FontType::normalYellow() ).draw( 12, 20, 296, bottom );
+            if ( content.height() > viewHeight ) {
+                const std::string hint = "D-pad: " + std::string( _( "hotkey|scroll up" ) ) + " / " + _( "hotkey|scroll down" );
+                Text( hint, FontType::smallYellow() ).draw( 12, firstY - 42, 296, bottom );
+                Text( "^  D-pad  v", FontType::smallYellow() ).draw( 12, 224, 376, top );
+                // Large direction markers remain visible even when a casualty row is clipped.
+                for ( int row = 0; row < 5; ++row ) {
+                    if ( scroll > 0 ) Fill( top, 380 - row, 9 + row, row * 2 + 1, 1, GetColorId( 255, 225, 96 ) );
+                    if ( scroll < content.height() - viewHeight ) Fill( top, 376 + row, 204 + row, 9 - row * 2, 1, GetColorId( 255, 225, 96 ) );
+                }
+            }
+            for ( size_t i = 0; i < buttons.size(); ++i ) {
+                if ( down && !moved && pressed == int( i ) ) buttons[i]->press(); else buttons[i]->release(); buttons[i]->draw( bottom );
+                if ( selected == int( i ) ) { const Rect area = buttons[i]->area(); Fill( bottom, area.x, area.y - 2, area.width, 1, GetColorId( 255, 225, 96 ) ); }
+            }
+            Display::instance().render();
+        };
+        const auto tick = [&]() {
+            if ( !animation || !animation( frame ) ) return false;
+            Image resized( 180, 108 ); resized.reset();
+            const double scale = std::min( 180.0 / frame.width(), 108.0 / frame.height() );
+            resized.resize( std::max( 1, int( frame.width() * scale ) ), std::max( 1, int( frame.height() * scale ) ) ); resized.reset(); Resize( frame, resized );
+            Fill( content, 196, 0, 180, 112, backgroundColor() ); Blit( resized, content, 196 + ( 180 - resized.width() ) / 2, 0 );
+            ++animationChanges; return true;
+        };
+        tick(); draw();
+        if ( Platform3DS::smokeTest() ) {
+            const std::string name = std::string( "sdmc:/3ds/fheroes2/" ) + capture;
+            if ( !Save( top, name + "-top.bmp" ) || !Save( bottom, name + "-bottom.bmp" ) ) throw std::runtime_error( "Cannot save battle report" );
+            if ( heading == _( "Battlefield Casualties" ) && !animation && content.height() > 300
+                 && ( !Save( top, "sdmc:/3ds/fheroes2/battle-losses-top.bmp" ) || !Save( bottom, "sdmc:/3ds/fheroes2/battle-losses-bottom.bmp" ) ) )
+                throw std::runtime_error( "Cannot save casualty layout" );
+        }
+        auto & events = LocalEvent::Get();
+        while ( !closed && events.HandleEvents() ) {
+            Platform3DS::PanelInput input; bool redraw = tick();
+            while ( !closed && Platform3DS::consumePanelInput( input ) ) {
+                redraw = true;
+                if ( input.type == PanelInputType::Key ) {
+                    switch ( input.key ) {
+                    case PanelKey::Cancel: closed = true; break;
+                    case PanelKey::Information: if ( information ) information(); else closed = true; break;
+                    case PanelKey::Confirm: if ( enabled[selected] ) { result = selected; closed = true; } break;
+                    case PanelKey::Left: selected = std::max( 0, selected - 1 ); break;
+                    case PanelKey::Right: selected = std::min( int( labels.size() ) - 1, selected + 1 ); break;
+                    case PanelKey::Up: scroll = std::max( 0, scroll - 32 ); break;
+                    case PanelKey::Down: scroll = std::min<int32_t>( std::max<int32_t>( 0, content.height() - viewHeight ), scroll + 32 ); break;
+                    default: break;
+                    }
+                }
+                else if ( input.type == PanelInputType::TouchDown ) {
+                    start = last = input.position; down = true; moved = false; pressed = -1;
+                    for ( size_t i = 0; i < buttons.size(); ++i ) if ( buttons[i]->area() & start ) { pressed = int( i ); selected = pressed; }
+                }
+                else if ( input.type == PanelInputType::TouchMove && down ) {
+                    moved = moved || std::abs( input.position.x - start.x ) >= 6 || std::abs( input.position.y - start.y ) >= 6;
+                    if ( moved && pressed < 0 ) scroll = std::clamp<int32_t>( scroll + last.y - input.position.y, 0, std::max<int32_t>( 0, content.height() - viewHeight ) );
+                    last = input.position;
+                }
+                else if ( input.type == PanelInputType::TouchUp ) {
+                    if ( down && !moved && pressed >= 0 && enabled[pressed] ) { result = pressed; closed = true; }
+                    down = false; pressed = -1;
+                }
+            }
+            if ( redraw && !closed ) draw();
+        }
+        lastScroll = scroll; return result;
+    }
+    int paragraph( Image & image, int y, const std::string & text, FontType font = FontType::normalWhite(), int width = 376, int x = 0 ) {
+        if ( text.empty() ) return y;
+        Text value( text, font ); value.draw( x, y, width, image ); return y + value.height( width ) + 8;
+    }
+    int casualties( Image & image, int y, const Troops & troops, const char * side ) {
+        y = paragraph( image, y, side, FontType::normalYellow() );
+        if ( !troops.isValid() ) return paragraph( image, y, _( "None" ) );
+        for ( size_t i = 0; i < troops.Size(); ++i ) {
+            const Troop * troop = troops.GetTroop( i ); if ( !troop || !troop->isValid() ) continue;
+            const auto & icon = Assets::getImage( ICN::MONS32, troop->GetSpriteIndex() );
+            const double scale = std::min( 36.0 / icon.width(), 32.0 / icon.height() );
+            Image resized( std::max( 1, int( icon.width() * scale ) ), std::max( 1, int( icon.height() * scale ) ) );
+            resized.reset(); Resize( icon, resized );
+            Text text( std::string( troop->GetPluralName( troop->GetCount() ) ) + ": " + std::to_string( troop->GetCount() ), FontType::normalWhite() );
+            const int rowHeight = std::max<int32_t>( 40, text.height( 304 ) );
+            Blit( resized, image, 10 + ( 36 - resized.width() ) / 2, y + ( rowHeight - resized.height() ) / 2 );
+            if ( text.width() <= 304 ) text.draw( 60, y + ( rowHeight - text.height() ) / 2, image );
+            else text.draw( 60, y, 304, image );
+            y += rowHeight + 8;
+        }
+        return y;
+    }
+}
+bool Interface3DS::showBattleSummary( const std::string & title, const std::string & body, const Troops & attacker, const Troops & defender,
+                                     const bool restart, const std::function<bool( fheroes2::Image & )> & animation )
+{
+    using namespace fheroes2;
+    Image content( 376, 2048 ); content.fill( backgroundColor() );
+    int y = std::max( 120, paragraph( content, 0, title, FontType::normalYellow(), animation ? 188 : 376 ) );
+    y = paragraph( content, y, body ); y = paragraph( content, y, _( "Battlefield Casualties" ), FontType::normalYellow() );
+    y = casualties( content, y, attacker, _( "Attacker" ) ); y = casualties( content, y, defender, _( "Defender" ) );
+    Image full( 376, std::max( 204, y ) ); Copy( content, 0, 0, full, 0, 0, 376, std::max( 204, y ) );
+    return report( full, restart ? std::vector<std::string>{ _( "Restart" ), _( "Okay" ) } : std::vector<std::string>{ _( "Okay" ) },
+                   restart ? std::vector<bool>{ true, true } : std::vector<bool>{ true }, _( "Battlefield Casualties" ), "battle-summary", animation ) == 0 && restart;
+}
+void Interface3DS::showBattleNecromancy( const uint32_t count, const std::function<bool( fheroes2::Image & )> & animation )
+{
+    using namespace fheroes2;
+    const Monster skeleton( Monster::SKELETON );
+    std::string message = _( "Practicing the dark arts of necromancy, you are able to raise %{count} of the enemy's dead to return under your service as %{monster}." );
+    StringReplace( message, "%{count}", count ); StringReplace( message, "%{monster}", skeleton.GetPluralName( count ) );
+    const Text title( _( "Necromancy!" ), FontType::normalYellow() ), body( message, FontType::normalWhite() );
+    const int textY = title.height( 184 ) + 8;
+    Image content( 376, std::max<int32_t>( 204, textY + body.height( 184 ) + 8 ) ); content.fill( backgroundColor() );
+    title.draw( 0, 0, 184, content ); body.draw( 0, textY, 184, content );
+    const auto & icon = Assets::getImage( ICN::MONS32, skeleton.GetSpriteIndex() );
+    Blit( icon, content, 286 - icon.width() / 2, 128 );
+    Text( std::to_string( count ), FontType::normalWhite() ).draw( 196, 168, 180, content );
+    const auto initialAnimationChanges = animationChanges;
+    report( content, { _( "Okay" ) }, { true }, _( "Necromancy!" ), "battle-necromancy", animation );
+    if ( Platform3DS::smokeTest() && animation && animationChanges - initialAnimationChanges < 2 )
+        throw std::runtime_error( "Necromancy animation did not advance" );
