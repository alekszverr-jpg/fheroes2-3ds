+void Interface3DS::testSystemExit()
+{
+    struct Restore {
+        ~Restore() { Platform3DS::resetSystemExitForTest(); Game::initEventHandler(); }
+    } restore;
+    auto & events = LocalEvent::Get(); int confirmations = 0;
+    events.setQuitEventProcessingHook( [&]() { ++confirmations; return true; } );
+    const auto top = Platform3DS::modalTopImage(), bottom = Platform3DS::modalBottomImage();
+    Image upper( 400, 240 ), lower( 320, 240 ); upper.fill( 0 ); lower.fill( 0 );
+    for ( int attempt = 0; attempt < 3; ++attempt ) {
+        bool caught = false;
+        try {
+            const GuildScope scope( upper, lower );
+            Platform3DS::requestSystemExit(); SDL_Event quit{}; quit.type = SDL_QUIT;
+            if ( SDL_PushEvent( &quit ) != 1 ) throw std::runtime_error( "Cannot push system quit" );
+            // LocalEvent processes at most one immediate event per pump; drain prior window events.
+            for ( int pump = 0; pump < 40 && !caught; ++pump ) {
+                if ( !events.HandleEvents( false, attempt == 2 ) ) caught = true;
+            }
+        }
+        catch ( const fheroes2::UserRequestedApplicationClosure & ) { caught = true; }
+        if ( !caught || confirmations || Platform3DS::modalTopImage() != top || Platform3DS::modalBottomImage() != bottom ) throw std::runtime_error( "System close confirmed recursively or leaked modal" );
+        Platform3DS::resetSystemExitForTest();
+    }
+    SDL_Event quit{}; quit.type = SDL_QUIT; SDL_PushEvent( &quit ); bool caught = false;
+    try { for ( int pump = 0; pump < 40; ++pump ) events.HandleEvents( false ); } catch ( const fheroes2::UserRequestedApplicationClosure & ) { caught = true; }
+    if ( !caught || confirmations != 1 ) throw std::runtime_error( "Ordinary SDL quit lost confirmation hook" );
+    COUT( "3DS SYSTEM EXIT SMOKE: PASS repeated_system_quit no_confirmation allowExit nested_modal_unwind render_suppression ordinary_quit_hook_preserved" )
+}
