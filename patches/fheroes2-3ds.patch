+                switch ( input.key ) {
+                case PanelKey::Toggle: changeFilter( filter == SpellBook::Filter::ADVN ? SpellBook::Filter::CMBT : SpellBook::Filter::ADVN ); break;
+                case PanelKey::Cancel: closed = true; break;
+                case PanelKey::Confirm: activate( 2 ); break;
+                case PanelKey::Left: changePage( -1 ); break;
+                case PanelKey::Right: changePage( 1 ); break;
+                case PanelKey::Up: case PanelKey::Down:
