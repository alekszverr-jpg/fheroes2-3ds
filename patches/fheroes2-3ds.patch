+    // Dispatch native taps through the original widget actions, without forging game mouse events.
+    // Selection outlines are drawn in the lower image; MovableSprite cursors must not touch the game frame.
+    template<class Bar> class NativeBar : public Bar
+    {
+    public:
+        using Bar::Bar;
+        void hold( Point point )
+        {
+            const auto item = this->GetItemIterPos( point );
+            if ( item.first == this->items.end() ) return;
+            this->ResetSelected();
+            this->ActionBarRightMouseHold( **item.first );
+        }
+        void activate( Point point, bool information = false, bool split = false )
+        {
+            const auto item = this->GetItemIterPos( point );
+            if ( item.first == this->items.end() ) return;
+            if ( split ) {
+                if ( this->isSelected() && item.first != this->curItemPos.first ) this->ActionBarRightMouseSingleClick( **item.first );
+                return;
+            }
+            if ( information || item.first == this->curItemPos.first ) {
+                this->curItemPos = item;
+                this->ActionBarLeftMouseDoubleClick( **item.first );
+            }
+            else if ( this->ActionBarLeftMouseSingleClick( **item.first ) ) this->curItemPos = item;
+            else this->ResetSelected();
+        }
+    };
+    Point center( const Rect & area ) { return { area.x + area.width / 2, area.y + area.height / 2 }; }
+    void icon( const Image & sprite, Image & target, const Rect & area )
+    {
+        const double scale = std::min( double( area.width ) / sprite.width(), double( area.height ) / sprite.height() );
+        Image scaled( std::max( 1, int( sprite.width() * scale ) ), std::max( 1, int( sprite.height() * scale ) ) ); scaled.reset(); Resize( sprite, scaled );
+        Blit( scaled, target, area.x + ( area.width - scaled.width() ) / 2, area.y + ( area.height - scaled.height() ) / 2 );
+    }
+}
+int Interface3DS::showHero( Heroes & hero, const bool readonly, const bool disableDismiss, const bool disableSwitch, const SupportedLanguage language )
