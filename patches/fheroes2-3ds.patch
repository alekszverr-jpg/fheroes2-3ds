+    const bool canSwitch = !readonly && !disableSwitch && hero.GetKingdom().GetHeroes().size() >= 2;
+    NativeBar<ArmyBar> army( &hero.GetArmy(), false, readonly );
+    army.setTableSize( { 5, 1 } ); army.setSingleItemSize( { 56, 60 } ); army.setInBetweenItemsOffset( { 4, 0 } ); army.setRenderingOffset( { 12, 55 } );
+    NativeBar<ArtifactsBar> artifacts( &hero, true, readonly, false, true, nullptr );
+    artifacts.SetContent( hero.GetBagArtifacts() ); artifacts.setTableSize( { 7, 2 } ); artifacts.setSingleItemSize( { 40, 54 } ); artifacts.setInBetweenItemsOffset( { 2, 4 } ); artifacts.setRenderingOffset( { 12, 55 } );
+    const std::array<int, 4> primary{ Skill::Primary::ATTACK, Skill::Primary::DEFENSE, Skill::Primary::POWER, Skill::Primary::KNOWLEDGE };
+    Image top( 400, 240 ), bottom( 320, 240 );
+    const HeroScope scope( top, bottom );
+    int tab = 0, focus = 3, pressed = -1, result = Dialog::CANCEL;
+    bool down = false, moved = false, closed = false, splitting = false; Point start; uint32_t began = 0;
+    std::vector<Rect> areas; std::vector<std::unique_ptr<ButtonBase>> buttons;
+    int itemCount = 5, dockStart = 8, footerStart = 11;
+    const auto cellCount = [&]() { return tab == 0 ? 5 : tab == 1 ? 14 : 12; };
+    const auto makeButton = [&]( const std::string & label, int x, int y, int width ) {
+        Sprite released, pressedImage;
+        makeButtonSprites( released, pressedImage, "", { width - 10, 22 }, evil, evil ? ICN::STONEBAK_EVIL : ICN::STONEBAK );
+        Text text( label, FontType::normalWhite() ); if ( text.width() > width - 12 ) text.set( label, FontType::smallWhite() );
+        text.fitToOneRow( width - 12 );
+        const auto textArea = text.area();
