+    }
+    Image content( elementWidth, std::max( height, viewHeight ) );
+    if ( classicFrame ) Interface3DS::fillClassicPanelPaper( content, Settings::Get().isEvilInterfaceEnabled() );
+    else content.fill( background );
+    const int textTop = classicConfirmation ? std::max( 0, ( viewHeight - height ) / 2 ) : 0;
+    if ( classicIllustrated ) { for ( auto & offset : offsets ) offset.y += textTop; }
+    else { header.draw( 0, textTop, width, content ); body.draw( 0, textTop + headerHeight, width, content ); }
+    if ( !choice ) for ( size_t i = 0; i < elements.size(); ++i ) elements[i]->draw( content, offsets[i] );
+    else for ( size_t i = 0; i < elements.size(); ++i )
+        offsets[i] = { ( classicChoice ? choiceCentre( i ) : 80 + int( i ) * 160 ) - elements[i]->area().width / 2, classicChoice ? 50 : 8 + viewHeight + 12 };
