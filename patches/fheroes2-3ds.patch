+        }
+        Text( "x" + std::to_string( recipientCount ) + "    D-pad: < >   A   L    ^ + / v -", FontType::smallWhite() ).draw( 12, 220, 376, top );
+        Text( _( "Select Recipients" ), FontType::smallYellow() ).draw( 12, 10, 296, bottom );
+        for ( int i = 0; i < colorCount; ++i ) {
+            const auto & area = areas[i]; const auto & flag = Assets::getImage( ICN::CELLWIN, 43 + Color::GetIndex( colors[i] ) );
+            Blit( flag, bottom, area.x + ( area.width - flag.width() ) / 2, area.y + ( area.height - flag.height() ) / 2 );
+            if ( choice.recipients & colors[i] ) Fill( bottom, area.x, area.y + area.height - 1, area.width, 2, GetColorId( 255, 225, 96 ) );
