+void Interface3DS::testCastleStereo()
+{
+    using namespace fheroes2;
+    struct RestoreStereo {
+        bool preference = Platform3DS::highResolutionEnabled();
+        ~RestoreStereo() { Platform3DS::setStereoTestStrength( -1 ); Platform3DS::setHighResolutionEnabled( preference ); Display::instance().render(); }
+    } restore;
+    auto & display = Display::instance(); const ImageRestorer restoreFrame( display );
+    const auto parentTop = Platform3DS::modalTopImage(), parentBottom = Platform3DS::modalBottomImage(), parentRight = Platform3DS::modalRightImage();
+    if ( !Platform3DS::supportsStereoModel( 0 ) || !Platform3DS::supportsStereoModel( 1 ) || !Platform3DS::supportsStereoModel( 2 )
+         || !Platform3DS::supportsStereoModel( 4 ) || Platform3DS::supportsStereoModel( 3 ) || Platform3DS::supportsStereoModel( 5 ) || Platform3DS::supportsStereoModel( 255 ) ) throw std::runtime_error( "Stereo model gating differs" );
+    Image left( 400, 160 ), right( 400, 160 ); left.reset(); right.reset();
+    Maps::Map_Format::CastleMetadata metadata; metadata.customBuildings = true; metadata.customName = _( "construction3DS|Castle" );
+    metadata.builtBuildings = { BUILD_CASTLE, DWELLING_MONSTER1, BUILD_MAGEGUILD1, BUILD_CAPTAIN, BUILD_STATUE, BUILD_WELL, BUILD_MARKETPLACE };
+    const std::vector<uint8_t> before( display.image(), display.image() + display.width() * display.height() );
+    for ( int race : { Race::KNGT, Race::BARB, Race::SORC, Race::WRLK, Race::WZRD, Race::NECR } ) {
+        Castle castle( 0, 0, race ); castle.SetColor( PlayerColor::BLUE ); castle.loadFromResurrectionMap( metadata );
+        const CastleDialog::BuildingsRenderQueue queue( castle, { 80, 0 } ); CastleDialog::FadeBuilding fade;
+        CastleDialog::redrawStereoPanorama( castle, { 80, 0 }, queue, fade, 2, 0, left, right );
+        if ( std::memcmp( left.image(), right.image(), 400 * 160 ) ) throw std::runtime_error( "Zero stereo disparity differs" );
+        CastleDialog::redrawAllBuildings( castle, { 80, 0 }, queue, fade, 2 );
+        Image flat( 640, 256 ), expected( 400, 160 ); flat._disableTransformLayer(); expected.reset();
+        Copy( display, 80, 0, flat, 0, 0, 640, 256 ); Resize( flat, expected );
+        if ( std::memcmp( left.image(), expected.image(), 400 * 160 ) ) throw std::runtime_error( "Zero stereo differs from original town" );
+        std::memcpy( display.image(), before.data(), before.size() );
+        CastleDialog::redrawStereoPanorama( castle, { 80, 0 }, queue, fade, 2, 4, left, right );
+        if ( !std::memcmp( left.image(), right.image(), 400 * 160 ) || std::memcmp( before.data(), display.image(), before.size() ) ) throw std::runtime_error( "Stereo eyes match or game frame changed" );
+        if ( race == Race::KNGT ) {
+            Image topLeft( 400, 240 ), topRight( 400, 240 ), bottom( 320, 240 ); topLeft.fill( 0 ); topRight.fill( 0 ); bottom.fill( 0 );
+            Blit( left, topLeft, 0, 28 ); Blit( right, topRight, 0, 28 );
+            Save( topLeft, "sdmc:/3ds/fheroes2/castle-stereo-left.bmp" ); Save( topRight, "sdmc:/3ds/fheroes2/castle-stereo-right.bmp" );
+            Platform3DS::setHighResolutionEnabled( true ); Platform3DS::setStereoTestStrength( 4 );
+            Platform3DS::pushModalImages( &topLeft, &bottom, &topRight ); Platform3DS::requestCapture(); display.render();
+            if ( !gfxIs3D() || gfxIsWide() ) throw std::runtime_error( "Stereo did not replace wide output" );
+            Platform3DS::pushModalImages( &topLeft, nullptr ); display.render();
+            if ( gfxIs3D() || !gfxIsWide() || Platform3DS::modalRightImage() ) throw std::runtime_error( "Child information dialog inherited stereo" );
+            Platform3DS::popModalImages(); display.render();
+            if ( !gfxIs3D() ) throw std::runtime_error( "Stereo did not resume after child" );
+            Platform3DS::setStereoTestStrength( 0 ); display.render();
+            if ( gfxIs3D() || !gfxIsWide() ) throw std::runtime_error( "Slider zero did not restore wide" );
+            Platform3DS::setHighResolutionEnabled( false ); display.render();
+            if ( gfxIsWide() || gfxIs3D() ) throw std::runtime_error( "Standard 2D restore failed" );
+            Platform3DS::setStereoTestStrength( 2 ); display.render();
+            if ( !gfxIs3D() || gfxIsWide() ) throw std::runtime_error( "Stereo from standard mode failed" );
+            Platform3DS::popModalImages(); display.render();
+            if ( gfxIs3D() || gfxIsWide() ) throw std::runtime_error( "Stereo leaked outside town" );
+        }
+    }
+    // Exercise the actual native main view, including a child building selector.
+    Castle castle( 0, 0, Race::KNGT ); castle.SetColor( PlayerColor::BLUE ); castle.loadFromResurrectionMap( metadata );
+    std::vector<SDL_Event> events;
+    for ( int button : { SDL_CONTROLLER_BUTTON_Y, SDL_CONTROLLER_BUTTON_DPAD_RIGHT, SDL_CONTROLLER_BUTTON_DPAD_RIGHT, SDL_CONTROLLER_BUTTON_DPAD_RIGHT, SDL_CONTROLLER_BUTTON_A, SDL_CONTROLLER_BUTTON_LEFTSHOULDER, SDL_CONTROLLER_BUTTON_LEFTSHOULDER } ) {
+        SDL_Event event{}; event.type = SDL_CONTROLLERBUTTONDOWN; event.cbutton.button = button; event.cbutton.state = SDL_PRESSED; events.push_back( event );
+        event.type = SDL_CONTROLLERBUTTONUP; event.cbutton.state = SDL_RELEASED; events.push_back( event );
+    }
+    Platform3DS::setStereoTestStrength( 3 );
+    SDL_Thread * worker = SDL_CreateThread( []( void * data ) -> int { for ( auto & event : *static_cast<std::vector<SDL_Event> *>( data ) ) { SDL_Delay( 250 ); if ( SDL_PushEvent( &event ) != 1 ) return 1; } return 0; }, "castle-stereo", &events );
+    if ( !worker ) throw std::runtime_error( "Cannot start stereo input" );
+    int status = 0;
+    try { if ( castle.OpenDialog( false, false, false, true ) != Castle::CastleDialogReturnValue::Close ) throw std::runtime_error( "Stereo castle failed to close" ); }
+    catch ( ... ) { SDL_WaitThread( worker, &status ); throw; }
+    SDL_WaitThread( worker, &status ); LocalEvent::Get().HandleEvents( false, true );
+    if ( status || Platform3DS::modalTopImage() != parentTop || Platform3DS::modalBottomImage() != parentBottom || Platform3DS::modalRightImage() != parentRight
+         || LocalEvent::Get().MouseClickLeft() || LocalEvent::Get().MouseClickRight() || gfxIs3D() ) throw std::runtime_error( "Stereo main context/input leaked" );
+    COUT( "3DS CASTLE STEREO SMOKE: PASS six_races original_zero_disparity distinct_eyes game_frame_restored real_left_right_framebuffers wide_standard_slider_restore child_flat_and_resume main_castle_Y_return model_2DS_exclusion" )
+}
