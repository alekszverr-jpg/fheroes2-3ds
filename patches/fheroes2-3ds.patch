+        throw std::runtime_error( "Cannot save hero recruitment dialog" );
+    auto & events = LocalEvent::Get();
+    while ( events.HandleEvents() ) {
+        bool redraw = false; Platform3DS::PanelInput input;
+        while ( Platform3DS::consumePanelInput( input ) ) {
+            redraw = true;
+            if ( input.type == Platform3DS::PanelInputType::Key ) {
+                switch ( input.key ) {
+                case Platform3DS::PanelKey::Cancel: return Dialog::CANCEL;
+                case Platform3DS::PanelKey::Left: case Platform3DS::PanelKey::Right: selected = 1 - selected; break;
+                case Platform3DS::PanelKey::Up: scroll -= 32; break;
+                case Platform3DS::PanelKey::Down: scroll += 32; break;
+                case Platform3DS::PanelKey::Confirm: if ( selected ) return Dialog::CANCEL; if ( castle.AllowBuyHero() ) return Dialog::OK; break;
+                case Platform3DS::PanelKey::Information: information(); break;
+                default: break;
+                }
+            }
+            else if ( input.type == Platform3DS::PanelInputType::TouchDown ) {
+                down = true; moved = false; pressed = -1; start = last = input.position; began = SDL_GetTicks();
+                for ( size_t i = 0; i < buttons.size(); ++i ) if ( buttons[i]->area() & start ) selected = pressed = int( i );
+            }
+            else if ( input.type == Platform3DS::PanelInputType::TouchMove && down ) {
+                moved = moved || std::abs( input.position.x - start.x ) >= 6 || std::abs( input.position.y - start.y ) >= 6;
+                if ( moved && pressed < 0 ) scroll += last.y - input.position.y;
+                last = input.position;
+            }
+            else if ( input.type == Platform3DS::PanelInputType::TouchUp ) {
+                if ( down && !moved && pressed >= 0 && ( buttons[pressed]->area() & last ) ) {
+                    if ( pressed ) return Dialog::CANCEL;
+                    if ( castle.AllowBuyHero() ) return Dialog::OK;
+                }
+                down = false; pressed = -1;
+            }
+            scroll = std::clamp<int32_t>( scroll, 0, content.height() - 188 );
+        }
+        if ( down && !moved && pressed >= 0 && SDL_GetTicks() - began >= 550 ) {
+            const bool cancel = pressed == 1; down = false; pressed = -1;
+            if ( cancel ) showStandardTextMessage( _( "Cancel" ), _( "Exit this menu without doing anything." ), Dialog::ZERO ); else information();
+            redraw = true;
+        }
+        if ( redraw ) draw();
+    }
+    return Dialog::CANCEL;
+}
+void Interface3DS::testHeroRecruit()
+{
+    using Step = std::pair<Uint32, SDL_Event>;
+    const auto key = []( int button, bool down ) { SDL_Event e{}; e.type = down ? SDL_CONTROLLERBUTTONDOWN : SDL_CONTROLLERBUTTONUP; e.cbutton.button = button; e.cbutton.state = down ? SDL_PRESSED : SDL_RELEASED; return e; };
+    const auto touch = []( Uint32 type, int x, int y ) { SDL_Event e{}; e.type = type; e.tfinger.touchId = 1; e.tfinger.fingerId = 0; e.tfinger.x = x / 320.0f; e.tfinger.y = y / 240.0f; return e; };
+    Castle castle( 0, 0, Race::KNGT ); castle.SetColor( PlayerColor::BLUE );
+    Heroes hero( Heroes::LORDKILBURN, Race::KNGT );
+    auto & kingdom = castle.GetKingdom();
+    struct Restore {
+        Kingdom & kingdom; Funds funds; VecHeroes heroes;
+        ~Restore() { kingdom.OddFundsResource( kingdom.GetFunds() ); kingdom.AddFundsResource( funds ); kingdom.GetHeroes() = heroes; }
+    } restore{ kingdom, kingdom.GetFunds(), kingdom.GetHeroes() };
+    kingdom.GetHeroes().clear(); kingdom.OddFundsResource( kingdom.GetFunds() ); kingdom.AddFundsResource( Funds( Resource::GOLD, 10000 ) );
+    const auto run = [&]( const std::function<int()> & dialog, std::vector<Step> steps ) {
+        auto & display = Display::instance(); const auto crop = Platform3DS::viewport(); const auto strip = Platform3DS::commandStripImage(); const auto hud = Platform3DS::battleHUDImage();
+        const auto parentTop = Platform3DS::modalTopImage(); const auto parentBottom = Platform3DS::modalBottomImage();
+        const Funds funds = kingdom.GetFunds(); const auto heroes = kingdom.GetHeroes();
+        const std::vector<uint8_t> pixels( display.image(), display.image() + display.width() * display.height() );
+        SDL_Thread * worker = SDL_CreateThread( []( void * data ) -> int { for ( auto & step : *static_cast<std::vector<Step> *>( data ) ) { SDL_Delay( step.first ); if ( SDL_PushEvent( &step.second ) != 1 ) return 1; } return 0; }, "hero-recruit-smoke", &steps );
+        if ( !worker ) throw std::runtime_error( "Cannot start hero recruitment input" );
+        int result = Dialog::CANCEL, status = 0;
+        try { result = dialog(); } catch ( ... ) { SDL_WaitThread( worker, &status ); throw; }
+        SDL_WaitThread( worker, &status ); LocalEvent::Get().HandleEvents( false, true );
+        if ( status || crop != Platform3DS::viewport() || strip != Platform3DS::commandStripImage() || hud != Platform3DS::battleHUDImage()
+             || parentTop != Platform3DS::modalTopImage() || parentBottom != Platform3DS::modalBottomImage()
+             || std::memcmp( pixels.data(), display.image(), pixels.size() ) || !( funds == kingdom.GetFunds() ) || heroes != kingdom.GetHeroes()
+             || LocalEvent::Get().MouseClickLeft() || LocalEvent::Get().MouseClickRight() ) throw std::runtime_error( "Hero recruitment changed funds/heroes/frame/context or leaked input" );
+        return result;
+    };
+    const auto dialog = [&]() { return castle.DialogBuyHero( &hero ); };
+    const std::vector<Step> cancel{ { 250, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } };
+    if ( castle.DialogBuyHero( nullptr ) != Dialog::CANCEL || !castle.AllowBuyHero() ) throw std::runtime_error( "Hero recruitment fixture unavailable" );
+    if ( run( dialog, { { 250, key( SDL_CONTROLLER_BUTTON_A, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_A, false ) } } ) != Dialog::CANCEL ) throw std::runtime_error( "Hero recruitment default accepted" );
+    if ( run( dialog, { { 250, touch( SDL_FINGERDOWN, 80, 220 ) }, { 80, touch( SDL_FINGERUP, 80, 220 ) } } ) != Dialog::OK ) throw std::runtime_error( "Hero recruitment allowed touch rejected" );
+    if ( run( dialog, { { 250, key( SDL_CONTROLLER_BUTTON_DPAD_LEFT, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_DPAD_LEFT, false ) }, { 100, key( SDL_CONTROLLER_BUTTON_A, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_A, false ) } } ) != Dialog::OK ) throw std::runtime_error( "Hero recruitment controller rejected" );
+    kingdom.OddFundsResource( kingdom.GetFunds() );
+    if ( run( dialog, { { 250, touch( SDL_FINGERDOWN, 80, 220 ) }, { 80, touch( SDL_FINGERUP, 80, 220 ) }, { 150, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } } ) != Dialog::CANCEL ) throw std::runtime_error( "Hero recruitment unaffordable accepted" );
+    if ( run( dialog, { { 250, key( SDL_CONTROLLER_BUTTON_DPAD_LEFT, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_DPAD_LEFT, false ) }, { 100, key( SDL_CONTROLLER_BUTTON_A, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_A, false ) }, { 150, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } } ) != Dialog::CANCEL ) throw std::runtime_error( "Hero recruitment disabled controller accepted" );
+    kingdom.AddFundsResource( Funds( Resource::GOLD, 10000 ) );
+    kingdom.GetHeroes().assign( Kingdom::GetMaxHeroes(), &hero );
+    if ( castle.AllowBuyHero() || run( dialog, cancel ) != Dialog::CANCEL ) throw std::runtime_error( "Hero limit ignored" );
+    kingdom.GetHeroes().clear();
+    if ( run( dialog, { { 250, touch( SDL_FINGERDOWN, 80, 220 ) }, { 80, touch( SDL_FINGERMOTION, 80, 170 ) }, { 80, touch( SDL_FINGERUP, 80, 170 ) }, { 150, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } } ) != Dialog::CANCEL ) throw std::runtime_error( "Hero recruitment drag accepted" );
+    if ( run( dialog, { { 250, touch( SDL_FINGERDOWN, 80, 220 ) }, { 900, touch( SDL_FINGERUP, 80, 220 ) }, { 150, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } } ) != Dialog::CANCEL ) throw std::runtime_error( "Held recruitment accepted" );
+    if ( run( dialog, { { 250, key( SDL_CONTROLLER_BUTTON_B, true ) }, { 150, key( SDL_CONTROLLER_BUTTON_B, false ) }, { 150, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } } ) != Dialog::CANCEL ) throw std::runtime_error( "Recruitment nested information accepted" );
+    if ( run( [&]() { return showHeroRecruit( castle, hero, std::string( 1200, 'W' ) ); }, { { 250, touch( SDL_FINGERDOWN, 150, 170 ) }, { 80, touch( SDL_FINGERMOTION, 150, 50 ) }, { 80, touch( SDL_FINGERUP, 150, 50 ) }, { 150, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } } ) != Dialog::CANCEL || lastRecruitScroll <= 0 ) throw std::runtime_error( "Hero recruitment description did not scroll" );
+    const auto previous = Settings::Get().getInterfaceType(); Settings::Get().setInterfaceType( InterfaceType::EVIL );
+    Image parentTop( 400, 240 ), parentBottom( 320, 240 ); parentTop.fill( 0 ); parentBottom.fill( 0 ); Platform3DS::pushModalImages( &parentTop, &parentBottom );
+    const int evilResult = run( dialog, cancel ); Platform3DS::popModalImages(); Settings::Get().setInterfaceType( previous );
+    if ( evilResult != Dialog::CANCEL || run( dialog, cancel ) != Dialog::CANCEL ) throw std::runtime_error( "Hero recruitment nested cancel differs" );
+    COUT( "3DS HERO RECRUIT SMOKE: PASS actual_entry allowed_touch_controller default_cancel null_hero unaffordable_touch_controller hero_limit drag_cancel held_info nested_info stylus_scroll evil unchanged_funds_heroes_frame_context release_isolation" )
+}
+#endif
