+        makeButtonSprites( released, pressed, "", { width, 22 }, evil, evil ? ICN::STONEBAK_EVIL : ICN::STONEBAK );
+        Text label( labels[i], FontType::normalWhite() );
+        if ( label.width() > width - 4 ) label.set( labels[i], FontType::smallWhite() );
+        const auto textArea = label.area();
+        label.draw( ( released.width() - textArea.width ) / 2 - textArea.x, ( released.height() - textArea.height ) / 2 - textArea.y, released );
+        label.draw( ( pressed.width() - textArea.width ) / 2 - textArea.x - 1, ( pressed.height() - textArea.height ) / 2 - textArea.y + 1, pressed );
