+int Interface3DS::showArmySplit( const int32_t freeSlots, const int32_t maximum, int32_t & count, bool & fast, const std::string & name )
+{
+    using namespace fheroes2;
+    const CursorRestorer cursorRestorer( false );
+    Image window( 320, 240 );
+    const bool evil = Settings::Get().isEvilInterfaceEnabled();
+    const uint8_t border = GetColorId( 150, 115, 63 );
+    const int minimum = std::min<int32_t>( 1, maximum );
+    int value = std::clamp<int32_t>( count, minimum, maximum );
+    int slots = fast && freeSlots > 1 ? 2 : 0;
+    const std::array<std::string, 6> labels{ "MIN", "-", "+", "MAX", _( "Okay" ), _( "Cancel" ) };
+    const std::array<Point, 6> positions{ Point{ 12, 72 }, { 66, 72 }, { 224, 72 }, { 264, 72 }, { 12, 204 }, { 172, 204 } };
+    std::vector<std::unique_ptr<ButtonBase>> buttons;
+    for ( int i = 0; i < 6 + freeSlots - 1; ++i ) {
+        Sprite released, pressed;
+        const Size size{ i >= 4 && i < 6 ? 130 : i == 1 || i == 2 ? 24 : 40, 26 };
+        makeButtonSprites( released, pressed, "", size, evil, evil ? ICN::STONEBAK_EVIL : ICN::STONEBAK );
+        const std::string label = i < 6 ? labels[i] : std::to_string( i - 4 );
+        const Text text( label, i >= 4 && i < 6 ? FontType::normalWhite() : FontType::smallWhite() );
+        text.draw( 4, ( released.height() - text.height( released.width() - 8 ) ) / 2, released.width() - 8, released );
+        text.draw( 3, ( pressed.height() - text.height( pressed.width() - 8 ) ) / 2 + 1, pressed.width() - 8, pressed );
+        const Point position = i < 6 ? positions[i] : Point{ 12 + ( i - 6 ) * 60, 164 };
+        buttons.emplace_back( std::make_unique<ButtonSprite>( position.x, position.y, std::move( released ), std::move( pressed ) ) );
+    }
+    const Rect slider{ 12, 112, 296, 22 };
+    bool down = false, moved = false, sliding = false, closed = false, accepted = false;
+    Point start, last;
+    int pressed = -1;
+    const ModalScope scope( window, false );
+    const auto draw = [&]() {
+        window.fill( GetColorId( 35, 29, 24 ) );
+        StandardWindow::renderBackgroundImage( window, { 0, 0, 320, 240 }, 0, evil );
+        DrawBorder( window, border );
+        const Text title( name, FontType::normalYellow() );
+        Text( name, title.height( 296 ) <= 26 ? FontType::normalYellow() : FontType::smallYellow() ).draw( 12, 8, 296, window );
+        Text( _( "How many creatures do you wish to move?" ), FontType::smallWhite() ).draw( 12, 38, 296, window );
+        const std::string quantity = std::to_string( value ) + "/" + std::to_string( maximum );
+        const Text number( quantity, FontType::normalWhite() );
+        if ( number.width() <= 120 ) number.draw( 100, 79, 120, window );
+        else {
+            Text( std::to_string( value ), FontType::smallWhite() ).draw( 100, 72, 120, window );
+            Text( "/" + std::to_string( maximum ), FontType::smallWhite() ).draw( 100, 87, 120, window );
+        }
+        Fill( window, 12, 120, 296, 4, GetColorId( 50, 40, 30 ) );
+        const int thumb = maximum > minimum ? int( int64_t( value - minimum ) * 288 / ( maximum - minimum ) ) : 0;
+        Fill( window, 12 + thumb, 114, 8, 16, border );
+        if ( freeSlots > 1 ) Text( _( "Select how many units to separate into:" ), FontType::smallWhite() ).draw( 12, 138, 296, window );
+        for ( size_t i = 0; i < buttons.size(); ++i ) {
+            if ( down && !moved && pressed == int( i ) ) buttons[i]->press(); else buttons[i]->release();
+            buttons[i]->draw( window );
+            if ( int( i ) >= 6 && slots == int( i ) - 4 ) {
+                const Rect area = buttons[i]->area();
+                Fill( window, area.x, area.y + area.height + 1, area.width, 2, border );
+            }
+        }
+        if ( !slots ) Fill( window, 104, 105, 112, 2, border );
+        Display::instance().render();
+    };
+    const auto activate = [&]( int action ) {
+        if ( action < 4 ) {
+            const int before = value;
+            if ( action == 0 ) value = minimum;
+            else if ( action == 1 && value > minimum ) --value;
+            else if ( action == 2 && value < maximum ) ++value;
+            else if ( action == 3 ) value = maximum;
+            if ( value != before || action == 0 || action == 3 ) slots = 0;
+        }
+        else if ( action == 4 ) { accepted = true; closed = true; }
+        else if ( action == 5 ) closed = true;
+        else slots = action - 4;
+    };
+    const auto slide = [&]( Point point ) {
+        value = minimum + int( int64_t( std::clamp<int32_t>( point.x - 12, 0, 288 ) ) * ( maximum - minimum ) / 288 );
+        slots = 0;
+    };
+    draw();
+    if ( Platform3DS::smokeTest() && !Save( window, "sdmc:/3ds/fheroes2/army-split-bottom.bmp" ) ) throw std::runtime_error( "Cannot save army split screenshot" );
+    auto & events = LocalEvent::Get();
+    while ( !closed && events.HandleEvents() ) {
+        Platform3DS::PanelInput input;
+        bool redraw = false;
+        while ( !closed && Platform3DS::consumePanelInput( input ) ) {
+            redraw = true;
+            if ( input.type == PanelInputType::Key ) {
+                switch ( input.key ) {
+                case PanelKey::Left: activate( 1 ); break;
+                case PanelKey::Right: activate( 2 ); break;
+                case PanelKey::Up: activate( 3 ); break;
+                case PanelKey::Down: activate( 0 ); break;
+                case PanelKey::Confirm: activate( 4 ); break;
+                case PanelKey::Cancel: activate( 5 ); break;
+                case PanelKey::Information: break;
+                }
+            }
+            else if ( input.type == PanelInputType::TouchDown ) {
+                start = last = input.position; down = true; moved = false; sliding = slider & start; pressed = -1;
+                if ( sliding ) slide( last );
+                else for ( size_t i = 0; i < buttons.size(); ++i ) if ( buttons[i]->area() & start ) pressed = int( i );
+            }
+            else if ( input.type == PanelInputType::TouchMove && down ) {
+                last = input.position;
+                moved = moved || std::abs( last.x - start.x ) >= 6 || std::abs( last.y - start.y ) >= 6;
+                if ( sliding ) slide( last );
+            }
+            else if ( input.type == PanelInputType::TouchUp && down ) {
+                if ( !moved && !sliding && pressed >= 0 && ( buttons[pressed]->area() & last ) ) activate( pressed );
+                down = false; sliding = false; pressed = -1;
+            }
+        }
+        if ( redraw && !closed ) draw();
+    }
+    if ( !accepted ) return 0;
+    count = value; fast = slots != 0;
+    return slots ? slots : 2;
+}
