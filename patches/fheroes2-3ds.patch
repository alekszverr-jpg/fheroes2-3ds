+    };
+    if ( run( none, none, { { 300, controller( SDL_CONTROLLER_BUTTON_A, true ) }, { 100, controller( SDL_CONTROLLER_BUTTON_A, false ) } } ) != Skill::Secondary::UNKNOWN )
