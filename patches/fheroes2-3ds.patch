+            amount.draw( area.x, area.y + 26, 38, bottom );
+            if ( selected == i ) Fill( bottom, area.x, area.y + 39, 38, 2, GetColorId( 255, 225, 96 ) );
+        }
+        Text( std::to_string( choice.funds.Get( resources[selected] ) ) + " / " + std::to_string( maximum() ), FontType::normalWhite() ).draw( 12, 132, 296, bottom );
