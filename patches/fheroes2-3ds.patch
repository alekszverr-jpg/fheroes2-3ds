diff --git a/src/engine/screen_3ds.h b/src/engine/screen_3ds.h
new file mode 100644
index 0000000..7bc2313
--- /dev/null
+++ b/src/engine/screen_3ds.h
@@ -0,0 +1,251 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Included inside screen.cpp's anonymous namespace after currentRGBPalette.
+class RenderEngine final : public fheroes2::BaseRenderEngine
+{
+public:
+    RenderEngine( const RenderEngine & ) = delete;
+    RenderEngine & operator=( const RenderEngine & ) = delete;
+    static RenderEngine * create()
+    {
+        return new RenderEngine;
+    }
+    bool shouldRenderCursor() const override
+    {
+        return Platform3DS::hasModalImages() || !Platform3DS::isBattleHUDPointer( _viewportCenter );
+    }
+    void setViewportState( const fheroes2::Point & position, const bool buttonHeld ) override
+    {
+        _viewportCenter = position;
+        _viewportButtonHeld = buttonHeld;
+    }
+    bool isFullScreen() const override
+    {
+        return true;
+    }
+    void toggleFullScreen() override {}
+    std::vector<fheroes2::ResolutionInfo> getAvailableResolutions() const override
+    {
+        return { { gameWidth, gameHeight } };
+    }
+    fheroes2::Rect getActiveWindowROI() const override
+    {
+        return { 0, 0, gameWidth, gameHeight };
+    }
+    fheroes2::Size getCurrentScreenResolution() const override
+    {
+        return { gameWidth, gameHeight };
+    }
+    ~RenderEngine() override
+    {
+        clear();
+    }
+
+private:
+    RenderEngine() = default;
+    static constexpr int gameWidth = 800;
+    static constexpr int gameHeight = 480;
+    static constexpr int overviewWidth = 400;
+    static constexpr int screenHeight = 240;
+    static constexpr int detailWidth = 320;
+    static constexpr int hudTop = 200;
+    static constexpr int verticalScale = gameHeight / screenHeight;
+    static constexpr int standardHorizontalScale = gameWidth / overviewWidth;
+    static constexpr int lastScreenRow = screenHeight - 1;
+    static constexpr uint32_t cropBorderColor = 0xff3030ff;
+    fheroes2::Point _viewportCenter;
+    bool _viewportButtonHeld = false;
+    SDL_Window * _top = nullptr;
+    SDL_Window * _bottom = nullptr;
+    std::array<uint32_t, fheroes2::paletteSize> _colors{};
+    Uint32 _reportTime = 0;
+    unsigned _frames = 0;
+    double _drawTime = 0;
+
+    void clear() override
+    {
+        SDL_DestroyWindow( _bottom );
+        _bottom = nullptr;
+        SDL_DestroyWindow( _top );
+        _top = nullptr;
+        Platform3DS::resetViewportFollow();
+    }
+    bool allocate( fheroes2::ResolutionInfo & resolution, bool ) override
+    {
+        clear();
+        resolution = { gameWidth, gameHeight };
+        Platform3DS::setVirtualFrameSize( { resolution.gameWidth, resolution.gameHeight } );
+        _top = SDL_CreateWindow( "fheroes2", SDL_WINDOWPOS_UNDEFINED_DISPLAY( 0 ), SDL_WINDOWPOS_UNDEFINED_DISPLAY( 0 ), overviewWidth, screenHeight,
+                                 SDL_WINDOW_FULLSCREEN );
+        _bottom = SDL_CreateWindow( "fheroes2 detail", SDL_WINDOWPOS_UNDEFINED_DISPLAY( 1 ), SDL_WINDOWPOS_UNDEFINED_DISPLAY( 1 ), detailWidth, screenHeight,
+                                    SDL_WINDOW_FULLSCREEN );
+        if ( !_top || !_bottom ) {
+            ERROR_LOG( SDL_GetError() ) clear();
+            return false;
+        }
+        // These libctru configuration functions return void.
+        gfxSet3D( false );
+        gfxSetWide( false );
+        gfxSetScreenFormat( GFX_TOP, GSP_RGBA8_OES );
+        gfxSetScreenFormat( GFX_BOTTOM, GSP_RGBA8_OES );
+        updatePalette( StandardPaletteIndexes() );
+        _reportTime = SDL_GetTicks();
+        _frames = 0;
+        _drawTime = 0;
+        COUT( "3DS native renderer ready: virtual=800x480 top=400x240 bottom=320x240 scale=1/2" )
+        return true;
+    }
+    bool isMouseCursorActive() const override
+    {
+        return true;
+    }
+    void updatePalette( const std::vector<uint8_t> & ids ) override
+    {
+        if ( ids.size() != _colors.size() )
+            return;
+        for ( size_t i = 0; i < ids.size(); ++i ) {
+            const auto & rgb = currentRGBPalette[ids[i]];
+            _colors[i] = ( uint32_t( rgb.r ) << 24 ) | ( uint32_t( rgb.g ) << 16 ) | ( uint32_t( rgb.b ) << 8 ) | 255;
+        }
+    }
+    static void snapshot( const uint32_t * framebuffer, const int width, const char * path, const bool wide )
+    {
+        SDL_Surface * surface = SDL_CreateRGBSurfaceWithFormat( 0, width, screenHeight, 32, SDL_PIXELFORMAT_RGBA8888 );
+        if ( !surface ) {
+            ERROR_LOG( SDL_GetError() ) return;
+        }
+        for ( int y = 0; y < screenHeight; ++y ) {
+            auto * row = reinterpret_cast<uint32_t *>( static_cast<uint8_t *>( surface->pixels ) + y * surface->pitch );
+            for ( int x = 0; x < width; ++x )
+                row[x] = framebuffer[x * screenHeight + lastScreenRow - y];
+        }
+        std::string capturePath = path;
+        if ( wide )
+            capturePath.insert( capturePath.find_last_of( '/' ) + 1, "wide-" );
+        if ( SDL_SaveBMP( surface, capturePath.c_str() ) < 0 ) {
+            ERROR_LOG( SDL_GetError() )
+        }
+        SDL_FreeSurface( surface );
+    }
+    void render( const fheroes2::Display & display, const fheroes2::Rect & ) override
+    {
+        if ( Platform3DS::systemExitRequested() ) return;
+        if ( !_top || !_bottom || display.width() != gameWidth || display.height() != gameHeight || !display.image() )
+            return;
+        const Uint64 begin = SDL_GetPerformanceCounter();
+        const auto * panel = Platform3DS::commandPanelImage();
+        const auto * strip = Platform3DS::commandStripImage();
+        const auto * battleHUD = Platform3DS::battleHUDImage();
+        const auto * modalTop = Platform3DS::modalTopImage();
+        const auto * modalBottom = Platform3DS::modalBottomImage();
+        const auto * rightImage = Platform3DS::modalRightImage();
+        const bool stereo = modalTop && rightImage && Platform3DS::stereoStrength() > 0;
+        const bool wide = !stereo && Platform3DS::highResolutionEnabled() && Platform3DS::highResolutionSupported();
+        // Wide and stereo share the upper-screen buffers and are mutually exclusive in libctru.
+        if ( gfxIs3D() && !stereo ) gfxSet3D( false );
+        if ( gfxIsWide() != wide ) { gfxSetWide( wide ); COUT( "3DS top screen: " << ( wide ? "800x240 high resolution" : "400x240 standard" ) ) }
+        if ( gfxIs3D() != stereo ) { gfxSet3D( stereo ); COUT( "3DS castle stereo: " << ( stereo ? "on" : "off" ) ) }
+        Platform3DS::consumeDisplayRefresh();
+        const int topWidth = wide ? gameWidth : overviewWidth;
+        const int sourceStep = wide ? 1 : standardHorizontalScale;
+        if ( !Platform3DS::hasModalImages() )
+            Platform3DS::followCursor( _viewportCenter, SDL_GetTicks(), panel || Platform3DS::isBattleHUDPointer( _viewportCenter ) || _viewportButtonHeld );
+        auto crop = Platform3DS::viewport();
+        // A strip can be suspended just before opening a popup at the bottom edge.
+        // Clamp sampling without changing the saved viewport that will resume with the strip.
+        crop.y = std::clamp<int32_t>( crop.y, 0, Platform3DS::detailFrameHeight() - Platform3DS::detailHeight() );
+        u16 topHeight = 0, actualTopWidth = 0, bottomHeight = 0, actualBottomWidth = 0;
+        // libctru returns rotated framebuffer dimensions: height first, then width.
+        auto * top = reinterpret_cast<uint32_t *>( gfxGetFramebuffer( GFX_TOP, GFX_LEFT, &topHeight, &actualTopWidth ) );
+        auto * bottom = reinterpret_cast<uint32_t *>( gfxGetFramebuffer( GFX_BOTTOM, GFX_LEFT, &bottomHeight, &actualBottomWidth ) );
+        if ( !top || !bottom || topHeight != screenHeight || actualTopWidth != topWidth || bottomHeight != screenHeight || actualBottomWidth != detailWidth ) {
+            ERROR_LOG( "Invalid 3DS framebuffer or dimensions" )
+            return;
+        }
+        u16 rightHeight = 0, rightWidth = 0;
+        auto * right = stereo ? reinterpret_cast<uint32_t *>( gfxGetFramebuffer( GFX_TOP, GFX_RIGHT, &rightHeight, &rightWidth ) ) : nullptr;
+        if ( stereo && ( !right || rightHeight != screenHeight || rightWidth != overviewWidth || modalTop->width() != overviewWidth
+                         || modalTop->height() != screenHeight || rightImage->width() != overviewWidth || rightImage->height() != screenHeight ) ) {
+            ERROR_LOG( "Invalid stereo framebuffer or modal dimensions" ) return;
+        }
+        const uint8_t * image = display.image();
+        const int frameWidth = display.width();
+        // Framebuffer columns are contiguous, stored bottom-to-top. No intermediate RGBA texture.
+        for ( int x = 0; x < topWidth; ++x ) {
+            uint32_t * out = top + x * screenHeight;
+            for ( int y = lastScreenRow; y >= 0; --y )
+                *out++ = _colors[modalTop ? modalTop->image()[y * overviewWidth + ( wide ? x / 2 : x )] : image[y * verticalScale * frameWidth + x * sourceStep]];
+        }
+        if ( stereo ) {
+            for ( int x = 0; x < overviewWidth; ++x ) {
+                auto * out = right + x * screenHeight;
+                for ( int y = lastScreenRow; y >= 0; --y ) *out++ = _colors[rightImage->image()[y * overviewWidth + x]];
+            }
+        }
+        for ( int x = 0; x < detailWidth; ++x ) {
+            uint32_t * out = bottom + x * screenHeight;
+            for ( int y = lastScreenRow; y >= 0; --y ) {
+                const uint8_t pixel = modalBottom                ? modalBottom->image()[y * detailWidth + x]
+                                      : panel                    ? panel->image()[y * detailWidth + x]
+                                      : battleHUD && y >= hudTop ? battleHUD->image()[( y - hudTop ) * detailWidth + x]
+                                      : strip && y >= hudTop     ? strip->image()[( y - hudTop ) * detailWidth + x]
+                                                                 : image[( crop.y + y ) * frameWidth + crop.x + x];
+                *out++ = _colors[pixel];
+            }
+        }
+        const int left = crop.x / sourceStep, rightEdge = left + detailWidth / sourceStep - 1;
+        const int upper = crop.y / verticalScale, lower = upper + Platform3DS::detailHeight() / verticalScale - 1;
+        if ( !modalTop ) {
+            const int upperRow = lastScreenRow - upper, lowerRow = lastScreenRow - lower;
+            for ( int x = left; x <= rightEdge; ++x ) {
+                auto * column = top + x * screenHeight;
+                column[upperRow] = cropBorderColor;
+                column[lowerRow] = cropBorderColor;
+            }
+            auto * leftColumn = top + left * screenHeight;
+            auto * rightColumn = top + rightEdge * screenHeight;
+            for ( int y = upper; y <= lower; ++y ) {
+                const int row = lastScreenRow - y;
+                leftColumn[row] = cropBorderColor;
+                rightColumn[row] = cropBorderColor;
+                if ( wide ) {
+                    leftColumn[screenHeight + row] = cropBorderColor;
+                    rightColumn[row - screenHeight] = cropBorderColor;
+                }
+            }
+        }
+        _drawTime += 1000.0 * ( SDL_GetPerformanceCounter() - begin ) / SDL_GetPerformanceFrequency();
+        if ( Platform3DS::consumeCapture() ) {
+            if ( stereo ) {
+                snapshot( top, overviewWidth, "sdmc:/3ds/fheroes2/stereo-left-top.bmp", false );
+                snapshot( right, overviewWidth, "sdmc:/3ds/fheroes2/stereo-right-top.bmp", false );
+            }
+            snapshot( top, topWidth,
+                      modalTop                      ? "sdmc:/3ds/fheroes2/info-top.bmp"
+                      : modalBottom                 ? "sdmc:/3ds/fheroes2/dialog-top.bmp"
+                      : panel || strip || battleHUD ? "sdmc:/3ds/fheroes2/panel-top.bmp"
+                                                    : "sdmc:/3ds/fheroes2/menu-top.bmp",
+                      wide );
+            snapshot( bottom, detailWidth,
+                      modalTop                      ? "sdmc:/3ds/fheroes2/info-bottom.bmp"
+                      : modalBottom                 ? "sdmc:/3ds/fheroes2/dialog-bottom.bmp"
+                      : panel || strip || battleHUD ? "sdmc:/3ds/fheroes2/panel-bottom.bmp"
+                                                    : "sdmc:/3ds/fheroes2/menu-bottom.bmp",
+                      wide );
+            COUT( "3DS menu snapshots saved" )
+            COUT( "3DS capture: mean_draw_ms=" << _drawTime / ( _frames + 1 ) << " used_alloc=" << mallinfo().uordblks << " linear_free=" << linearSpaceFree() )
+        }
+        // Buffer presentation and VBlank waiting return void.
+        gfxFlushBuffers();
+        gfxSwapBuffers();
+        gspWaitForVBlank();
+        ++_frames;
+        const Uint32 now = SDL_GetTicks();
+        if ( now - _reportTime >= 2000 ) {
+            COUT( "3DS RENDER fps=" << _frames * 1000.0 / ( now - _reportTime ) << " draw_ms=" << _drawTime / _frames << " used_alloc=" << mallinfo().uordblks
+                                    << " linear_free=" << linearSpaceFree() )
+            _reportTime = now;
+            _frames = 0;
+            _drawTime = 0;
+        }
+    }
+};
