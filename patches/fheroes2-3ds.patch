+void Interface3DS::testBattleHeroActions()
+{
+    const auto key = []( int button, bool down ) { SDL_Event e{}; e.type = down ? SDL_CONTROLLERBUTTONDOWN : SDL_CONTROLLERBUTTONUP; e.cbutton.button = button; e.cbutton.state = down ? SDL_PRESSED : SDL_RELEASED; return e; };
+    const auto touch = []( Uint32 type, int x, int y ) { SDL_Event e{}; e.type = type; e.tfinger.touchId = 1; e.tfinger.fingerId = 0; e.tfinger.x = x / 320.0f; e.tfinger.y = y / 240.0f; return e; };
+    Heroes hero( Heroes::LORDKILBURN, Race::KNGT );
+    const auto crop = Platform3DS::viewport(); fheroes2::Image frame; fheroes2::Copy( fheroes2::Display::instance(), frame );
+    const auto run = [&]( bool enabled, std::vector<TimedEvent> sequence ) {
+        const int result = runInjectedInput( [&]() { return showBattleHeroActions( hero, enabled, enabled, enabled ); }, std::move( sequence ) );
+        if ( Platform3DS::viewport() != crop || std::memcmp( frame.image(), fheroes2::Display::instance().image(), frame.width() * frame.height() ) ) throw std::runtime_error( "Hero actions changed frame/viewport" );
+        return result;
+    };
+    for ( int i = 0; i < 4; ++i ) {
+        const int x = i % 2 ? 220 : 70, y = i / 2 ? 210 : 162;
+        if ( run( true, { { 250, touch( SDL_FINGERDOWN, x, y ) }, { 80, touch( SDL_FINGERUP, x, y ) } } ) != ( i == 3 ? 0 : i + 1 ) ) throw std::runtime_error( "Hero action touch result differs" );
+    }
+    if ( run( true, { { 250, key( SDL_CONTROLLER_BUTTON_Y, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_Y, false ) } } ) ) throw std::runtime_error( "Hero actions Y close failed" );
+    if ( run( true, { { 250, key( SDL_CONTROLLER_BUTTON_DPAD_UP, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_DPAD_UP, false ) }, { 80, key( SDL_CONTROLLER_BUTTON_A, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_A, false ) } } ) != 2 ) throw std::runtime_error( "Hero action controller differs" );
+    for ( int i = 0; i < 3; ++i ) {
+        const int x = i % 2 ? 220 : 70, y = i / 2 ? 210 : 162;
+        if ( run( false, { { 250, touch( SDL_FINGERDOWN, x, y ) }, { 80, touch( SDL_FINGERUP, x, y ) }, { 80, key( SDL_CONTROLLER_BUTTON_Y, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_Y, false ) } } ) ) throw std::runtime_error( "Disabled hero action activated" );
+    }
+    if ( run( true, { { 250, touch( SDL_FINGERDOWN, 70, 162 ) }, { 80, touch( SDL_FINGERMOTION, 70, 180 ) }, { 80, touch( SDL_FINGERUP, 70, 180 ) }, { 80, key( SDL_CONTROLLER_BUTTON_Y, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_Y, false ) } } ) ) throw std::runtime_error( "Hero action drag activated" );
+    COUT( "3DS HERO ACTIONS SMOKE: PASS touch_controller toggle_close disabled_actions drag_cancel unchanged_frame_viewport release_isolation" )
+}
+
+Spell Interface3DS::showCombatSpellBook( const HeroBase & hero, const std::vector<Spell> & spells, const bool canCast,
