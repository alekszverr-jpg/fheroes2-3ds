+Interface3DS::GiftChoice Interface3DS::showResourceGift( const Funds & funds, const PlayerColorsSet availableRecipients )
+{
+    const CursorRestorer hideCursor( false );
+    const PlayerColorsVector colors( availableRecipients & Color::allPlayerColors() );
+    const int colorCount = static_cast<int>( colors.size() ), resourceStart = colorCount, buttonStart = colorCount + 7;
