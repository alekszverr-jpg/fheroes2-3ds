+    if ( lastScroll <= 0 ) throw std::runtime_error( "Summary losses did not scroll" );
+    if ( run( [&]() { return int( showBattleSummary( _( "Your forces suffer a bitter defeat." ), "", empty, empty, false, {} ) ); }, okay ) ) throw std::runtime_error( "Empty casualties restarted battle" );
+    Heroes enemy( Heroes::LORDKILBURN, Race::KNGT ); enemy.SetColor( PlayerColor::RED );
+    Kingdom kingdom; kingdom.AddFundsResource( Funds( Resource::GOLD, 1000 ) );
