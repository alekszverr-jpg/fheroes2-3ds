+         || nestedInformationReturns != singleInfo + 1 ) throw std::runtime_error( "Single-skill information failed" );
+    const auto nested = nestedInformationReturns;
+    if ( run( first, second, { { 300, touch( SDL_FINGERDOWN, 80, 132 ) }, { 900, touch( SDL_FINGERUP, 0, 0 ) },
