+bool Interface3DS::supportsMessage( const int buttons, const std::vector<const fheroes2::DialogElement *> & elements )
+{
+    if ( buttons != Dialog::ZERO && buttons != Dialog::OK && buttons != Dialog::CANCEL
+         && buttons != ( Dialog::OK | Dialog::CANCEL ) && buttons != ( Dialog::YES | Dialog::NO ) ) return false;
+    // Custom interactive elements (hotkey editor, monster info, editor selections) retain their original event loops.
+    return std::all_of( elements.begin(), elements.end(), [buttons]( const auto * element ) {
+        return element && element->area().width <= ( buttons ? 296 : 376 )
+               && ( hasInformation( element ) || isPassive( element ) || ( !buttons && dynamic_cast<const fheroes2::MonsterDialogElement *>( element ) ) );
+    } );
+}
+
+static int showNativeMessage( const fheroes2::TextBase & header, const fheroes2::TextBase & body, const int buttons,
+                              const std::vector<const fheroes2::DialogElement *> & elements, const FixedChoice * choice = nullptr,
+                              const fheroes2::Point * heldPosition = nullptr )
+{
+    using namespace fheroes2;
+    const bool information = buttons == Dialog::ZERO;
+    const bool classicChoice = choice && ( choice->classicChest || choice->classicSkill );
+    const bool classicIllustrated = !information && !choice && !elements.empty()
+        && std::all_of( elements.begin(), elements.end(), []( const DialogElement * element ) { return hasInformation( element ) && element->area().width <= 272; } );
+    const bool classicConfirmation = !information && !choice && ( elements.empty() || classicIllustrated );
+    const bool classicFrame = classicChoice || classicConfirmation;
+    const bool confirmationPair = buttons == ( Dialog::YES | Dialog::NO ) || buttons == ( Dialog::OK | Dialog::CANCEL );
+    const auto choiceCentre = [&]( const size_t i ) { return ( classicConfirmation ? !confirmationPair : elements.size() == 1 ) ? 160 : i ? 232 : 88; };
+    const int buttonRow = classicChoice ? 168 : classicConfirmation ? 176 : 202;
+    const CursorRestorer cursorRestorer( false );
+    Image window( information ? 400 : 320, 240 );
+    const int width = ( classicChoice || classicIllustrated ) ? 352 : classicConfirmation ? 272 : window.width() - 24;
+    int rewardHeight = 0;
+    if ( choice ) for ( const auto * element : elements ) rewardHeight = std::max<int32_t>( rewardHeight, element->area().height );
+    const int viewHeight = classicChoice ? 176 : classicConfirmation ? 128 : choice ? std::min( 100, 160 - rewardHeight ) : information ? 204 : 180;
+    const uint8_t background = GetColorId( 35, 29, 24 );
+    const uint8_t border = GetColorId( 150, 115, 63 );
+    const int headerHeight = header.empty() ? 0 : header.height( width ) + 8;
+    int height = headerHeight + ( body.empty() ? 0 : body.height( width ) + 8 );
+    const int textHeight = height;
+    const int elementWidth = classicIllustrated ? 272 : width;
+    if ( classicIllustrated ) height = 0;
+    std::vector<Point> offsets( elements.size() );
+    for ( size_t first = 0; !choice && first < elements.size(); ) {
+        size_t last = first;
+        int rowWidth = 0, rowHeight = 0;
+        while ( last < elements.size() ) {
+            const auto size = elements[last]->area();
+            if ( last > first && rowWidth + 10 + size.width > elementWidth ) break;
+            rowWidth += ( last > first ? 10 : 0 ) + size.width;
+            rowHeight = std::max( rowHeight, int( size.height ) );
+            ++last;
+        }
+        int x = ( elementWidth - rowWidth ) / 2;
+        for ( size_t i = first; i < last; ++i ) {
+            offsets[i] = { x, height + rowHeight - elements[i]->area().height };
+            x += elements[i]->area().width + 10;
+        }
+        height += rowHeight + 10;
+        first = last;
+    }
+    const int elementMaximum = std::max( 0, height - viewHeight );
+    const int textMaximum = classicIllustrated ? std::max( 0, textHeight - 176 ) : 0;
+    const int scrollMaximum = std::max( elementMaximum, textMaximum );
+    Image textContent;
+    if ( classicIllustrated ) {
