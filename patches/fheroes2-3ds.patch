+    size_t selected = 0, page = 0; int scroll = 0, pressed = -1;
+    bool down = false, moved = false; Point start, last; Uint32 began = 0;
+    const std::array<Rect, 4> controls{ Rect{ 8, 202, 48, 25 }, { 60, 202, 48, 25 }, { 112, 202, 100, 25 }, { 216, 202, 96, 25 } };
+    const std::array<std::string, 4> labels{ "", "", _( "Okay" ), _( "Back" ) };
+    std::array<std::unique_ptr<ButtonBase>, 4> buttons;
+    for ( size_t i = 0; i < buttons.size(); ++i ) {
+        Sprite released, pressedImage; makeButtonSprites( released, pressedImage, "", { controls[i].width - 10, controls[i].height }, evil, evil ? ICN::STONEBAK_EVIL : ICN::STONEBAK );
+        if ( i < 2 ) {
+            for ( int row = -6; row <= 6; ++row ) {
+                const int width = 7 - std::abs( row ), x = released.width() / 2 - 3 + ( i == 0 ? std::abs( row ) : 0 );
+                Fill( released, x, released.height() / 2 + row, width, 1, GetColorId( 255, 255, 255 ) );
+                Fill( pressedImage, x - 1, pressedImage.height() / 2 + row + 1, width, 1, GetColorId( 255, 255, 255 ) );
+            }
+        }
+        else {
+            Text label( labels[i], FontType::normalWhite() ); label.fitToOneRow( released.width() - 8 );
+            label.draw( 4, ( released.height() - label.height() ) / 2, released.width() - 8, released ); label.draw( 3, ( pressedImage.height() - label.height() ) / 2 + 1, pressedImage.width() - 8, pressedImage );
+        }
+        buttons[i] = std::make_unique<ButtonSprite>( controls[i].x, controls[i].y, std::move( released ), std::move( pressedImage ) );
