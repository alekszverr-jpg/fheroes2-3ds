+int Interface3DS::showLevelUp( const std::string & name, const int primarySkill, const Skill::Secondary & first,
+                               const Skill::Secondary & second, Heroes & hero )
+{
+    using namespace fheroes2;
+    std::string header = _( "%{name} has gained a level.\n\n%{skill} +1" );
+    StringReplace( header, "%{name}", name );
+    StringReplace( header, "%{skill}", Skill::Primary::String( primarySkill ) );
+    if ( !first.isValid() && !second.isValid() ) {
+        const PrimarySkillDialogElement primary( primarySkill, "+1" );
+        const FixedChoice choice{ { _( "OK" ), "" }, { Skill::Primary::String( primarySkill ), "" }, true, false, {}, true };
+        showNativeMessage( Text{}, Text( header, FontType::normalYellow() ), Dialog::OK, { &primary }, &choice );
+        return Skill::Secondary::UNKNOWN;
+    }
+    if ( !first.isValid() || !second.isValid() ) {
+        const auto & skill = first.isValid() ? first : second;
+        std::string body = _( "You have learned %{skill}." );
+        StringReplace( body, "%{skill}", skill.GetNameWithBonus( hero ) );
+        const SecondarySkillDialogElement element( skill, hero );
+        const FixedChoice choice{ { _( "OK" ), "" }, { skill.GetNameWithBonus( hero ), "" }, true, false, {}, true };
+        showNativeMessage( Text( header, FontType::normalYellow() ), Text( body, FontType::normalWhite() ), Dialog::OK, { &element }, &choice );
+        return skill.Skill();
+    }
+    const SecondarySkillDialogElement left( first, hero ), right( second, hero );
+    std::string learn = _( "Learn %{secondary-skill}" );
+    StringReplace( learn, "%{secondary-skill}", "" );
+    const FixedChoice choice{ { learn, learn }, { first.GetNameWithBonus( hero ), second.GetNameWithBonus( hero ) }, false, false, {}, true };
+    const int result = showNativeMessage( Text( header, FontType::normalYellow() ),
+        Text( std::to_string( hero.GetSecondarySkills().Count() ) + "/" + std::to_string( Heroes::maxNumOfSecSkills ), FontType::smallWhite() ),
+        Dialog::YES | Dialog::NO, { &left, &right }, &choice );
+    // Skill identifiers, not indices or levels: the original caller grants exactly the selected upgrade.
+    return result == Dialog::YES ? first.Skill() : result == Dialog::NO ? second.Skill() : Skill::Secondary::UNKNOWN;
+}
