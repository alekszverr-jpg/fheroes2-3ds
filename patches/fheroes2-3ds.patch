+                    if ( !spells.empty() ) SpellDialogElement( spells[selected], &hero ).showPopup( Dialog::ZERO ); break;
+                }
+            }
+            else if ( input.type == PanelInputType::TouchDown ) {
+                start = last = input.position; began = SDL_GetTicks(); down = true; moved = false; pressed = -1; touched = -1;
+                for ( size_t i = 0; i < buttons.size(); ++i ) if ( buttons[i]->area() & start ) pressed = int( i );
+                for ( size_t slot = 0; slot < 6 && page + slot < spells.size(); ++slot )
+                    if ( spellArea( slot ) & input.position ) touched = int( page + slot );
+            }
+            else if ( input.type == PanelInputType::TouchMove && down ) {
+                moved = moved || std::abs( input.position.x - start.x ) >= 6 || std::abs( input.position.y - start.y ) >= 6;
+                if ( moved && pressed < 0 ) scroll = std::clamp<int32_t>( scroll + last.y - input.position.y, 0, content.height() - 188 );
+                last = input.position;
+            }
+            else if ( input.type == PanelInputType::TouchUp ) {
+                if ( down && !moved && pressed >= 0 && ( buttons[pressed]->area() & last ) ) activate( pressed );
+                else if ( down && !moved && touched >= 0 ) { selected = touched; update(); }
+                else if ( down && !moved && switchFilters ) {
+                    for ( size_t i = 0; i < tabs.size(); ++i ) if ( ( tabs[i] & start ) && ( tabs[i] & last ) )
+                        changeFilter( i == 0 ? SpellBook::Filter::ADVN : SpellBook::Filter::CMBT );
+                }
+                down = false; pressed = -1; touched = -1;
+            }
+        }
+        if ( down && !moved && touched >= 0 && SDL_GetTicks() - began >= 550 ) {
+            selected = touched; update(); down = false; SpellDialogElement( spells[selected], &hero ).showPopup( Dialog::ZERO ); redraw = true;
+        }
+        if ( redraw && !closed ) draw();
+    }
+    lastScroll = scroll;
+    return result;
+}
