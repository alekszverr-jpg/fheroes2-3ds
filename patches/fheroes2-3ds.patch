+void Interface3DS::testBattleOutcome()
+{
+    using namespace fheroes2;
+    using TimedEvent = std::pair<Uint32, SDL_Event>;
+    const auto key = []( int button, bool down ) { SDL_Event e{}; e.type = down ? SDL_CONTROLLERBUTTONDOWN : SDL_CONTROLLERBUTTONUP; e.cbutton.button = button; e.cbutton.state = down ? SDL_PRESSED : SDL_RELEASED; return e; };
+    const auto touch = []( Uint32 type, int x, int y ) { SDL_Event e{}; e.type = type; e.tfinger.touchId = 1; e.tfinger.fingerId = 0; e.tfinger.x = x / 320.0f; e.tfinger.y = y / 240.0f; return e; };
+    const auto crop = Platform3DS::viewport(); const auto * hud = Platform3DS::battleHUDImage(); Image frame; Copy( Display::instance(), frame );
+    const auto run = [&]( const std::function<int()> & dialog, std::vector<TimedEvent> sequence ) {
+        SDL_Thread * worker = SDL_CreateThread( []( void * data ) -> int {
+            for ( auto & step : *static_cast<std::vector<TimedEvent> *>( data ) ) { SDL_Delay( step.first ); if ( SDL_PushEvent( &step.second ) != 1 ) return 1; } return 0;
+        }, "battle-outcome-smoke", &sequence );
+        if ( !worker ) throw std::runtime_error( "Cannot start battle report input" );
+        int result = 0, status = 0;
+        try { result = dialog(); } catch ( ... ) { SDL_WaitThread( worker, &status ); throw; }
+        SDL_WaitThread( worker, &status ); auto & events = LocalEvent::Get(); events.HandleEvents( false, true );
+        if ( status || Platform3DS::hasModalImages() || Platform3DS::viewport() != crop || Platform3DS::battleHUDImage() != hud
+             || events.MouseClickLeft() || events.isMouseRightButtonPressed() || std::memcmp( frame.image(), Display::instance().image(), frame.width() * frame.height() ) )
+            throw std::runtime_error( "Battle report changed frame/context or leaked input" );
+        return result;
+    };
+    const std::vector<TimedEvent> okay{ { 250, key( SDL_CONTROLLER_BUTTON_A, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_A, false ) } };
+    const std::vector<TimedEvent> cancel{ { 250, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } };
+    const auto necromancy = [&]( uint32_t count ) { showBattleNecromancy( count, {} ); return 0; };
+    run( [&]() { return necromancy( 1 ); }, okay );
+    run( [&]() { return necromancy( 123456 ); }, { { 250, touch( SDL_FINGERDOWN, 150, 211 ) }, { 80, touch( SDL_FINGERUP, 150, 211 ) } } );
+    run( [&]() { return necromancy( 0 ); }, cancel );
+    run( [&]() { return necromancy( 4294967295U ); }, { { 250, touch( SDL_FINGERDOWN, 150, 211 ) }, { 80, touch( SDL_FINGERMOTION, 150, 170 ) }, { 80, touch( SDL_FINGERUP, 150, 170 ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } } );
+    Troops empty, losses;
+    for ( int id : { Monster::PEASANT, Monster::ARCHER, Monster::GOBLIN, Monster::OGRE, Monster::BLACK_DRAGON } ) losses.PushBack( Monster( id ), 123456 );
+    const auto summary = [&]( bool restart ) { return int( showBattleSummary( _( "A glorious victory!" ), _( "The enemy has surrendered!" ), losses, losses, restart, {} ) ); };
+    if ( run( [&]() { return summary( false ); }, okay ) || run( [&]() { return summary( true ); }, okay ) || run( [&]() { return summary( true ); }, cancel ) ) throw std::runtime_error( "Summary default/cancel restarted battle" );
+    if ( run( [&]() { return summary( true ); }, { { 250, key( SDL_CONTROLLER_BUTTON_DPAD_LEFT, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_DPAD_LEFT, false ) }, { 80, key( SDL_CONTROLLER_BUTTON_A, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_A, false ) } } ) != 1 ) throw std::runtime_error( "Summary restart choice differs" );
+    if ( run( [&]() { return summary( true ); }, { { 250, touch( SDL_FINGERDOWN, 150, 174 ) }, { 80, touch( SDL_FINGERMOTION, 150, 120 ) }, { 80, touch( SDL_FINGERUP, 150, 120 ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } } ) ) throw std::runtime_error( "Summary drag restarted battle" );
+    run( [&]() { return summary( false ); }, { { 250, touch( SDL_FINGERDOWN, 150, 160 ) }, { 80, touch( SDL_FINGERMOTION, 150, 20 ) }, { 80, touch( SDL_FINGERUP, 150, 20 ) }, { 80, key( SDL_CONTROLLER_BUTTON_A, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_A, false ) } } );
+    if ( lastScroll <= 0 ) throw std::runtime_error( "Summary losses did not scroll" );
+    if ( run( [&]() { return int( showBattleSummary( _( "Your forces suffer a bitter defeat." ), "", empty, empty, false, {} ) ); }, okay ) ) throw std::runtime_error( "Empty casualties restarted battle" );
+    Heroes enemy( Heroes::LORDKILBURN, Race::KNGT ); enemy.SetColor( PlayerColor::RED );
+    Kingdom kingdom; kingdom.AddFundsResource( Funds( Resource::GOLD, 1000 ) );
+    const Funds funds = kingdom.GetFunds();
+    const auto surrender = [&]( uint32_t cost ) { return int( Battle::DialogBattleSurrender( enemy, cost, kingdom ) ); };
+    if ( run( [&]() { return surrender( 500 ); }, cancel ) ) throw std::runtime_error( "Surrender cancel accepted" );
+    if ( run( [&]() { return surrender( 500 ); }, { { 250, touch( SDL_FINGERDOWN, 150, 137 ) }, { 80, touch( SDL_FINGERUP, 150, 137 ) } } ) != 1 ) throw std::runtime_error( "Affordable surrender not accepted" );
+    if ( run( [&]() { return surrender( 2000 ); }, { { 250, touch( SDL_FINGERDOWN, 150, 137 ) }, { 80, touch( SDL_FINGERUP, 150, 137 ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } } ) ) throw std::runtime_error( "Unaffordable surrender accepted" );
+    if ( run( [&]() { return surrender( 500 ); }, { { 250, touch( SDL_FINGERDOWN, 150, 137 ) }, { 80, touch( SDL_FINGERMOTION, 150, 170 ) }, { 80, touch( SDL_FINGERUP, 150, 170 ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } } ) ) throw std::runtime_error( "Surrender drag accepted" );
+    if ( !( kingdom.GetFunds() == funds ) ) throw std::runtime_error( "Surrender dialog charged gold" );
+    run( [&]() { showBattleArtifact( Artifact( Artifact::SNAKE_RING ), _( "You have captured an enemy artifact!" ) ); return 0; }, { { 250, key( SDL_CONTROLLER_BUTTON_B, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_B, false ) }, { 80, key( SDL_CONTROLLER_BUTTON_A, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_A, false ) } } );
+    const auto previous = Settings::Get().getInterfaceType(); Settings::Get().setInterfaceType( InterfaceType::EVIL );
+    run( [&]() { return surrender( 500 ); }, cancel ); Settings::Get().setInterfaceType( previous );
+    Settings::Get().setInterfaceType( InterfaceType::EVIL ); run( [&]() { return necromancy( 12 ); }, okay ); Settings::Get().setInterfaceType( previous );
+    COUT( "3DS NECROMANCY SMOKE: PASS count_plural_extremes touch_controller cancel_drag evil unchanged_frame_hud_viewport release_isolation" )
+    COUT( "3DS BATTLE OUTCOME SMOKE: PASS summary_restart_ok_cancel empty_long_casualties stylus_scroll button_drag surrender_actual_dialog affordable_unaffordable unchanged_funds artifact_info evil unchanged_frame_hud_viewport release_isolation" )
+}
