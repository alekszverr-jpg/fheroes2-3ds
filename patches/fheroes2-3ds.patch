+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "ui_3ds_commands.h"
+#if defined( __3DS__ )
+#include <cmath>
+#include <stdexcept>
+#include <SDL.h>
+#include "game_assets.h"
