+            skillImage.resize( elements[i]->area().width, elements[i]->area().height ); skillImage.reset();
+            elements[i]->draw( skillImage, { 0, 0 } ); original = &skillImage;
+        }
+        else original = &Assets::getImage( i ? ICN::EXPMRL : ICN::RESOURCE, i ? 4 : 6 );
