+    if ( hero.GetExperience() != experience || hero.GetSecondarySkills().Count() != skillCount || hero.GetSecondarySkills().GetTotalLevel() != skillLevels
+         || std::array<int, 4>{ hero.GetAttack(), hero.GetDefense(), hero.GetPower(), hero.GetKnowledge() } != primary )
