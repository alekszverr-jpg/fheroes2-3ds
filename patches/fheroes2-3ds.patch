+        if ( !adventureInputActive ) cancelAdventureScroll();
+    }
+    bool handleAdventureDpad( const int button, const bool pressed )
+    {
+        uint8_t bit = 0;
+        switch ( button ) {
+        case SDL_CONTROLLER_BUTTON_DPAD_LEFT: bit = 1; break;
+        case SDL_CONTROLLER_BUTTON_DPAD_RIGHT: bit = 2; break;
+        case SDL_CONTROLLER_BUTTON_DPAD_UP: bit = 4; break;
+        case SDL_CONTROLLER_BUTTON_DPAD_DOWN: bit = 8; break;
+        default: return false;
+        }
+        if ( !pressed ) {
+            const bool captured = ( adventureDpadCaptured & bit ) != 0;
+            adventureDpadHeld &= ~bit;
+            adventureDpadCaptured &= ~bit;
+            return captured;
+        }
+        adventureDpadCaptured &= ~bit;
+        adventureDpadHeld &= ~bit;
+        if ( !adventureInputActive || panelImage ) return false;
+        adventureDpadHeld |= bit;
+        adventureDpadCaptured |= bit;
