+    const auto crop = Platform3DS::viewport(); const auto * hud = Platform3DS::battleHUDImage(); Image frame; Copy( Display::instance(), frame );
+    const auto run = [&]( const std::function<int()> & dialog, std::vector<TimedEvent> sequence ) {
+        SDL_Thread * worker = SDL_CreateThread( []( void * data ) -> int {
+            for ( auto & step : *static_cast<std::vector<TimedEvent> *>( data ) ) { SDL_Delay( step.first ); if ( SDL_PushEvent( &step.second ) != 1 ) return 1; } return 0;
+        }, "battle-outcome-smoke", &sequence );
+        if ( !worker ) throw std::runtime_error( "Cannot start battle report input" );
+        int result = 0, status = 0;
+        try { result = dialog(); } catch ( ... ) { SDL_WaitThread( worker, &status ); throw; }
+        SDL_WaitThread( worker, &status ); auto & events = LocalEvent::Get(); events.HandleEvents( false, true );
+        if ( status || Platform3DS::hasModalImages() || Platform3DS::viewport() != crop || Platform3DS::battleHUDImage() != hud
+             || events.MouseClickLeft() || events.isMouseRightButtonPressed() || std::memcmp( frame.image(), Display::instance().image(), frame.width() * frame.height() ) )
+            throw std::runtime_error( "Battle report changed frame/context or leaked input" );
+        return result;
+    };
+    const std::vector<TimedEvent> okay{ { 250, key( SDL_CONTROLLER_BUTTON_A, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_A, false ) } };
+    const std::vector<TimedEvent> cancel{ { 250, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, true ) }, { 80, key( SDL_CONTROLLER_BUTTON_LEFTSHOULDER, false ) } };
+    const auto necromancy = [&]( uint32_t count ) { showBattleNecromancy( count, {} ); return 0; };
+    run( [&]() { return necromancy( 1 ); }, okay );
+    run( [&]() { return necromancy( 123456 ); }, { { 250, touch( SDL_FINGERDOWN, 150, 211 ) }, { 80, touch( SDL_FINGERUP, 150, 211 ) } } );
